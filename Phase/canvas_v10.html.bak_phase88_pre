      const b=e.target.closest('button'); if(!b)return; const ids=selectedIds(); if(!ids.length)return; const list=nodes();
      if(b.dataset.act==='fit')return centerOn(safeById(ids[0]));
      ids.forEach(id=>{const i=list.findIndex(n=>n.id===id); if(i<0)return; const [n]=list.splice(i,1); if(b.dataset.act==='front')list.push(n); else list.unshift(n);});
      try{save&&save(); renderAll&&renderAll(); toast&&toast(b.dataset.act==='front'?'Brought to front':'Sent to back')}catch(e){}
    });
  }
  function refreshLayerPanel(){
    const list=$('#uploaded-layers-panel .ul-list'); if(!list)return; const active=new Set(selectedIds()); const arr=nodes().slice().reverse();
