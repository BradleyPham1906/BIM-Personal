    if (!CAD.orthoOn || !basePt) return { wx, wy };
    const dx = wx - basePt.wx;
    const dy = wy - basePt.wy;
    const angle = Math.atan2(dy, dx);
    const snap45 = Math.round(angle / (Math.PI / 4)) * (Math.PI / 4);
    const len = Math.hypot(dx, dy);
    return {
      wx: basePt.wx + Math.cos(snap45) * len,
      wy: basePt.wy + Math.sin(snap45) * len,
    };
  }

