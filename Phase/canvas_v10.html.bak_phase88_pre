    try{ var gs=window.getSelection&&getSelection(); if(gs) gs.removeAllRanges(); }catch(err){}
    try{ if(typeof selbox!=='undefined'&&selbox){ selbox.hidden=true; selbox.style.display='none'; } }catch(err){}
    marq.dir=e.clientX>=marq.sx?'window':'crossing';
    var b=marqBox();
