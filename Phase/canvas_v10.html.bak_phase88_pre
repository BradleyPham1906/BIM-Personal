/* ---------------- window-capture input routing ---------------- */
function inVP(e){var v=VP();return v&&e.target&&(e.target===v||v.contains(e.target))}
window.addEventListener('pointerdown',function(e){
  if(!cmd||e.button!==0||!inVP(e))return;
  e.preventDefault();e.stopImmediatePropagation();
  feedPoint(evWorld(e));
},true);
['mousedown','mouseup','click'].forEach(function(tp){
  window.addEventListener(tp,function(e){ if(cmd&&e.button===0&&inVP(e)){e.preventDefault();e.stopImmediatePropagation()} },true);
});
window.addEventListener('mousemove',function(e){
  if(!cmd)return; cursor=evWorld(e); drawOverlay();
},true);
window.addEventListener('keydown',function(e){
  if(e.key==='Escape'&&cmd){endCmd('Cancelled');e.preventDefault();e.stopImmediatePropagation();return}
  if(e.key!=='Enter')return;
  var inp=document.getElementById('cad-cmd-input');
  if(!inp||e.target!==inp)return;
  var v=(inp.value||'').trim(); if(!v)return;
  if(cmd&&handleTyped(v)){inp.value='';e.preventDefault();e.stopImmediatePropagation();return}
  /* spreadsheet cell references in the command line: "=A1,B2" -> "5,10" */
  if(!cmd&&v.charAt(0)==='='){
    var sub=sheetSubstitute(v.slice(1));
    if(sub!=null)inp.value=sub;
  }
},true);

/* ---------------- spreadsheet (small formula-capable grid) ---------------- */
var SHEET_COLS=['A','B','C','D','E','F'],SHEET_ROWS=12;
function sheetStore(){
  if(!window.state)return null;
  if(!state.wbSheet)state.wbSheet={cells:{}};
  if(!state.wbSheet.cells)state.wbSheet.cells={};
  return state.wbSheet;
}
function sheetRaw(ref){var s=sheetStore();return s&&s.cells[ref]!=null?String(s.cells[ref]):''}
var sheetVals={};
function sheetEvalExpr(expr,depth){
  /* translate cell refs then safe-evaluate the resulting arithmetic expression */
  var e=expr.replace(/\b([A-F])(1[0-2]|[1-9])\b/g,function(_,c,r){
    var v=sheetValue(c+r,(depth||0)+1);
    return (typeof v==='number'&&isFinite(v))?('('+v+')'):'(0)';
  });
  e=e.replace(/\b(sin|cos|tan|sqrt|abs|min|max|floor|ceil|round|atan2|pow)\s*\(/gi,function(_,f){return 'Math.'+f.toLowerCase()+'('});
  e=e.replace(/\bpi\b/gi,'Math.PI');
  if(!/^[-+*/%(),.\s0-9MathsqrincotbfleupwPIE]*$/.test(e))throw new Error('bad expr');
  return Function('"use strict";return ('+e+')')();
}
function sheetValue(ref,depth){
  if((depth||0)>16)return NaN;
  if(ref in sheetVals&&!depth)return sheetVals[ref];
  var raw=sheetRaw(ref);
  if(raw==='')return 0;
  if(raw.charAt(0)==='='){try{return sheetEvalExpr(raw.slice(1),depth||0)}catch(e){return NaN}}
  var n=parseFloat(raw);
  return isNaN(n)?raw:n;
}
function sheetRecalc(){
  sheetVals={};
  SHEET_COLS.forEach(function(c){for(var r=1;r<=SHEET_ROWS;r++){var ref=c+r;sheetVals[ref]=sheetValue(ref,1)}});
}
function sheetSubstitute(txt){
  try{
    sheetRecalc();
    var ok=true;
    var out=txt.replace(/\b([A-F])(1[0-2]|[1-9])\b/g,function(_,c,r){
      var v=sheetVals[c+r];
      if(typeof v!=='number'||!isFinite(v)){ok=false;return '0'}
      return String(Math.round(v*1e6)/1e6);
    });
    return ok?out:null;
  }catch(e){return null}
}
function sheetDisplay(ref){
  var v=sheetVals[ref];
  if(typeof v==='number'){if(!isFinite(v))return '#ERR';return String(Math.round(v*1e6)/1e6)}
  return v==null?'':String(v);
}
var sheetDlg=null,sheetFocusRef=null;
function buildSheetDlg(){
  if(sheetDlg)return sheetDlg;
  sheetDlg=document.createElement('div');
  sheetDlg.className='wb-dlg';sheetDlg.id='wb-sheet';
  sheetDlg.style.cssText='right:12px;top:210px;';
  var head='<div class="wb-dlg-head"><span>Spreadsheet</span><button data-wb-close="1" title="Close">\u2715</button></div>';
  var rows='<tr><th class="rn"></th>'+SHEET_COLS.map(function(c){return '<th>'+c+'</th>'}).join('')+'</tr>';
  for(var r=1;r<=SHEET_ROWS;r++){
    rows+='<tr><th class="rn">'+r+'</th>'+SHEET_COLS.map(function(c){
      return '<td><input data-wb-cell="'+c+r+'" autocomplete="off" spellcheck="false"></td>';
    }).join('')+'</tr>';
  }
  sheetDlg.innerHTML=head+'<div class="wb-dlg-body"><div class="wb-row"><input type="text" id="wb-formula" placeholder="Select a cell; type value or =A1*2+B1" readonly></div><table id="wb-sheet-grid">'+rows+'</table><div style="margin-top:7px;color:#8a8d91;font-size:10px">Formulas: =A1+B2*2, sin(), sqrt(), pi \u2022 Use =A1,B1 in the command line as coordinates</div></div>';
  document.body.appendChild(sheetDlg);
  sheetDlg.addEventListener('click',function(e){if(e.target.closest('[data-wb-close]'))sheetDlg.classList.remove('open')});
  sheetDlg.addEventListener('focusin',function(e){
    var c=e.target.getAttribute&&e.target.getAttribute('data-wb-cell');
    if(c){sheetFocusRef=c;e.target.value=sheetRaw(c);var f=$('#wb-formula',sheetDlg);f.value=sheetRaw(c);}
  });
  sheetDlg.addEventListener('focusout',function(e){
    var c=e.target.getAttribute&&e.target.getAttribute('data-wb-cell');
    if(c){var s=sheetStore();if(s){var v=e.target.value.trim();if(v==='')delete s.cells[c];else s.cells[c]=v;try{window.save&&save()}catch(err){}}refreshSheet()}
  });
  sheetDlg.addEventListener('keydown',function(e){
    if(e.key==='Enter'&&e.target.getAttribute&&e.target.getAttribute('data-wb-cell')){e.preventDefault();e.target.blur()}
    e.stopPropagation();
  });
  return sheetDlg;
}
function refreshSheet(){
  if(!sheetDlg)return;
  sheetRecalc();
  sheetDlg.querySelectorAll('[data-wb-cell]').forEach(function(inp){
    var ref=inp.getAttribute('data-wb-cell');
    if(ref!==sheetFocusRef||document.activeElement!==inp)inp.value=sheetDisplay(ref)===''?'':sheetDisplay(ref);
  });
}

/* ---------------- materials (density / modulus / hatch cards) ---------------- */
var CARDS=[
  {name:'Steel',kind:'Metal',density:7900,youngsModulus:'210 GPa',poissonRatio:0.30,color:'#9fb6c9',hatch:{angle:45,gap:9}},
  {name:'Aluminium',kind:'Metal',density:2700,youngsModulus:'70 GPa',poissonRatio:0.35,color:'#c9cdd2',hatch:{angle:45,gap:9,cross:true}},
  {name:'Concrete',kind:'Mineral',density:2400,youngsModulus:'32 GPa',poissonRatio:0.17,color:'#b7ab98',hatch:{angle:30,gap:12,cross:true}},
  {name:'Wood',kind:'Organic',density:700,youngsModulus:'12 GPa',poissonRatio:0.05,color:'#c8a06a',hatch:{angle:0,gap:10}},
