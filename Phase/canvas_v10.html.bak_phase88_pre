  function showBubble(msg){const b=document.createElement('div'); b.className='uploaded-chat-bubble'; b.textContent=msg; b.style.left=Math.round(innerWidth/2-90)+'px'; b.style.top=Math.round(innerHeight/2-70)+'px'; document.body.appendChild(b); setTimeout(()=>b.remove(),4200)}
