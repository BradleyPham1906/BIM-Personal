  function centerOn(n){try{ if(!n||typeof view==='undefined')return; view.z=Math.max(.35,Math.min(1.4,view.z||1)); view.x=innerWidth/2-(n.x+n.w/2)*view.z; view.y=innerHeight/2-(n.y+n.h/2)*view.z; applyView&&applyView(); renderEdges&&renderEdges(); }catch(e){} }
  function makeLayerPanel(){
    if($('#uploaded-layers-panel'))return;
    const panel=document.createElement('aside'); panel.id='uploaded-layers-panel';
    panel.innerHTML=`<div class="ul-head"><div class="ul-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 8 4-8 4-8-4 8-4Z"/><path d="m4 12 8 4 8-4"/><path d="m4 17 8 4 8-4"/></svg><span>Layers</span></div><button class="ul-toggle" title="Collapse layers">‹</button></div><div class="ul-list"></div><div class="ul-actions"><button data-act="front">Front</button><button data-act="back">Back</button><button data-act="fit">Focus</button></div>`;
