      A3D.flat=true;
      if(src.levelId)A3D.activeLevel=src.levelId;
      A3D.levelFilter=!!src.levelFilter;
      A3D.activeViewId=null;A3D.sel=null;A3D.sel2=null;A3D.view=src.label||'';
      if(src.section){
