        const p=toWorld(e.clientX,e.clientY);
        const n=it.make(p.x-(it.w||300)/2,p.y-(it.h||200)/2);
        if(n&&n.id)select(n.id);
      } else if(!d.moved){
        const c=toWorld(innerWidth/2,innerHeight/2);
        const n=it.make(c.x-(it.w||300)/2,c.y-(it.h||200)/2);
        if(n&&n.id)select(n.id);
      }
    }catch(err){}
  },true);
  // Re-render whenever the Assets tab becomes active (survives future sidebar updates).
  document.addEventListener('click',e=>{
    if(e.target.closest?.('[data-fl-tab="assets"],[data-tab="assets"]')) setTimeout(render,60);
  },true);
  const mo=new MutationObserver(()=>{const shell=$('#figma-layers-shell');if(shell?.dataset.tab==='assets'&&!$('#figma-layers-panel .fak-root'))setTimeout(render,0);});
  function arm(){const panel=$('#figma-layers-panel'); if(!panel){setTimeout(arm,400);return;} mo.observe(panel,{childList:true,subtree:false}); if($('#figma-layers-shell')?.dataset.tab==='assets')render();}
  arm();
})();
</script>

