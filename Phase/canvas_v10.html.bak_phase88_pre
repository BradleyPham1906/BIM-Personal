<script>
// =============================================================================
// ULTIMATE CANVAS — Drafting Engine v1
// Line · Polyline (Wire) · Rectangle · Circle
// Original implementation of line/polyline/rectangle/circle drafting.
// =============================================================================
(function draftingEngine() {
  if (window.__draftingEngineV1) return;
  window.__draftingEngineV1 = true;

  // ─── Helpers ────────────────────────────────────────────────────────────────
  const tw = (cx, cy) => typeof toWorld === 'function'
    ? toWorld(cx, cy)
    : { x: (cx - view.x) / view.z, y: (cy - view.y) / view.z };
  const sw = (wx, wy) => ({ x: wx * view.z + view.x, y: wy * view.z + view.y });
  const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
  const nid = () => '_wire_' + (Math.random() * 1e9 | 0);
  const PI2 = Math.PI * 2;

  // ─── Wire State ──────────────────────────────────────────────────────────
  // Each wire: { id, type:'line'|'wire'|'rect'|'circle',
  //              points:[{x,y}], closed:bool,
  //              color, lineWidth, lineStyle:'solid'|'dashed'|'dotted',
  //              layerId, selected:bool,
  //              // circle only:
  //              cx, cy, radius }
  if (!state.wires) state.wires = [];

  // ─── Tool State (drafting-tool state machine) ───────────────────────────
  const TOOL = {
    active: null,       // 'line' | 'wire' | 'rect' | 'circle' | null
    points: [],         // collected world points
    previewPt: null,    // current cursor world point (for rubber-band)
    circleCenter: null, // circle/ellipse/polygon: first click = center
    sides: 6,           // polygon tool: number of sides (keys 3-9)
  };

  // ─── SVG Wire Overlay ───────────────────────────────────────────────────────
  // Sits between the canvas and the snap overlay (z-index 2147482998)
  const wireSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  wireSvg.id = 'wire-overlay';
  // Mount inside #viewport so overflow:hidden clips it to the canvas area
  Object.assign(wireSvg.style, {
    position: 'absolute', inset: '0', width: '100%', height: '100%',
    pointerEvents: 'none', zIndex: '2147482998', overflow: 'visible'
  });
  (document.getElementById('viewport') || document.body).appendChild(wireSvg);

  // ─── Rendering ──────────────────────────────────────────────────────────────
  function ptStr(pts) {
    return pts.map(p => { const s = sw(p.x, p.y); return `${s.x},${s.y}`; }).join(' ');
  }

  function dashArray(style) {
    if (style === 'dashed') return '8,5';
    if (style === 'dotted') return '2,4';
    return 'none';
  }

  function mkEl(tag, attrs) {
    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    return el;
  }

  function renderWires() {
    wireSvg.innerHTML = '';
    if (!Array.isArray(state.wires)) state.wires = [];

    // ── Committed wires ──
    for (const w of state.wires) {
      const layer = state.layers?.find(l => l.id === w.layerId);
      if (layer && !layer.visible) continue;
      const col = w.color || layer?.color || '#5E9FE8';
      const lw = (w.lineWidth || layer?.lineWeight || 1.5) * (view.z || 1);
      const da = dashArray(w.lineStyle);
      const sel = w.selected;

      if (w.type === 'circle') {
        const sc = sw(w.cx, w.cy);
        const sr = w.radius * (view.z || 1);
        if (sel) wireSvg.appendChild(mkEl('circle', { cx: sc.x, cy: sc.y, r: sr + 4, fill: 'none', stroke: 'rgba(100,180,255,0.4)', 'stroke-width': 8 }));
        wireSvg.appendChild(mkEl('circle', { cx: sc.x, cy: sc.y, r: sr, fill: 'none', stroke: col, 'stroke-width': Math.max(lw, 1.2), 'stroke-dasharray': da }));
        // Center dot
        wireSvg.appendChild(mkEl('circle', { cx: sc.x, cy: sc.y, r: 2.5, fill: col, opacity: 0.7 }));
      } else if (w.type === 'rect') {
        const pts = w.points;
        if (pts.length < 2) continue;
        const sa = sw(pts[0].x, pts[0].y);
        const sb = sw(pts[1].x, pts[1].y);
        const rx = Math.min(sa.x, sb.x), ry = Math.min(sa.y, sb.y);
        const rw = Math.abs(sb.x - sa.x), rh = Math.abs(sb.y - sa.y);
        if (sel) wireSvg.appendChild(mkEl('rect', { x: rx-4, y: ry-4, width: rw+8, height: rh+8, fill: 'none', stroke: 'rgba(100,180,255,0.4)', 'stroke-width': 8 }));
        wireSvg.appendChild(mkEl('rect', { x: rx, y: ry, width: rw, height: rh, fill: 'none', stroke: col, 'stroke-width': Math.max(lw, 1.2), 'stroke-dasharray': da }));
      } else {
        // line / wire polyline
        if (w.points.length < 2) continue;
        const allPts = w.closed ? [...w.points, w.points[0]] : w.points;
        const ps = ptStr(allPts);
        if (sel) wireSvg.appendChild(mkEl('polyline', { points: ps, fill: 'none', stroke: 'rgba(100,180,255,0.4)', 'stroke-width': (lw * 1) + 8, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }));
        wireSvg.appendChild(mkEl('polyline', { points: ps, fill: 'none', stroke: col, 'stroke-width': Math.max(lw, 1.2), 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'stroke-dasharray': da }));
        // Vertex dots
        for (const p of w.points) {
          const sp = sw(p.x, p.y);
          wireSvg.appendChild(mkEl('circle', { cx: sp.x, cy: sp.y, r: 3, fill: col, opacity: 0.75 }));
        }
      }
    }

    // ── Rubber-band preview ──
    drawPreview();
  }

  function drawPreview() {
    if (!TOOL.active || !TOOL.previewPt) return;
    const snapped = (window.__cadSnapCurrent) || TOOL.previewPt;
    const layer = state.layers?.find(l => l.id === state.activeLayer);
    const col = layer?.color || '#5E9FE8';

    if (TOOL.active === 'circle' && TOOL.circleCenter) {
      const sc = sw(TOOL.circleCenter.x, TOOL.circleCenter.y);
      const sp = sw(snapped.x, snapped.y);
      const r = Math.hypot(sp.x - sc.x, sp.y - sc.y);
      wireSvg.appendChild(mkEl('circle', { cx: sc.x, cy: sc.y, r, fill: 'none', stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.7 }));
      // radius line
      wireSvg.appendChild(mkEl('line', { x1: sc.x, y1: sc.y, x2: sp.x, y2: sp.y, stroke: col, 'stroke-width': 1, 'stroke-dasharray': '4,3', opacity: 0.5 }));
      // label
      const wr = dist(TOOL.circleCenter, snapped);
      drawPreviewLabel(sp.x + 8, sp.y - 8, `r = ${Math.round(wr)}`);
    } else if (TOOL.active === 'rect' && TOOL.points.length === 1) {
      const sa = sw(TOOL.points[0].x, TOOL.points[0].y);
      const sb = sw(snapped.x, snapped.y);
      const rx = Math.min(sa.x, sb.x), ry = Math.min(sa.y, sb.y);
      const rw = Math.abs(sb.x - sa.x), rh = Math.abs(sb.y - sa.y);
      wireSvg.appendChild(mkEl('rect', { x: rx, y: ry, width: rw, height: rh, fill: 'rgba(94,159,232,0.06)', stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.8 }));
      drawPreviewLabel(sb.x + 8, sb.y - 8, `${Math.round(Math.abs(snapped.x - TOOL.points[0].x))} × ${Math.round(Math.abs(snapped.y - TOOL.points[0].y))}`);
    } else if (TOOL.active === 'ellipse' && TOOL.circleCenter) {
      const pts = ellipsePoints(TOOL.circleCenter, snapped);
      if (pts.length) {
        wireSvg.appendChild(mkEl('polygon', { points: ptStr(pts), fill: 'rgba(94,159,232,0.05)', stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.8 }));
        const sp = sw(snapped.x, snapped.y);
        drawPreviewLabel(sp.x + 8, sp.y - 8, `${Math.round(Math.abs(snapped.x - TOOL.circleCenter.x))} × ${Math.round(Math.abs(snapped.y - TOOL.circleCenter.y))}`);
      }
    } else if (TOOL.active === 'polygon' && TOOL.circleCenter) {
      const pts = polygonPoints(TOOL.circleCenter, snapped, TOOL.sides);
      if (pts.length) {
        wireSvg.appendChild(mkEl('polygon', { points: ptStr(pts), fill: 'rgba(94,159,232,0.05)', stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.8 }));
        const sp = sw(snapped.x, snapped.y);
        drawPreviewLabel(sp.x + 8, sp.y - 8, TOOL.sides + ' sides · r=' + Math.round(dist(TOOL.circleCenter, snapped)));
      }
    } else if (TOOL.active === 'arc' && TOOL.points.length === 2) {
      const pts = arcPoints(TOOL.points[0], TOOL.points[1], snapped);
      wireSvg.appendChild(mkEl('polyline', { points: ptStr(pts), fill: 'none', stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.8 }));
    } else if (TOOL.points.length > 0) {
      // Line or wire: draw from last point to cursor
      const allPrev = TOOL.points;
      const last = allPrev[allPrev.length - 1];
      // Ghost of committed segments
      if (allPrev.length > 1) {
        const ps = ptStr(allPrev);
        wireSvg.appendChild(mkEl('polyline', { points: ps, fill: 'none', stroke: col, 'stroke-width': 1.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', opacity: 0.9 }));
      }
      // Rubber band to cursor
      const sl = sw(last.x, last.y);
      const sc2 = sw(snapped.x, snapped.y);
      wireSvg.appendChild(mkEl('line', { x1: sl.x, y1: sl.y, x2: sc2.x, y2: sc2.y, stroke: col, 'stroke-width': 1.2, 'stroke-dasharray': '6,4', opacity: 0.8 }));
      // Close preview (if wire has 3+ pts)
      if (TOOL.active === 'wire' && TOOL.points.length >= 2) {
        const sf = sw(TOOL.points[0].x, TOOL.points[0].y);
        wireSvg.appendChild(mkEl('line', { x1: sc2.x, y1: sc2.y, x2: sf.x, y2: sf.y, stroke: col, 'stroke-width': 0.8, 'stroke-dasharray': '3,5', opacity: 0.35 }));
      }
      // Distance label
      const d = dist(last, snapped);
      drawPreviewLabel(sc2.x + 8, sc2.y - 8, `${Math.round(d)}`);
    } else if (TOOL.active === 'circle') {
      // No center yet — crosshair only (handled by snap overlay)
    }
  }

  function drawPreviewLabel(x, y, text) {
    const bg = mkEl('rect', { x: x - 2, y: y - 10, width: text.length * 6 + 6, height: 14, rx: 3, fill: 'rgba(20,20,20,0.8)' });
    const txt = mkEl('text', { x, y: y + 1, fill: '#cde', 'font-size': '10', 'font-family': 'Inter, monospace', 'font-weight': '600' });
    txt.textContent = text;
    wireSvg.appendChild(bg);
    wireSvg.appendChild(txt);
  }

  // ─── Tool Activation ────────────────────────────────────────────────────────
  function activateTool(name) {
    TOOL.active = name;
    TOOL.points = [];
    TOOL.previewPt = null;
    TOOL.circleCenter = null;
    window.__cadSnapEnabled = true;  // auto-enable snap
    if (window.__setHUDSnap) window.__setHUDSnap(true);
    if (window.__setHUDMode) window.__setHUDMode(name.toUpperCase());
    const msgs = {
      line: '📏 LINE — click first point',
      wire: '📐 WIRE — click points · Enter/Dbl-click to finish · C to close',
      rect: '▭ RECT — click first corner',
      circle: '○ CIRCLE — click center point',
      arc: '◠ ARC — click start point (3-point arc)',
      ellipse: '⬭ ELLIPSE — click center point',
      polygon: '⬠ POLYGON — click center point · keys 3–9 set sides',
    };
    toast?.(msgs[name] || name + ' tool active');
  }

  function cancelTool() {
    if (!TOOL.active) return;
    const prev = TOOL.active;
    TOOL.active = null;
    TOOL.points = [];
    TOOL.previewPt = null;
    TOOL.circleCenter = null;
    if (window.__setHUDMode) window.__setHUDMode('SELECT');
    renderWires();
    toast?.('✖ ' + prev.toUpperCase() + ' cancelled');
  }

  // ─── Geometry helpers (AutoCAD ARC / ELLIPSE / POLYGON) ───────────────────────
  function circum(a, b, c) {
    const d = 2 * (a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y));
    if (Math.abs(d) < 1e-9) return null;
    const ux = ((a.x*a.x + a.y*a.y) * (b.y - c.y) + (b.x*b.x + b.y*b.y) * (c.y - a.y) + (c.x*c.x + c.y*c.y) * (a.y - b.y)) / d;
    const uy = ((a.x*a.x + a.y*a.y) * (c.x - b.x) + (b.x*b.x + b.y*b.y) * (a.x - c.x) + (c.x*c.x + c.y*c.y) * (b.x - a.x)) / d;
    return { x: ux, y: uy };
  }

  function arcPoints(p1, p2, p3) {
    // 3-point arc: sample circumcircle from p1 through p2 to p3 (AutoCAD ARC default)
    const c = circum(p1, p2, p3);
    if (!c) return [p1, p3]; // collinear -> straight segment
    const r = Math.hypot(p1.x - c.x, p1.y - c.y);
    const TAU = Math.PI * 2;
    const a1 = Math.atan2(p1.y - c.y, p1.x - c.x);
    const a2 = Math.atan2(p2.y - c.y, p2.x - c.x);
    const a3 = Math.atan2(p3.y - c.y, p3.x - c.x);
    const dm = ((a2 - a1) % TAU + TAU) % TAU;
    const de = ((a3 - a1) % TAU + TAU) % TAU;
    let sweep, dir;
    if (dm <= de) { sweep = de; dir = 1; } else { sweep = TAU - de; dir = -1; }
    const n = Math.max(12, Math.ceil(sweep / (Math.PI / 24)));
    const pts = [];
    for (let i = 0; i <= n; i++) {
      const a = a1 + dir * sweep * i / n;
      pts.push({ x: c.x + r * Math.cos(a), y: c.y + r * Math.sin(a) });
    }
    return pts;
  }

  function ellipsePoints(c, k) {
    // center + corner (AutoCAD ELLIPSE Center mode), 64-segment closed polyline
    const rx = Math.abs(k.x - c.x), ry = Math.abs(k.y - c.y);
    if (rx < 1 || ry < 1) return [];
    const pts = [];
    for (let i = 0; i < 64; i++) {
      const a = i / 64 * Math.PI * 2;
      pts.push({ x: c.x + rx * Math.cos(a), y: c.y + ry * Math.sin(a) });
    }
    return pts;
  }

  function polygonPoints(c, v, n) {
    // center + vertex (AutoCAD POLYGON inscribed), n sides
    const r = Math.hypot(v.x - c.x, v.y - c.y);
    if (r < 1) return [];
    const a0 = Math.atan2(v.y - c.y, v.x - c.x);
    const pts = [];
    for (let i = 0; i < n; i++) {
      const a = a0 + i / n * Math.PI * 2;
      pts.push({ x: c.x + r * Math.cos(a), y: c.y + r * Math.sin(a) });
    }
    return pts;
  }

  // ─── Commit wire ─────────────────────────────────────────────────────────
  function commitWire(points, type, closed = false, extra = {}) {
    const layer = state.layers?.find(l => l.id === state.activeLayer);
    const wire = {
      id: nid(),
      type,
      points: points.map(p => ({ x: p.x, y: p.y })),
      closed,
      color: layer?.color || '#5E9FE8',
      lineWidth: layer?.lineWeight || 1.5,
      lineStyle: 'solid',
      layerId: state.activeLayer || 'layer-0',
      selected: false,
      ...extra
    };
    state.wires.push(wire);
    save?.();
    renderWires();
    return wire;
  }

  function commitCircle(center, radius) {
    const layer = state.layers?.find(l => l.id === state.activeLayer);
    const wire = {
      id: nid(),
      type: 'circle',
      points: [],
      closed: true,
      cx: center.x, cy: center.y, radius,
      color: layer?.color || '#5E9FE8',
      lineWidth: layer?.lineWeight || 1.5,
      lineStyle: 'solid',
      layerId: state.activeLayer || 'layer-0',
      selected: false,
    };
    state.wires.push(wire);
    save?.();
    renderWires();
    return wire;
  }

  // ─── Viewport Events ────────────────────────────────────────────────────────
  const vp = document.getElementById('viewport');

  // Mousemove: rubber-band preview
  vp.addEventListener('pointermove', e => {
    if (!TOOL.active) return;
    let wp = tw(e.clientX, e.clientY);
    // Apply snap if available
    if (window.__cadSnapCurrent) wp = { ...window.__cadSnapCurrent };
    // Apply ortho
    if (window.__cadOrtho) {
      const base = TOOL.points.length > 0 ? TOOL.points[TOOL.points.length - 1]
                 : (TOOL.circleCenter || null);
      if (base && window.__applyOrtho) wp = window.__applyOrtho(wp, base);
    }
    TOOL.previewPt = wp;
    renderWires();
  }, { passive: true });

  // Click: add point
  vp.addEventListener('pointerdown', e => {
    if (!TOOL.active) return;
    if (e.button !== 0) return; // left click only
    e.stopPropagation();

    let wp = tw(e.clientX, e.clientY);
    if (window.__cadSnapCurrent) wp = { ...window.__cadSnapCurrent };
    if (window.__cadOrtho) {
      const base = TOOL.points.length > 0 ? TOOL.points[TOOL.points.length - 1]
                 : (TOOL.circleCenter || null);
      if (base && window.__applyOrtho) wp = window.__applyOrtho(wp, base);
    }

    if (TOOL.active === 'circle') {
      if (!TOOL.circleCenter) {
        TOOL.circleCenter = { ...wp };
        toast?.('○ CIRCLE — click radius point');
      } else {
        const r = dist(TOOL.circleCenter, wp);
        if (r > 1) {
          commitCircle(TOOL.circleCenter, r);
          toast?.('Circle added · radius ' + Math.round(r) + 'px');
          // Continue mode: reset for next circle
          TOOL.circleCenter = null;
          TOOL.points = [];
          toast?.('○ CIRCLE — click center point');
        }
      }
      return;
    }

    if (TOOL.active === 'rect') {
      if (TOOL.points.length === 0) {
        TOOL.points.push({ ...wp });
        toast?.('▭ RECT — click opposite corner');
      } else {
        const p1 = TOOL.points[0];
        // Build 4 corner points from the two picked corners
        commitWire(
          [p1, { x: wp.x, y: p1.y }, wp, { x: p1.x, y: wp.y }],
          'rect', true,
          { points: [p1, wp] }  // store just 2 pts for rendering
        );
        // Actually just use 2-point form for rect
        state.wires[state.wires.length - 1].points = [p1, wp];
        toast?.('Rectangle added');
        // Continue
        TOOL.points = [];
        toast?.('▭ RECT — click first corner');
      }
      return;
    }

    if (TOOL.active === 'ellipse') {
      if (!TOOL.circleCenter) {
        TOOL.circleCenter = { ...wp };
        toast?.('⬭ ELLIPSE — click corner point (sets both radii)');
      } else {
        const pts = ellipsePoints(TOOL.circleCenter, wp);
        if (pts.length) {
          commitWire(pts, 'wire', true, { kind: 'ellipse' });
          toast?.('Ellipse added');
        }
        TOOL.circleCenter = null;
        toast?.('⬭ ELLIPSE — click center point');
      }
      return;
    }

    if (TOOL.active === 'polygon') {
      if (!TOOL.circleCenter) {
        TOOL.circleCenter = { ...wp };
        toast?.('⬠ POLYGON — click a vertex · sides: ' + TOOL.sides + ' (keys 3–9)');
      } else {
        const pts = polygonPoints(TOOL.circleCenter, wp, TOOL.sides);
        if (pts.length) {
          commitWire(pts, 'wire', true, { kind: 'polygon', sides: TOOL.sides });
          toast?.('Polygon added · ' + TOOL.sides + ' sides');
        }
        TOOL.circleCenter = null;
        toast?.('⬠ POLYGON — click center point');
      }
      return;
    }

    if (TOOL.active === 'arc') {
      TOOL.points.push({ ...wp });
      if (TOOL.points.length === 1) toast?.('◠ ARC — click second point (on the arc)');
      else if (TOOL.points.length === 2) toast?.('◠ ARC — click end point');
      else {
        commitWire(arcPoints(TOOL.points[0], TOOL.points[1], TOOL.points[2]), 'wire', false, { kind: 'arc' });
        toast?.('Arc added');
        TOOL.points = [];
        toast?.('◠ ARC — click start point');
      }
      return;
    }

    // Line / Wire: collect point
    TOOL.points.push({ ...wp });

    if (TOOL.active === 'line') {
      if (TOOL.points.length === 1) {
        toast?.('LINE — click endpoint');
      } else if (TOOL.points.length === 2) {
        // Line tool: commits on 2nd click
        commitWire(TOOL.points, 'line', false);
        toast?.(`Line added · ${Math.round(dist(TOOL.points[0], TOOL.points[1]))}px`);
        // Continue mode
        const p2 = { ...TOOL.points[1] };
        TOOL.points = [p2]; // chain from last endpoint
        toast?.('LINE — click endpoint (chain continues · Esc to stop)');
      }
    } else if (TOOL.active === 'wire') {
      toast?.(`Wire: ${TOOL.points.length} point${TOOL.points.length > 1 ? 's' : ''} · Enter to finish · C to close`);
    }
  }, true);

  // Double-click: finish wire
  vp.addEventListener('dblclick', e => {
    if (TOOL.active !== 'wire') return;
    e.stopPropagation();
    if (TOOL.points.length >= 2) {
      // Remove duplicate from the two clicks of dblclick
      const pts = TOOL.points.slice(0, -1);
      commitWire(pts, 'wire', false);
      toast?.(`Polyline added · ${pts.length} points`);
    }
    resetTool();
  }, true);

  // Right-click: context (cancel or close)
  vp.addEventListener('contextmenu', e => {
    if (!TOOL.active) return;
    e.preventDefault();
    e.stopPropagation();
    if (TOOL.active === 'wire' && TOOL.points.length >= 2) {
      // Right-click = finish open wire
      commitWire(TOOL.points, 'wire', false);
      toast?.(`Polyline added · ${TOOL.points.length} points`);
      resetTool();
    } else {
      cancelTool();
    }
  }, true);

  function resetTool() {
    TOOL.active = null;
    TOOL.points = [];
    TOOL.previewPt = null;
    TOOL.circleCenter = null;
    if (window.__setHUDMode) window.__setHUDMode('SELECT');
    renderWires();
  }

  // ─── Keyboard shortcuts ──────────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;

    // Escape — cancel
    if (e.key === 'Escape' && TOOL.active) { cancelTool(); return; }

    // F7 — toggle grid (AutoCAD F7)
    if (e.key === 'F7') { e.preventDefault(); window.cadRun?.('grid'); return; }

    // 3-9 — polygon side count (while POLYGON tool active)
    if (TOOL.active === 'polygon' && /^[3-9]$/.test(e.key)) {
      TOOL.sides = parseInt(e.key, 10);
      toast?.('⬠ Polygon sides: ' + TOOL.sides);
      renderWires();
      return;
    }

    // Enter — finish wire
    if (e.key === 'Enter' && TOOL.active === 'wire') {
      e.preventDefault();
      if (TOOL.points.length >= 2) {
        commitWire(TOOL.points, 'wire', false);
        toast?.(`Polyline added · ${TOOL.points.length} points`);
      }
      resetTool();
      return;
    }

    // C — close wire
    if ((e.key === 'c' || e.key === 'C') && TOOL.active === 'wire') {
      e.preventDefault();
      if (TOOL.points.length >= 3) {
        commitWire(TOOL.points, 'wire', true); // closed=true
        toast?.(`Closed polyline added · ${TOOL.points.length} points`);
      }
      resetTool();
      return;
    }

    // U / Backspace — undo last point
    if ((e.key === 'u' || e.key === 'U' || e.key === 'Backspace') && TOOL.active) {
      if (TOOL.points.length > 0) {
        TOOL.points.pop();
        toast?.('Undo last point · ' + TOOL.points.length + ' remaining');
        renderWires();
      }
      return;
    }

    // L = Line, W = Wire, R = Rect, C when no tool = Circle
    // (suppressed while a modify or curve tool is active)
    if (!TOOL.active
        && !(window.__modifyActiveTool && window.__modifyActiveTool())
        && !(window.__curvesActiveTool && window.__curvesActiveTool())
        && !(window.__annotActiveTool && window.__annotActiveTool())) {
      if (e.key === 'l' || e.key === 'L') activateTool('line');
      if (e.key === 'w' || e.key === 'W') activateTool('wire');
      if (e.key === 'r' || e.key === 'R') activateTool('rect');
      if (e.key === 'c' || e.key === 'C') activateTool('circle');
      if (e.key === 'a' || e.key === 'A') activateTool('arc');
    }
  });

  // ─── Wire Selection (click on wire) ─────────────────────────────────────────
  // CRITICAL: the wire overlay must stay pointer-events:none so it never
  // blocks the canvas. We hit-test from a bubble-phase viewport listener
  // instead, which runs after normal canvas handlers and never blocks them.
  vp.addEventListener('pointerdown', e => {
    if (TOOL.active) return;           // don't select while drawing
    if (window.__modifyActiveTool && window.__modifyActiveTool()) return; // modify tool owns clicks
    if (window.__curvesActiveTool && window.__curvesActiveTool()) return; // curve tool owns clicks
    if (window.__annotActiveTool && window.__annotActiveTool()) return; // annotation tool owns clicks
    if (e.button !== 0) return;        // left click only
    if (!state.wires || state.wires.length === 0) return;
    // Only hit-test when clicking the empty canvas, not a card/node/UI element
    const hitNode = e.target.closest && e.target.closest('.node, .card, [data-id]');
    const cp = { x: e.clientX, y: e.clientY };
    let best = null, bestD = 14; // 14px threshold
    for (const w of state.wires) {
      const d = wireClickDist(w, cp);
      if (d < bestD) { bestD = d; best = w; }
    }
    const hadSelection = state.wires.some(w => w.selected);
    state.wires.forEach(w => w.selected = false);
    if (best && !hitNode) {
      best.selected = true;
      showWireProps(best);
      renderWires();
    } else if (hadSelection) {
      hideWireProps();
      renderWires();
    }
  });

  function wireClickDist(w, screenPt) {
    if (w.type === 'circle') {
      const sc = sw(w.cx, w.cy);
      const sr = w.radius * view.z;
      const d = Math.hypot(screenPt.x - sc.x, screenPt.y - sc.y);
      return Math.abs(d - sr);
    }
    let minD = Infinity;
    const pts = w.type === 'rect'
      ? [w.points[0], { x: w.points[1].x, y: w.points[0].y }, w.points[1], { x: w.points[0].x, y: w.points[1].y }, w.points[0]]
      : (w.closed ? [...w.points, w.points[0]] : w.points);
    for (let i = 0; i < pts.length - 1; i++) {
      const a = sw(pts[i].x, pts[i].y);
      const b = sw(pts[i+1].x, pts[i+1].y);
      minD = Math.min(minD, ptSegDist(screenPt, a, b));
    }
    return minD;
  }

  function ptSegDist(p, a, b) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const len2 = dx*dx + dy*dy;
    if (len2 === 0) return Math.hypot(p.x - a.x, p.y - a.y);
    let t = ((p.x - a.x)*dx + (p.y - a.y)*dy) / len2;
    t = Math.max(0, Math.min(1, t));
    return Math.hypot(p.x - (a.x + t*dx), p.y - (a.y + t*dy));
  }

  // ─── Wire Properties Panel ───────────────────────────────────────────────
  const propsPanel = document.createElement('div');
  propsPanel.id = 'wire-props-panel';
  propsPanel.className = 'wire-props-panel';
  propsPanel.style.display = 'none';
  document.body.appendChild(propsPanel);

  function showWireProps(w) {
    const styleOpts = ['solid','dashed','dotted'].map(s =>
      `<option value="${s}"${w.lineStyle===s?' selected':''}>${s}</option>`).join('');
    propsPanel.innerHTML = `
      <div class="wp-head">
        <span>${w.type.toUpperCase()}</span>
        <button id="wp-del" title="Delete">🗑 Delete</button>
        <button id="wp-close">×</button>
      </div>
      <div class="wp-row"><label>Color</label><input type="color" id="wp-color" value="${w.color || '#5E9FE8'}"></div>
      <div class="wp-row"><label>Weight</label><input type="range" id="wp-lw" min="0.5" max="8" step="0.5" value="${w.lineWidth || 1.5}"><span id="wp-lw-val">${w.lineWidth || 1.5}px</span></div>
      <div class="wp-row"><label>Style</label><select id="wp-style">${styleOpts}</select></div>
      ${w.type === 'wire' ? `<div class="wp-row"><label>Closed</label><input type="checkbox" id="wp-closed"${w.closed?' checked':''}></div>` : ''}
      <div class="wp-row wp-pts"><label>Points</label><span>${w.type==='circle' ? `cx:${Math.round(w.cx)} cy:${Math.round(w.cy)} r:${Math.round(w.radius)}` : w.points.length}</span></div>
    `;
    propsPanel.style.display = 'block';
    document.getElementById('wp-color').oninput = ev => { w.color = ev.target.value; w.colorOwn = true; renderWires(); };
    document.getElementById('wp-color').onchange = () => save?.();
    const lwSlider = document.getElementById('wp-lw');
    lwSlider.oninput = ev => { w.lineWidth = +ev.target.value; document.getElementById('wp-lw-val').textContent = ev.target.value + 'px'; renderWires(); };
    lwSlider.onchange = () => save?.();
    document.getElementById('wp-style').onchange = ev => { w.lineStyle = ev.target.value; renderWires(); save?.(); };
    if (w.type === 'wire') document.getElementById('wp-closed').onchange = ev => { w.closed = ev.target.checked; renderWires(); save?.(); };
    document.getElementById('wp-close').onclick = hideWireProps;
    document.getElementById('wp-del').onclick = () => {
      state.wires = state.wires.filter(x => x.id !== w.id);
      save?.();
      renderWires();
      hideWireProps();
    };
  }

  function hideWireProps() { propsPanel.style.display = 'none'; }

  // ─── Patch renderAll / applyView / zoom ──────────────────────────────────────
  function patchGlobal(name, after) {
    const orig = window[name];
    if (typeof orig === 'function') {
      window[name] = function() { orig.apply(this, arguments); after(); };
    }
  }
  setTimeout(() => {
    patchGlobal('renderAll', renderWires);
    patchGlobal('applyView', renderWires);
    renderWires();
  }, 400);

  // ─── Hook RUN buttons ────────────────────────────────────────────────────────
  function hookRUN() {
    if (!window.RUN) { setTimeout(hookRUN, 100); return; }
    window.RUN.draftLine   = () => activateTool('line');
    window.RUN.draftWire   = () => activateTool('wire');
    window.RUN.draftRect   = () => activateTool('rect');
    window.RUN.draftCircle = () => activateTool('circle');
    // Aliases
    window.RUN.line   = window.RUN.draftLine;
    window.RUN.wire   = window.RUN.draftWire;
    window.RUN.rect   = window.RUN.draftRect;
    window.RUN.circle = window.RUN.draftCircle;
    window.RUN.draftArc     = () => activateTool('arc');
    window.RUN.draftEllipse = () => activateTool('ellipse');
    window.RUN.draftPolygon = () => activateTool('polygon');
    window.RUN.arc     = window.RUN.draftArc;
    window.RUN.ellipse = window.RUN.draftEllipse;
    window.RUN.polygon = window.RUN.draftPolygon;
    window.RUN.regen   = () => { renderWires(); window.renderAll?.(); toast?.('↻ Regenerated'); };
    window.__cadRenderWires = renderWires;
  }
  hookRUN();

  // ─── Expose globals for CAD engine integration ───────────────────────────────
  window.__draftRenderWires = renderWires;
  window.__draftActiveTool = () => TOOL.active;
  window.__draftCancelTool = cancelTool;

  console.log('[Drafting Engine] Line · Polyline · Rect · Circle loaded ✓');
})();

</script>
<script>
// =============================================================================
// ULTIMATE CANVAS — Modify Engine v2
// TRIM · EXTEND · FILLET · CHAMFER · EXPLODE · ARRAY
// Original implementations of trim/extend intersection logic, tangent-arc
// fillet/chamfer, one-object-per-child explode, and grid/path array.
// =============================================================================
(function modifyEngine() {
  if (window.__modifyEngineV2) return;
  window.__modifyEngineV2 = true;

  const sw = (wx, wy) => ({ x: wx * view.z + view.x, y: wy * view.z + view.y });
  const nid = () => '_wire_' + (Math.random() * 1e9 | 0);
  const EPS = 1e-9;

  const MTOOL = {
    active: null,      // 'trim' | 'extend' | 'fillet' | 'chamfer' | null
    step: 0,
    first: null,
    radius: 20,        // fillet radius (world units), adjust with [ ]
    chamfer: 15,       // chamfer distance, adjust with [ ]
  };
  window.__modifyActiveTool = () => MTOOL.active;

  // ─── Geometry (ported from draftgeoutils intersection patterns) ────────────
  // Intersection of segment/line p1→p2 with p3→p4. Returns {x,y,t,u}.
  function segInt(p1, p2, p3, p4) {
    const d1x = p2.x - p1.x, d1y = p2.y - p1.y;
    const d2x = p4.x - p3.x, d2y = p4.y - p3.y;
    const den = d1x * d2y - d1y * d2x;
    if (Math.abs(den) < EPS) return null;
    const t = ((p3.x - p1.x) * d2y - (p3.y - p1.y) * d2x) / den;
    const u = ((p3.x - p1.x) * d1y - (p3.y - p1.y) * d1x) / den;
    return { x: p1.x + t * d1x, y: p1.y + t * d1y, t, u };
  }

  // Segment a→b vs circle (center c, radius r): returns t params (may be outside [0,1])
  function lineCircleInts(a, b, c, r) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const fx = a.x - c.x, fy = a.y - c.y;
    const A = dx * dx + dy * dy;
    if (A < EPS) return [];
    const B = 2 * (fx * dx + fy * dy);
    const C = fx * fx + fy * fy - r * r;
    let disc = B * B - 4 * A * C;
    if (disc < 0) return [];
    disc = Math.sqrt(disc);
    return [(-B - disc) / (2 * A), (-B + disc) / (2 * A)];
  }

  // Expand a wire into drawable segments [[a,b],...] in world coords
  function wireSegs(w) {
    if (w.type === 'circle') return [];
    let pts;
    if (w.type === 'rect') {
      const p0 = w.points[0], p1 = w.points[1];
      pts = [p0, { x: p1.x, y: p0.y }, p1, { x: p0.x, y: p1.y }, p0];
    } else {
      if (!w.points || w.points.length < 2) return [];
      pts = w.closed ? [...w.points, w.points[0]] : w.points;
    }
    const segs = [];
    for (let i = 0; i < pts.length - 1; i++) segs.push([pts[i], pts[i + 1]]);
    return segs;
  }

  function segPtParam(p, a, b) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const l2 = dx * dx + dy * dy;
    let t = l2 ? ((p.x - a.x) * dx + (p.y - a.y) * dy) / l2 : 0;
    t = Math.max(0, Math.min(1, t));
    return { t, d: Math.hypot(p.x - (a.x + t * dx), p.y - (a.y + t * dy)) };
  }

  // Pick the wire segment nearest to a client point (14px threshold, like select)
  function pickAt(cp) {
    let best = null;
    for (const w of state.wires || []) {
      const layer = state.layers?.find(l => l.id === w.layerId);
      if (layer && !layer.visible) continue;
      if (w.type === 'circle') {
        const sc = sw(w.cx, w.cy);
        const sr = w.radius * (view.z || 1);
        const d = Math.abs(Math.hypot(cp.x - sc.x, cp.y - sc.y) - sr);
        if (d < 14 && (!best || d < best.dist)) best = { wire: w, segIndex: -1, t: 0, dist: d };
        continue;
      }
      const segs = wireSegs(w);
      for (let i = 0; i < segs.length; i++) {
        const a = sw(segs[i][0].x, segs[i][0].y);
        const b = sw(segs[i][1].x, segs[i][1].y);
        const r = segPtParam(cp, a, b);
        if (r.d < 14 && (!best || r.d < best.dist)) best = { wire: w, segIndex: i, t: r.t, dist: r.d };
      }
    }
    return best;
  }

  // All cut params on segment a→b from every OTHER wire (every
  // visible object is a cutting edge)
  function cutTs(a, b, excludeId) {
    const ts = [];
    for (const o of state.wires || []) {
      if (o.id === excludeId) continue;
      if (o.type === 'circle') {
        for (const t of lineCircleInts(a, b, { x: o.cx, y: o.cy }, o.radius))
          if (t > 0.001 && t < 0.999) ts.push(t);
        continue;
      }
      for (const [c, d] of wireSegs(o)) {
        const r = segInt(a, b, c, d);
        if (r && r.t > 0.001 && r.t < 0.999 && r.u >= -0.001 && r.u <= 1.001) ts.push(r.t);
      }
    }
    return ts.sort((x, y) => x - y);
  }

  function rectToWire(w) {
    if (w.type !== 'rect') return;
    const p0 = w.points[0], p1 = w.points[1];
    w.points = [{ x: p0.x, y: p0.y }, { x: p1.x, y: p0.y }, { x: p1.x, y: p1.y }, { x: p0.x, y: p1.y }];
    w.type = 'wire';
    w.closed = true;
  }

  // ─── TRIM ────────────────────────────────────────────────────────────────
  function applyTrim(pk) {
    const w = pk.wire;
    if (w.type === 'circle') { toast?.('TRIM: circles not supported yet'); return; }
    rectToWire(w);
    const segs = wireSegs(w);
    const i = pk.segIndex;
    if (i < 0 || i >= segs.length) return;
    const [a, b] = segs[i];
    const ts = cutTs(a, b, w.id);
    if (!ts.length) { toast?.('TRIM: no intersections on that segment'); return; }
    let lo = null, hi = null;
    for (const t of ts) { if (t <= pk.t) lo = t; else { hi = t; break; } }
    const P = t => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
    const mk = points => Object.assign({}, w, { id: nid(), points, selected: false });

    if (!w.closed) {
      const left = w.points.slice(0, i + 1);
      if (lo !== null) left.push(P(lo));
      const right = (hi !== null ? [P(hi)] : []).concat(w.points.slice(i + 1));
      const out = [];
      if (left.length >= 2) out.push(mk(left));
      if (right.length >= 2) out.push(mk(right));
      state.wires = state.wires.filter(x => x.id !== w.id).concat(out);
    } else {
      // Trimming a closed wire opens it at the cut (AutoCAD behavior)
      const n = w.points.length;
      const newPts = [];
      if (hi !== null) newPts.push(P(hi));
      for (let k = 1; k <= n; k++) newPts.push(w.points[(i + k) % n]);
      if (lo !== null) newPts.push(P(lo));
      const opened = mk(newPts);
      opened.closed = false;
      state.wires = state.wires.filter(x => x.id !== w.id).concat([opened]);
    }
    save?.();
    window.__draftRenderWires?.();
    toast?.('✂ Trimmed');
  }

  // ─── EXTEND ──────────────────────────────────────────────────────────────
  function applyExtend(pk) {
    const w = pk.wire;
    if (w.type === 'circle' || w.closed || w.type === 'rect') { toast?.('EXTEND: pick an open line or polyline'); return; }
    const pts = w.points;
    if (!pts || pts.length < 2) return;
    const nearStart = (pk.segIndex + pk.t) < (pts.length - 1) / 2;
    const endIdx = nearStart ? 0 : pts.length - 1;
    const inIdx = nearStart ? 1 : pts.length - 2;
    const E = pts[endIdx], I = pts[inIdx];
    const len = Math.hypot(E.x - I.x, E.y - I.y) || 1;
    const dir = { x: (E.x - I.x) / len, y: (E.y - I.y) / len };
    const far = { x: E.x + dir.x * 1e6, y: E.y + dir.y * 1e6 };
    let bestT = null;
    for (const o of state.wires || []) {
      if (o.id === w.id) continue;
      if (o.type === 'circle') {
        for (const t of lineCircleInts(E, far, { x: o.cx, y: o.cy }, o.radius))
          if (t > 1e-9 && (bestT === null || t < bestT)) bestT = t;
        continue;
      }
      for (const [c, d] of wireSegs(o)) {
        const r = segInt(E, far, c, d);
        if (r && r.t > 1e-9 && r.u >= -0.001 && r.u <= 1.001 && (bestT === null || r.t < bestT)) bestT = r.t;
      }
    }
    if (bestT === null) { toast?.('EXTEND: no boundary edge found'); return; }
    pts[endIdx] = { x: E.x + dir.x * bestT * 1e6, y: E.y + dir.y * bestT * 1e6 };
    save?.();
    window.__draftRenderWires?.();
    toast?.('⇢ Extended');
  }

  // ─── FILLET / CHAMFER (tangent arc between two lines) ──────────────────────
  const isSimpleLine = w =>
    (w.type === 'line' || w.type === 'wire') && !w.closed && w.points && w.points.length === 2;

  function keepInfo(w, pk, P) {
    // Which endpoint stays: the one on the same side as the click (AutoCAD: the
    // part you click is kept).
    const e0 = w.points[0], e1 = w.points[1];
    const dx = e1.x - e0.x, dy = e1.y - e0.y;
    const l2 = dx * dx + dy * dy || 1;
    const tP = ((P.x - e0.x) * dx + (P.y - e0.y) * dy) / l2;
    const keepStart = pk.t < tP;
    const K = keepStart ? e0 : e1;
    const len = Math.hypot(K.x - P.x, K.y - P.y) || 1;
    return {
      keepStart,
      keptDist: len,
      u: { x: (K.x - P.x) / len, y: (K.y - P.y) / len },
    };
  }

  function setEnd(w, k, pt) {
    // Move the endpoint on the DISCARDED side to pt
    if (k.keepStart) w.points[1] = { x: pt.x, y: pt.y };
    else w.points[0] = { x: pt.x, y: pt.y };
  }

  function arcPointsBetween(C, r, T1, T2) {
    const a1 = Math.atan2(T1.y - C.y, T1.x - C.x);
    const a2 = Math.atan2(T2.y - C.y, T2.x - C.x);
    let delta = a2 - a1;
    while (delta > Math.PI) delta -= 2 * Math.PI;
    while (delta < -Math.PI) delta += 2 * Math.PI;
    const N = 16, pts = [];
    for (let k = 0; k <= N; k++) {
      const a = a1 + delta * (k / N);
      pts.push({ x: C.x + r * Math.cos(a), y: C.y + r * Math.sin(a) });
    }
    return pts;
  }

  function applyFilletChamfer(pk1, pk2, mode) {
    const r = mode === 'fillet' ? MTOOL.radius : MTOOL.chamfer;
    if (pk1.wire === pk2.wire) return cornerFillet(pk1, pk2, mode, r);
    const w1 = pk1.wire, w2 = pk2.wire;
    if (!isSimpleLine(w1) || !isSimpleLine(w2)) {
      toast?.(mode.toUpperCase() + ': pick two straight LINE objects (or two adjacent segments of one polyline)');
      return;
    }
    const X = segInt(w1.points[0], w1.points[1], w2.points[0], w2.points[1]);
    if (!X) { toast?.(mode.toUpperCase() + ': lines are parallel'); return; }
    const P = { x: X.x, y: X.y };
    const k1 = keepInfo(w1, pk1, P);
    const k2 = keepInfo(w2, pk2, P);
    if (r <= 0) {
      setEnd(w1, k1, P); setEnd(w2, k2, P);
    } else {
      const cos = k1.u.x * k2.u.x + k1.u.y * k2.u.y;
      const theta = Math.acos(Math.max(-1, Math.min(1, cos)));
      if (theta < 0.02 || theta > Math.PI - 0.02) { toast?.(mode.toUpperCase() + ': lines are nearly parallel'); return; }
      const tt = mode === 'fillet' ? r / Math.tan(theta / 2) : r;
      if (tt >= k1.keptDist || tt >= k2.keptDist) { toast?.(mode.toUpperCase() + ': radius/distance too large for these lines'); return; }
      const T1 = { x: P.x + k1.u.x * tt, y: P.y + k1.u.y * tt };
      const T2 = { x: P.x + k2.u.x * tt, y: P.y + k2.u.y * tt };
      setEnd(w1, k1, T1);
      setEnd(w2, k2, T2);
      if (mode === 'fillet') {
        const bl = Math.hypot(k1.u.x + k2.u.x, k1.u.y + k2.u.y) || 1;
        const bis = { x: (k1.u.x + k2.u.x) / bl, y: (k1.u.y + k2.u.y) / bl };
        const C = { x: P.x + bis.x * (r / Math.sin(theta / 2)), y: P.y + bis.y * (r / Math.sin(theta / 2)) };
        state.wires.push(Object.assign({}, w1, {
          id: nid(), type: 'wire', kind: 'fillet-arc', closed: false, selected: false,
          points: arcPointsBetween(C, r, T1, T2),
        }));
      } else {
        state.wires.push(Object.assign({}, w1, {
          id: nid(), type: 'line', kind: undefined, closed: false, selected: false,
          points: [T1, T2],
        }));
      }
    }
    save?.();
    window.__draftRenderWires?.();
    toast?.(mode === 'fillet' ? '⌒ Fillet R' + MTOOL.radius + ' applied' : '⟋ Chamfer applied');
  }

  function cornerFillet(pk1, pk2, mode, r) {
    const w = pk1.wire;
    if (w.type === 'circle') { toast?.(mode.toUpperCase() + ': not for circles'); return; }
    rectToWire(w);
    const n = w.points.length;
    let i = Math.min(pk1.segIndex, pk2.segIndex), j = Math.max(pk1.segIndex, pk2.segIndex);
    const segCount = w.closed ? n : n - 1;
    let corner;
    if (j - i === 1) corner = i + 1;
    else if (w.closed && i === 0 && j === segCount - 1) corner = 0;
    else { toast?.(mode.toUpperCase() + ': pick two ADJACENT segments'); return; }
    const P = w.points[corner % n];
    const prev = w.points[(corner - 1 + n) % n];
    const next = w.points[(corner + 1) % n];
    const l1 = Math.hypot(prev.x - P.x, prev.y - P.y) || 1;
    const l2 = Math.hypot(next.x - P.x, next.y - P.y) || 1;
    const u1 = { x: (prev.x - P.x) / l1, y: (prev.y - P.y) / l1 };
    const u2 = { x: (next.x - P.x) / l2, y: (next.y - P.y) / l2 };
    const cos = u1.x * u2.x + u1.y * u2.y;
    const theta = Math.acos(Math.max(-1, Math.min(1, cos)));
    if (theta < 0.02 || theta > Math.PI - 0.02) { toast?.(mode.toUpperCase() + ': segments are nearly parallel'); return; }
    const tt = mode === 'fillet' ? r / Math.tan(theta / 2) : r;
    if (tt >= l1 || tt >= l2) { toast?.(mode.toUpperCase() + ': radius/distance too large for this corner'); return; }
    const T1 = { x: P.x + u1.x * tt, y: P.y + u1.y * tt };
    const T2 = { x: P.x + u2.x * tt, y: P.y + u2.y * tt };
    let insert;
    if (mode === 'fillet') {
      const bl = Math.hypot(u1.x + u2.x, u1.y + u2.y) || 1;
      const bis = { x: (u1.x + u2.x) / bl, y: (u1.y + u2.y) / bl };
      const C = { x: P.x + bis.x * (r / Math.sin(theta / 2)), y: P.y + bis.y * (r / Math.sin(theta / 2)) };
      insert = arcPointsBetween(C, r, T1, T2);
    } else {
      insert = [T1, T2];
    }
    const c = corner % n;
    w.points = w.points.slice(0, c).concat(insert, w.points.slice(c + 1));
    if (w.type === 'rect') w.type = 'wire';
    save?.();
    window.__draftRenderWires?.();
    toast?.(mode === 'fillet' ? '⌒ Corner fillet R' + MTOOL.radius : '⟋ Corner chamfer');
  }

  // ─── EXPLODE (Part Explode.py: one object per child shape) ───────────────────
  function applyExplode() {
    const sel = (state.wires || []).filter(w => w.selected);
    if (!sel.length) { toast?.('EXPLODE: click an object to select it first'); return; }
    let made = 0;
    for (const w of sel) {
      if (w.type === 'circle') { toast?.('EXPLODE: circles skipped'); continue; }
      rectToWire(w);
      const segs = wireSegs(w);
      if (segs.length < 2 && !w.closed) { continue; } // single segment: nothing to explode
      const pieces = segs.map(([a, b]) => Object.assign({}, w, {
        id: nid(), type: 'line', kind: undefined, closed: false, selected: false,
        points: [{ x: a.x, y: a.y }, { x: b.x, y: b.y }],
      }));
      state.wires = state.wires.filter(x => x.id !== w.id).concat(pieces);
      made += pieces.length;
    }
    if (made) {
      save?.();
      window.__draftRenderWires?.();
      toast?.('💥 Exploded into ' + made + ' segments');
    }
  }

  // ─── ARRAY (Draft task panel: rectangular + polar) ────────────────────────────
  const arrPanel = document.createElement('div');
  arrPanel.id = 'modify-array-panel';
  arrPanel.className = 'wire-props-panel';
  arrPanel.style.display = 'none';
  document.body.appendChild(arrPanel);

  function selCentroid(sel) {
    let sx = 0, sy = 0, c = 0;
    for (const w of sel) {
      if (w.type === 'circle') { sx += w.cx; sy += w.cy; c++; continue; }
      for (const p of w.points) { sx += p.x; sy += p.y; c++; }
    }
    return c ? { x: sx / c, y: sy / c } : { x: 0, y: 0 };
  }

  function cloneWire(w, fx) {
    const c = JSON.parse(JSON.stringify(w));
    c.id = nid();
    c.selected = false;
    if (c.type === 'circle') { const p = fx({ x: c.cx, y: c.cy }); c.cx = p.x; c.cy = p.y; }
    else c.points = c.points.map(p => fx(p));
    return c;
  }

  function openArrayPanel() {
    const sel = (state.wires || []).filter(w => w.selected);
    if (!sel.length) { toast?.('ARRAY: click an object to select it first'); return; }
    const ctr = selCentroid(sel);
    arrPanel.innerHTML = `
      <div class="wp-head"><span>ARRAY</span><button id="arr-close">×</button></div>
      <div class="wp-row"><label>Type</label><select id="arr-type"><option value="rect">Rectangular</option><option value="polar">Polar</option></select></div>
      <div class="wp-row arr-rect"><label>Rows</label><input type="number" id="arr-rows" value="2" min="1" style="width:60px"></div>
      <div class="wp-row arr-rect"><label>Columns</label><input type="number" id="arr-cols" value="3" min="1" style="width:60px"></div>
      <div class="wp-row arr-rect"><label>Row ΔY</label><input type="number" id="arr-dy" value="90" style="width:70px"></div>
      <div class="wp-row arr-rect"><label>Col ΔX</label><input type="number" id="arr-dx" value="120" style="width:70px"></div>
      <div class="wp-row arr-polar" style="display:none"><label>Count</label><input type="number" id="arr-count" value="6" min="2" style="width:60px"></div>
      <div class="wp-row arr-polar" style="display:none"><label>Angle°</label><input type="number" id="arr-angle" value="360" style="width:70px"></div>
      <div class="wp-row arr-polar" style="display:none"><label>Center X</label><input type="number" id="arr-cx" value="${Math.round(ctr.x)}" style="width:70px"></div>
      <div class="wp-row arr-polar" style="display:none"><label>Center Y</label><input type="number" id="arr-cy" value="${Math.round(ctr.y)}" style="width:70px"></div>
      <div class="wp-row"><button id="arr-apply" style="width:100%;padding:6px;cursor:pointer">Apply Array</button></div>`;
    arrPanel.style.display = 'block';
    const modeSel = arrPanel.querySelector('#arr-type');
    modeSel.onchange = () => {
      const polar = modeSel.value === 'polar';
      arrPanel.querySelectorAll('.arr-rect').forEach(el => el.style.display = polar ? 'none' : '');
      arrPanel.querySelectorAll('.arr-polar').forEach(el => el.style.display = polar ? '' : 'none');
    };
    arrPanel.querySelector('#arr-close').onclick = () => { arrPanel.style.display = 'none'; };
    arrPanel.querySelector('#arr-apply').onclick = () => {
      const gv = id => parseFloat(arrPanel.querySelector(id).value) || 0;
      const selNow = (state.wires || []).filter(w => w.selected);
      if (!selNow.length) { toast?.('ARRAY: selection lost'); arrPanel.style.display = 'none'; return; }
      let made = 0;
      if (modeSel.value === 'rect') {
        const rows = Math.max(1, gv('#arr-rows') | 0), cols = Math.max(1, gv('#arr-cols') | 0);
        const dx = gv('#arr-dx'), dy = gv('#arr-dy');
        for (let iy = 0; iy < rows; iy++) for (let ix = 0; ix < cols; ix++) {
          if (ix === 0 && iy === 0) continue;
          for (const w of selNow) { state.wires.push(cloneWire(w, p => ({ x: p.x + ix * dx, y: p.y + iy * dy }))); made++; }
        }
      } else {
        const count = Math.max(2, gv('#arr-count') | 0);
        const angle = gv('#arr-angle') || 360;
        const cx = gv('#arr-cx'), cy = gv('#arr-cy');
        const step = (Math.abs(angle - 360) < 1e-6 ? angle / count : angle / (count - 1)) * Math.PI / 180;
        for (let k = 1; k < count; k++) {
          const a = step * k, ca = Math.cos(a), sa = Math.sin(a);
          const rot = p => ({ x: cx + (p.x - cx) * ca - (p.y - cy) * sa, y: cy + (p.x - cx) * sa + (p.y - cy) * ca });
          for (const w of selNow) { state.wires.push(cloneWire(w, rot)); made++; }
        }
      }
      save?.();
      window.__draftRenderWires?.();
      arrPanel.style.display = 'none';
      toast?.('▦ Array: ' + made + ' copies created');
    };
  }

  // �����── Tool activation & events ──────────────────────────────────────────────
  const HINTS = {
    trim: '✂ TRIM: click the part of an object to cut away (Esc to exit)',
    extend: '⇢ EXTEND: click near the end of a line to extend to the next edge (Esc to exit)',
    fillet: '⌒ FILLET R{r}: pick two lines · [ ] adjusts radius (Esc to exit)',
    chamfer: '⟋ CHAMFER {r}: pick two lines · [ ] adjusts distance (Esc to exit)',
  };

  function activate(tool) {
    window.__draftCancelTool?.();
    window.__curvesCancel?.();
    MTOOL.active = tool;
    MTOOL.step = 0;
    MTOOL.first = null;
    const r = tool === 'fillet' ? MTOOL.radius : MTOOL.chamfer;
    toast?.(HINTS[tool].replace('{r}', r));
  }

  function cancel() {
    if (!MTOOL.active) return;
    MTOOL.active = null;
    MTOOL.step = 0;
    MTOOL.first = null;
    toast?.('Modify tool ended');
  }
  window.__modifyCancel = cancel;

  const vp = document.getElementById('viewport') || document.body;
  vp.addEventListener('pointerdown', e => {
    if (!MTOOL.active) return;
    if (e.button !== 0) return;
    const pk = pickAt({ x: e.clientX, y: e.clientY });
    if (MTOOL.active === 'trim') {
      if (!pk) { toast?.('TRIM: click on an object'); return; }
      applyTrim(pk);
    } else if (MTOOL.active === 'extend') {
      if (!pk) { toast?.('EXTEND: click near the end of a line'); return; }
      applyExtend(pk);
    } else if (MTOOL.active === 'fillet' || MTOOL.active === 'chamfer') {
      if (!pk) { toast?.('Pick a line'); return; }
      if (MTOOL.step === 0) {
        MTOOL.first = pk;
        MTOOL.step = 1;
        toast?.('First line picked — now pick the second');
      } else {
        applyFilletChamfer(MTOOL.first, pk, MTOOL.active);
        MTOOL.step = 0;
        MTOOL.first = null;
      }
    }
  });

  document.addEventListener('keydown', e => {
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (e.key === 'Escape') { cancel(); return; }
    if (!MTOOL.active) return;
    if (e.key === '[' || e.key === ']') {
      const d = e.key === ']' ? 5 : -5;
      if (MTOOL.active === 'fillet') {
        MTOOL.radius = Math.max(0, MTOOL.radius + d);
        toast?.('Fillet radius: ' + MTOOL.radius);
      } else if (MTOOL.active === 'chamfer') {
        MTOOL.chamfer = Math.max(0, MTOOL.chamfer + d);
        toast?.('Chamfer distance: ' + MTOOL.chamfer);
      }
    }
  });

  // ─── RUN hooks ────────────────────────────────────────────────────────────
  function hookRUN() {
    if (!window.RUN) { setTimeout(hookRUN, 100); return; }
    window.RUN.trim = () => activate('trim');
    window.RUN.extend = () => activate('extend');
    window.RUN.fillet = () => activate('fillet');
    window.RUN.chamfer = () => activate('chamfer');
    window.RUN.explode = applyExplode;
    window.RUN.arrayPanel = openArrayPanel;
  }
  hookRUN();

  console.log('[Modify Engine v2] Trim · Extend · Fillet · Chamfer · Explode · Array loaded ✓');
})();

</script>
<script>
// =============================================================================
// ULTIMATE CANVAS — Curves Engine v1
// SPLINE · XLINE · MLINE · DONUT · POINT
// Original implementation: spline interpolation through fit
// points), Draft construction-line pattern, DXF mline double-line offsets.
// =============================================================================
(function curvesEngine() {
  if (window.__curvesEngineV1) return;
  window.__curvesEngineV1 = true;

  const sw = (wx, wy) => ({ x: wx * view.z + view.x, y: wy * view.z + view.y });
  const tw = (cx, cy) => typeof toWorld === 'function'
    ? toWorld(cx, cy)
    : { x: (cx - view.x) / view.z, y: (cy - view.y) / view.z };
  const nid = () => '_wire_' + (Math.random() * 1e9 | 0);
  const XL_EXT = 100000; // construction-line half-extent (world units)

  const CTOOL = {
    active: null,        // 'spline' | 'xline' | 'mline' | 'donut' | 'point' | null
    points: [],          // collected fit/base points (world)
    mlineWidth: 20,      // [ ] adjusts
    donutOut: 20,        // outer radius, [ ] adjusts (inner = 0.4 × outer)
    cursor: null,
  };
  window.__curvesActiveTool = () => CTOOL.active;

  // ─── Preview overlay ────────────────────────────────────────────────────
  const pv = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  pv.id = 'curves-preview-overlay';
  // Mount inside #viewport so overflow:hidden clips lines to the canvas area
  Object.assign(pv.style, {
    position: 'absolute', inset: '0', width: '100%', height: '100%',
    pointerEvents: 'none', zIndex: '2147482997', overflow: 'visible',
  });
  (document.getElementById('viewport') || document.body).appendChild(pv);

  function mkEl(tag, attrs) {
    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    return el;
  }
  function clearPreview() { pv.innerHTML = ''; }

  function layerProps() {
    const layer = state.layers?.find(l => l.id === state.activeLayer);
    return { color: layer?.color || '#5E9FE8', lineWidth: layer?.lineWeight || 1.5 };
  }

  function commit(points, type, closed, extra) {
    const lp = layerProps();
    const w = Object.assign({
      id: nid(), type,
      points: points.map(p => ({ x: p.x, y: p.y })),
      closed: !!closed,
      color: lp.color, lineWidth: lp.lineWidth, lineStyle: 'solid',
      layerId: state.activeLayer || 'layer-0', selected: false,
    }, extra || {});
    state.wires.push(w);
    save?.();
    window.__draftRenderWires?.();
    return w;
  }

  function commitCircleAt(c, radius, extra) {
    const lp = layerProps();
    const w = Object.assign({
      id: nid(), type: 'circle', points: [], closed: true,
      cx: c.x, cy: c.y, radius,
      color: lp.color, lineWidth: lp.lineWidth, lineStyle: 'solid',
      layerId: state.activeLayer || 'layer-0', selected: false,
    }, extra || {});
    state.wires.push(w);
    save?.();
    window.__draftRenderWires?.();
    return w;
  }

  // ─── Spline: interpolation THROUGH fit points ──────────────────────────────
  // Catmull-Rom interpolation: the curve passes
  // exactly through every clicked point (Catmull-Rom, sampled to a polyline).
  function splineThrough(fit, samples = 12) {
    if (fit.length < 3) return fit.map(p => ({ x: p.x, y: p.y }));
    const P = [fit[0], ...fit, fit[fit.length - 1]];
    const out = [];
    for (let i = 1; i < P.length - 2; i++) {
      const p0 = P[i - 1], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2];
      for (let j = 0; j < samples; j++) {
        const t = j / samples, t2 = t * t, t3 = t2 * t;
        out.push({
          x: 0.5 * ((2 * p1.x) + (-p0.x + p2.x) * t + (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 + (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
          y: 0.5 * ((2 * p1.y) + (-p0.y + p2.y) * t + (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 + (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3),
        });
      }
    }
    out.push({ x: fit[fit.length - 1].x, y: fit[fit.length - 1].y });
    return out;
  }

  // ─── MLine: parallel offset polylines with mitered joints ────────────────────
  function lineInt(p1, p2, p3, p4) {
    const d1x = p2.x - p1.x, d1y = p2.y - p1.y;
    const d2x = p4.x - p3.x, d2y = p4.y - p3.y;
    const den = d1x * d2y - d1y * d2x;
    if (Math.abs(den) < 1e-9) return null;
    const t = ((p3.x - p1.x) * d2y - (p3.y - p1.y) * d2x) / den;
    return { x: p1.x + t * d1x, y: p1.y + t * d1y };
  }

  function offsetPolyline(pts, d) {
    const n = pts.length;
    if (n < 2) return pts.map(p => ({ x: p.x, y: p.y }));
    const segs = [];
    for (let i = 0; i < n - 1; i++) {
      const dx = pts[i + 1].x - pts[i].x, dy = pts[i + 1].y - pts[i].y;
      const l = Math.hypot(dx, dy) || 1;
      const nx = -dy / l * d, ny = dx / l * d;
      segs.push({ a: { x: pts[i].x + nx, y: pts[i].y + ny }, b: { x: pts[i + 1].x + nx, y: pts[i + 1].y + ny } });
    }
    const out = [segs[0].a];
    for (let i = 0; i < segs.length - 1; i++) {
      out.push(lineInt(segs[i].a, segs[i].b, segs[i + 1].a, segs[i + 1].b) || segs[i].b);
    }
    out.push(segs[segs.length - 1].b);
    return out;
  }

  // ─── XLine helper: infinite construction line through two points ──────────────
  function xlinePoints(base, thru) {
    const dx = thru.x - base.x, dy = thru.y - base.y;
    const l = Math.hypot(dx, dy) || 1;
    const u = { x: dx / l, y: dy / l };
    return [
      { x: base.x - u.x * XL_EXT, y: base.y - u.y * XL_EXT },
      { x: base.x + u.x * XL_EXT, y: base.y + u.y * XL_EXT },
    ];
  }

  // ─── Tool lifecycle ─────────────────────────────────────────────────────────
  const HINTS = {
    spline: '∿ SPLINE: click fit points · Enter to finish · U undo · Esc cancel',
    xline: '┄ XLINE: click base point, then direction points · Esc to exit',
    mline: '═ MLINE W{w}: click vertices · Enter to finish · [ ] width · Esc cancel',
    donut: '◎ DONUT ⌀{d}: click centers · [ ] size · Esc to exit',
    point: '· POINT: click to place points · Esc to exit',
  };

  function hint(tool) {
    let h = HINTS[tool] || '';
    h = h.replace('{w}', CTOOL.mlineWidth).replace('{d}', CTOOL.donutOut * 2);
    toast?.(h);
  }

  function activate(tool) {
    window.__draftCancelTool?.();
    window.__modifyCancel?.();
    CTOOL.active = tool;
    CTOOL.points = [];
    CTOOL.cursor = null;
    clearPreview();
    hint(tool);
  }

  function cancel() {
    CTOOL.active = null;
    CTOOL.points = [];
    CTOOL.cursor = null;
    clearPreview();
  }
  window.__curvesCancel = cancel;

  function finish() {
    const t = CTOOL.active, pts = CTOOL.points;
    if (t === 'spline' && pts.length >= 2) {
      commit(splineThrough(pts), 'wire', false, { kind: 'spline', fit: pts.map(p => ({ x: p.x, y: p.y })) });
      toast?.('∿ Spline through ' + pts.length + ' points');
    } else if (t === 'mline' && pts.length >= 2) {
      const half = CTOOL.mlineWidth / 2;
      const pairId = 'ml' + (Math.random() * 1e9 | 0);
      commit(offsetPolyline(pts, half), pts.length > 2 ? 'wire' : 'line', false, { kind: 'mline', pairId });
      commit(offsetPolyline(pts, -half), pts.length > 2 ? 'wire' : 'line', false, { kind: 'mline', pairId });
      toast?.('═ Multiline (width ' + CTOOL.mlineWidth + ')');
    }
    CTOOL.points = [];
    clearPreview();
  }

  // ─── Preview drawing ──────────────────────────────────────────────────────
  function pathFrom(worldPts, dashed) {
    if (worldPts.length < 2) return null;
    const d = worldPts.map((p, i) => {
      const s = sw(p.x, p.y);
      return (i === 0 ? 'M' : 'L') + s.x.toFixed(1) + ' ' + s.y.toFixed(1);
    }).join(' ');
    return mkEl('path', {
      d, fill: 'none', stroke: '#8AB8F0', 'stroke-width': '1.2',
      'stroke-dasharray': dashed ? '6 4' : 'none', opacity: '0.9',
    });
  }

  function drawPreview() {
    clearPreview();
    const t = CTOOL.active, c = CTOOL.cursor;
    if (!t || !c) return;
    if (t === 'spline' && CTOOL.points.length) {
      const el = pathFrom(splineThrough([...CTOOL.points, c]), false);
      if (el) pv.appendChild(el);
    } else if (t === 'xline' && CTOOL.points.length) {
      const el = pathFrom(xlinePoints(CTOOL.points[0], c), true);
      if (el) pv.appendChild(el);
    } else if (t === 'mline' && CTOOL.points.length) {
      const half = CTOOL.mlineWidth / 2, all = [...CTOOL.points, c];
      const e1 = pathFrom(offsetPolyline(all, half), false);
      const e2 = pathFrom(offsetPolyline(all, -half), false);
      if (e1) pv.appendChild(e1);
      if (e2) pv.appendChild(e2);
    } else if (t === 'donut') {
      const s = sw(c.x, c.y);
      for (const r of [CTOOL.donutOut, CTOOL.donutOut * 0.4]) {
        pv.appendChild(mkEl('circle', {
          cx: s.x, cy: s.y, r: r * view.z, fill: 'none',
          stroke: '#8AB8F0', 'stroke-width': '1.2', 'stroke-dasharray': '6 4',
        }));
      }
    } else if (t === 'point') {
      const s = sw(c.x, c.y);
      pv.appendChild(mkEl('path', {
        d: 'M' + (s.x - 6) + ' ' + s.y + ' H' + (s.x + 6) + ' M' + s.x + ' ' + (s.y - 6) + ' V' + (s.y + 6),
        stroke: '#8AB8F0', 'stroke-width': '1.2', fill: 'none',
      }));
    }
  }

  // ─── Events ─────────────────────────────────────────────────────────────────
  function hookVp() {
    const vp = document.getElementById('viewport');
    if (!vp) { setTimeout(hookVp, 300); return; }

    vp.addEventListener('pointerdown', e => {
      if (!CTOOL.active || e.button !== 0) return;
      const wp = window.__cadSnapCurrent || tw(e.clientX, e.clientY);
      const p = { x: wp.x, y: wp.y };
      const t = CTOOL.active;
      if (t === 'spline' || t === 'mline') {
        CTOOL.points.push(p);
      } else if (t === 'xline') {
        if (CTOOL.points.length === 0) {
          CTOOL.points = [p];
          toast?.('┄ XLINE: click a direction point');
        } else {
          const base = CTOOL.points[0];
          if (Math.hypot(p.x - base.x, p.y - base.y) > 0.5) {
            commit(xlinePoints(base, p), 'line', false, { kind: 'xline' });
            toast?.('┄ Construction line added (Esc to exit)');
          }
        }
      } else if (t === 'donut') {
        const pairId = 'dn' + (Math.random() * 1e9 | 0);
        commitCircleAt(p, CTOOL.donutOut, { kind: 'donut', pairId });
        commitCircleAt(p, CTOOL.donutOut * 0.4, { kind: 'donut', pairId });
        toast?.('◎ Donut ⌀' + (CTOOL.donutOut * 2));
      } else if (t === 'point') {
        commitCircleAt(p, 2.5, { kind: 'point' });
      }
      drawPreview();
    });

    vp.addEventListener('pointermove', e => {
      if (!CTOOL.active) return;
      const wp = window.__cadSnapCurrent || tw(e.clientX, e.clientY);
      CTOOL.cursor = { x: wp.x, y: wp.y };
      drawPreview();
    });
  }
  hookVp();

  document.addEventListener('keydown', e => {
    if (!CTOOL.active) return;
    const tag = (e.target && e.target.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target?.isContentEditable) return;
    if (e.key === 'Escape') { cancel(); toast?.('Cancelled'); return; }
    if (e.key === 'Enter') { e.preventDefault(); finish(); return; }
    if ((e.key === 'u' || e.key === 'U' || e.key === 'Backspace') && CTOOL.points.length) {
      e.preventDefault();
      CTOOL.points.pop();
      drawPreview();
      return;
    }
    if (e.key === '[' || e.key === ']') {
      const d = e.key === ']' ? 5 : -5;
      if (CTOOL.active === 'mline') {
        CTOOL.mlineWidth = Math.max(5, CTOOL.mlineWidth + d);
        toast?.('═ MLINE width: ' + CTOOL.mlineWidth);
      } else if (CTOOL.active === 'donut') {
        CTOOL.donutOut = Math.max(5, CTOOL.donutOut + d);
        toast?.('◎ DONUT ⌀' + (CTOOL.donutOut * 2));
      }
      drawPreview();
    }
  });

  // ─── Command registration ─────────────────────────────────────────────������──
  function hookRUN() {
    if (!window.RUN) { setTimeout(hookRUN, 300); return; }
    window.RUN.spline = () => activate('spline');
    window.RUN.xline = () => activate('xline');
    window.RUN.mline = () => activate('mline');
    window.RUN.donut = () => activate('donut');
    window.RUN.pointTool = () => activate('point');
  }
  hookRUN();
})();

</script>
<script>
// =============================================================================
// ULTIMATE CANVAS — Annotation Engine v1
// DIMLINEAR · DIMALIGNED · DIMRADIUS · DIMDIAMETER · DIMANGULAR · LEADER · HATCH
// Original implementations of linear/aligned/radius/diameter/angular
// dimensions, leader/balloon callouts, and hatch fill.
// =============================================================================
(function annotationEngine() {
  if (window.__annotationEngineV1) return;
  window.__annotationEngineV1 = true;

  // ─── Coord helpers ───────────────────────────────────────────────────────────
  const sw = (wx, wy) => ({ x: wx * view.z + view.x, y: wy * view.z + view.y });
  const tw = (cx, cy) => typeof toWorld === 'function'
    ? toWorld(cx, cy)
    : { x: (cx - view.x) / view.z, y: (cy - view.y) / view.z };
  const dist = (a, b) => Math.hypot(b.x - a.x, b.y - a.y);
  const mid  = (a, b) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });
  const norm = (dx, dy) => { const l = Math.hypot(dx, dy) || 1; return { x: dx/l, y: dy/l }; };
  const perp = (u) => ({ x: -u.y, y: u.x });
  const nid  = () => '_ann_' + (Math.random() * 1e9 | 0);

  // ─── State ───────────────────────────────────────────────────────────────────
  if (!state.annotations) state.annotations = [];

  const ATOOL = {
    active: null, // 'linear'|'aligned'|'radius'|'diameter'|'angular'|'balloon'|'hatch'
    step: 0,
    pts: [],      // collected world points
    pickWire: null,
    balloonText: '1',
    cursor: null,
  };
  window.__annotActiveTool = () => ATOOL.active;

  // ─── Overlay SVG ─────────────────────────────────────────────────────────────
  const ov = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  ov.id = 'annotation-overlay';
  Object.assign(ov.style, {
    position: 'absolute', inset: '0', width: '100%', height: '100%',
    pointerEvents: 'none', zIndex: '2147482996', overflow: 'visible',
  });

  function mountOverlay() {
    const vp = document.getElementById('viewport');
    if (vp) vp.appendChild(ov);
    else { setTimeout(mountOverlay, 300); }
  }
  mountOverlay();

  // ─── SVG helpers ─────────────────────────────────────────────────────────────
  const NS = 'http://www.w3.org/2000/svg';
  function el(tag, attrs) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
    return e;
  }

  // ─── Text size estimation (rough, for layout) ────────────────────────────────
  const FONT_SIZE = 11; // screen px
  function textW(str) { return str.length * FONT_SIZE * 0.6; }

  // ─── Arrow (filled triangle, 8×4 screen px) ──────────────────────────────────
  function arrowPath(tip, dir, color) {
    // dir is a unit vector pointing TOWARD tip
    const BASE = 8 * view.z, HALF = 3 * view.z;
    const s = sw(tip.x, tip.y);
    const sx = dir.x, sy = dir.y;
    const px = -sy, py = sx;
    const pts = [
      `${s.x},${s.y}`,
      `${s.x - sx*BASE + px*HALF},${s.y - sy*BASE + py*HALF}`,
      `${s.x - sx*BASE - px*HALF},${s.y - sy*BASE - py*HALF}`,
    ].join(' ');
    return el('polygon', { points: pts, fill: color, stroke: 'none' });
  }

  // ─── Dim line label ──────────────────────────────────────────────────────────
  function dimLabel(worldPt, textStr, color, rotate) {
    const s = sw(worldPt.x, worldPt.y);
    const t = el('text', {
      x: s.x, y: s.y,
      fill: color, 'font-size': FONT_SIZE, 'font-family': 'monospace',
      'text-anchor': 'middle', 'dominant-baseline': 'middle',
      transform: rotate ? `rotate(${rotate},${s.x},${s.y})` : '',
    });
    t.textContent = textStr;
    return t;
  }

  // ─── Render one annotation to the overlay ────────────────────────────────────
  function renderAnnotation(a, g, preview) {
    const col = preview ? '#8AB8F0' : (a.color || '#E8B85E');
    const lw  = preview ? '1' : '1.3';
    const da  = preview ? '6 3' : 'none';

    function L(p1, p2) {
      const s1 = sw(p1.x, p1.y), s2 = sw(p2.x, p2.y);
      return el('line', { x1: s1.x, y1: s1.y, x2: s2.x, y2: s2.y,
        stroke: col, 'stroke-width': lw, 'stroke-dasharray': da });
    }

    if (a.type === 'linear' || a.type === 'aligned') {
      const { p1, p2, offset } = a; // offset in world units, perpendicular to dim dir
      const u = a.type === 'linear'
        ? { x: 1, y: 0 }  // horizontal measurement, ext lines vertical
        : norm(p2.x - p1.x, p2.y - p1.y);
      const pv = perp(u);
      // dim line points
      const d1 = { x: p1.x + pv.x * offset, y: p1.y + pv.y * offset };
      const d2 = { x: p2.x + pv.x * offset, y: p2.y + pv.y * offset };
      // extension lines
      const EXT = 4; // small gap from measurement point
      const ext1a = { x: p1.x + pv.x * EXT, y: p1.y + pv.y * EXT };
      const ext2a = { x: p2.x + pv.x * EXT, y: p2.y + pv.y * EXT };
      const ext1b = { x: d1.x + pv.x * 4,   y: d1.y + pv.y * 4 };
      const ext2b = { x: d2.x + pv.x * 4,   y: d2.y + pv.y * 4 };

      g.appendChild(L(ext1a, ext1b));
      g.appendChild(L(ext2a, ext2b));
      g.appendChild(L(d1, d2));
      g.appendChild(arrowPath(d1, norm(d2.x - d1.x, d2.y - d1.y), col));
      g.appendChild(arrowPath(d2, norm(d1.x - d2.x, d1.y - d2.y), col));

      const measDist = a.type === 'linear'
        ? Math.abs(p2.x - p1.x)
        : dist(p1, p2);
      const textPt = mid(d1, d2);
      const angle = a.type === 'aligned'
        ? Math.atan2(p2.y - p1.y, p2.x - p1.x) * 180 / Math.PI
        : 0;
      const label = measDist.toFixed(1);
      // white bg rectangle behind text
      const tw2 = textW(label) / 2, th = FONT_SIZE * 0.7;
      const ts = sw(textPt.x, textPt.y);
      const bg = el('rect', {
        x: ts.x - tw2 - 2, y: ts.y - th - 1, width: tw2*2 + 4, height: th*2 + 2,
        fill: '#1e1e1e', stroke: 'none',
        transform: angle ? `rotate(${angle},${ts.x},${ts.y})` : '',
      });
      g.appendChild(bg);
      g.appendChild(dimLabel(textPt, label, col, angle || null));

    } else if (a.type === 'radius' || a.type === 'diameter') {
      const w = state.wires.find(w => w.id === a.wireId);
      if (!w) return;
      const cx = w.cx, cy = w.cy, r = w.radius;
      const ang = (a.angle || 0) * Math.PI / 180;
      const u2 = { x: Math.cos(ang), y: Math.sin(ang) };
      if (a.type === 'radius') {
        const tip = { x: cx + u2.x * r, y: cy + u2.y * r };
        g.appendChild(L({ x: cx, y: cy }, tip));
        g.appendChild(arrowPath(tip, u2, col));
        const textPt = { x: cx + u2.x * r * 0.55, y: cy + u2.y * r * 0.55 };
        g.appendChild(dimLabel(textPt, 'R' + r.toFixed(1), col, null));
      } else {
        const tip1 = { x: cx + u2.x * r, y: cy + u2.y * r };
        const tip2 = { x: cx - u2.x * r, y: cy - u2.y * r };
        g.appendChild(L(tip2, tip1));
        g.appendChild(arrowPath(tip1, u2, col));
        g.appendChild(arrowPath(tip2, { x: -u2.x, y: -u2.y }, col));
        g.appendChild(dimLabel({ x: cx + u2.x * 6, y: cy + u2.y * 6 },
          '⌀' + (r * 2).toFixed(1), col, null));
      }

    } else if (a.type === 'angular') {
      const { vertex, p1, p2, arcR } = a; // p1,p2 are points on each leg
      const u1 = norm(p1.x - vertex.x, p1.y - vertex.y);
      const u2 = norm(p2.x - vertex.x, p2.y - vertex.y);
      const ang1 = Math.atan2(u1.y, u1.x);
      const ang2 = Math.atan2(u2.y, u2.x);
      // extension lines from vertex to arcR
      const ep1 = { x: vertex.x + u1.x * arcR, y: vertex.y + u1.y * arcR };
      const ep2 = { x: vertex.x + u2.x * arcR, y: vertex.y + u2.y * arcR };
      g.appendChild(L(vertex, ep1));
      g.appendChild(L(vertex, ep2));
      // arc
      const STEPS = 20;
      let a1 = ang1, a2 = ang2;
      // keep arc <= 180°
      let delta = a2 - a1;
      if (delta > Math.PI) delta -= 2*Math.PI;
      if (delta < -Math.PI) delta += 2*Math.PI;
      const pts = [];
      for (let i = 0; i <= STEPS; i++) {
        const t = a1 + (delta * i / STEPS);
        const sc = sw(vertex.x + Math.cos(t) * arcR, vertex.y + Math.sin(t) * arcR);
        pts.push(`${i === 0 ? 'M' : 'L'}${sc.x.toFixed(1)},${sc.y.toFixed(1)}`);
      }
      g.appendChild(el('path', { d: pts.join(' '), fill: 'none', stroke: col, 'stroke-width': lw, 'stroke-dasharray': da }));
      // text at mid arc
      const midAng = a1 + delta / 2;
      const textPt = { x: vertex.x + Math.cos(midAng) * (arcR * 1.2), y: vertex.y + Math.sin(midAng) * (arcR * 1.2) };
      const degrees = Math.abs(delta * 180 / Math.PI).toFixed(1) + '°';
      g.appendChild(dimLabel(textPt, degrees, col, null));

    } else if (a.type === 'balloon') {
      const { origin, center, text } = a;
      const sr = sw(center.x, center.y);
      const BUBBLE_R = Math.max(12, textW(text) / 2 + 4); // screen px
      // leader line from origin to bubble edge
      const u3 = norm(center.x - origin.x, center.y - origin.y);
      const edgePt = { x: center.x - u3.x * (BUBBLE_R / view.z), y: center.y - u3.y * (BUBBLE_R / view.z) };
      g.appendChild(L(origin, edgePt));
      g.appendChild(arrowPath(origin, u3, col));
      g.appendChild(el('circle', {
        cx: sr.x, cy: sr.y, r: BUBBLE_R,
        fill: 'rgba(30,30,30,0.85)', stroke: col, 'stroke-width': lw
      }));
      const t = el('text', {
        x: sr.x, y: sr.y,
        fill: col, 'font-size': FONT_SIZE, 'font-family': 'monospace',
        'text-anchor': 'middle', 'dominant-baseline': 'middle',
      });
      t.textContent = text;
      g.appendChild(t);

    } else if (a.type === 'hatch') {
      const { wireId, angle, spacing } = a;
      const w = state.wires.find(w => w.id === wireId);
      if (!w || (!w.closed && w.type !== 'rect')) return;
      // build screen polygon
      let screenPts = [];
      if (w.type === 'circle') return; // skip circles
      if (w.type === 'rect') {
        const [p1, p2] = w.points;
        const [mnx, mxx] = [Math.min(p1.x,p2.x), Math.max(p1.x,p2.x)];
        const [mny, mxy] = [Math.min(p1.y,p2.y), Math.max(p1.y,p2.y)];
        screenPts = [[mnx,mny],[mxx,mny],[mxx,mxy],[mnx,mxy]].map(([x,y]) => { const s=sw(x,y); return `${s.x},${s.y}`; });
      } else {
        screenPts = w.points.map(p => { const s=sw(p.x,p.y); return `${s.x},${s.y}`; });
      }
      const pstr = screenPts.join(' ');
      const patId = 'hpat_' + a.id;
      const sp = (spacing || 12) * view.z;
      const angR = ((angle || 45) * Math.PI) / 180;
      const cos = Math.cos(angR), sin = Math.sin(angR);
      const defs = el('defs', {});
      const pat = el('pattern', { id: patId, width: sp, height: sp, patternUnits: 'userSpaceOnUse',
        patternTransform: `rotate(${angle || 45})` });
      pat.appendChild(el('line', { x1: 0, y1: 0, x2: 0, y2: sp,
        stroke: col, 'stroke-width': '0.6', opacity: '0.7' }));
      defs.appendChild(pat);
      g.appendChild(defs);
      // clip region
      const clipId = 'hclip_' + a.id;
      const clipDefs = el('defs', {});
      const cp = el('clipPath', { id: clipId });
      cp.appendChild(el('polygon', { points: pstr }));
      clipDefs.appendChild(cp);
      g.appendChild(clipDefs);
      // outline
      g.appendChild(el('polygon', { points: pstr, fill: `url(#${patId})`, stroke: col,
        'stroke-width': lw, 'clip-path': `url(#${clipId})` }));
    }
  }

  // ─── Full redraw ─────────────────────────────────────────────────────────────
  function renderAll() {
    ov.innerHTML = '';
    if (!state.annotations) return;
    for (const a of state.annotations) {
      const g = el('g', { 'data-ann-id': a.id });
      renderAnnotation(a, g, false);
      ov.appendChild(g);
    }
  }
  window.__annotRenderAll = renderAll;

  // Hook into the main renderAll
  const _origRender = window.renderAll;
  window.renderAll = function() {
    _origRender && _origRender();
    renderAll();
  };

  // ─── Preview ─────────────────────────────────────────────────────────────────
  let prevG = null;
  function clearPreview() { if (prevG) { prevG.remove(); prevG = null; } }
  function drawPreview() {
    clearPreview();
    if (!ATOOL.active || !ATOOL.cursor) return;
    const c = ATOOL.cursor, t = ATOOL.active;
    let fake = null;
    if ((t === 'linear' || t === 'aligned') && ATOOL.pts.length >= 2) {
      const [p1, p2] = ATOOL.pts;
      const u = t === 'linear' ? { x: 1, y: 0 } : norm(p2.x - p1.x, p2.y - p1.y);
