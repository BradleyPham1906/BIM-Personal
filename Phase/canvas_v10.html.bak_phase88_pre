  --panel-muted:#666666;
  --panel-subtle:rgba(0,0,0,.045);
  --panel-hover:rgba(0,0,0,.07);
  --panel-input:#ffffff;
  --panel-input-2:#f4f4f4;
  --panel-shadow:0 18px 55px rgba(0,0,0,.18);
  --panel-blue:#0b84e5;
}
