        {a:'_snapCen',k:'snap_cen',tt:'Snap: Center',tog:true,bid:'fc-b-snap-cen'},
        {a:'_snapPer',k:'snap_per',tt:'Snap: Perpendicular',tog:true,bid:'fc-b-snap-per'},
        {a:'_snapInt',k:'snap_int',tt:'Snap: Intersection',tog:true,bid:'fc-b-snap-int'},
        {a:'_snapNea',k:'snap_nea',tt:'Snap: Nearest',tog:true,bid:'fc-b-snap-nea'},
        '|',
        {a:'_gridToggle',k:'gridsnap',tt:'Grid Snap',tog:true,bid:'fc-b-gridsnap'},
        '|',
        {a:'_orthoToggle',k:'ortho',tt:'Ortho Mode (F8)',tog:true,bid:'fc-b-ortho'},
        {a:'polarToggle',k:'polar',tt:'Polar Tracking (F10)',tog:true,bid:'fc-b-polar'},
        {a:'_workplane',k:'workplane',tt:'Working Plane (Global)',tog:true,bid:'fc-b-wp'},
      ]
    },
    { row:3, id:'fc-tb-util', label:'Utility',
      btns:[
        {a:'measure',k:'measure',tt:'Measure Object'},
        {a:'cmd',k:'cmd',tt:'Command Line'},
        {a:'selAll',k:'sel',tt:'Select All (Ctrl+A)'},
        {a:'del',k:'del',tt:'Erase Selection (E)'},
      ]
    },
  ];

  // ── Build the shell ──
  const shell=document.createElement('div');
  shell.id='fc-shell';

  // Menu bar
  const mb=document.createElement('div');
  mb.id='fc-menubar';
  mb.innerHTML=`<div class="fc-logo" title="Ultimate Canvas">
    <svg viewBox="0 0 24 24" fill="none" stroke="#e8740c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="12,2 22,8.5 22,15.5 12,22 2,15.5 2,8.5"/>
      <polygon points="12,6 18,9.5 18,14.5 12,18 6,14.5 6,9.5" opacity="0.5"/>
    </svg>
  </div>`+
  MENUS.map(m=>`<div class="fc-menu" data-fcm="${m.n}"><button class="fc-mbtn">${m.n}</button><div class="fc-dd">${
    m.items.map(it=>it.l==='─'?'<div class="fc-dd-sep"></div>':`<button class="fc-dd-item" data-fca="${it.a}">${it.l}</button>`).join('')
  }</div></div>`).join('')+
  '';

  // Toolbar rows (4 rows)
  const rowEls=[0,1,2,3].map(i=>{
    const r=document.createElement('div');
    r.className='fc-tbrow';
    r.id=`fc-row-${i}`;
    return r;
  });

  BARS.forEach(bar=>{
    const tbEl=document.createElement('div');
    tbEl.className='fc-tbar';
    tbEl.id=bar.id;
    // grip handle
    const grip=document.createElement('div');
    grip.className='fc-grip';
    grip.title=bar.label;
    tbEl.appendChild(grip);
    // buttons
    bar.btns.forEach(b=>{
      if(b==='|'){
        const s=document.createElement('div');
        s.className='fc-sep';
        tbEl.appendChild(s);
        return;
      }
      const btn=document.createElement('button');
      btn.className='fc-btn'+(b.tog?' fc-tog':'');
      btn.title=b.tt;
      btn.innerHTML=ic(b.k);
      btn.dataset.fca=b.a;
      btn.dataset.cadrAct=b.a; // backward-compat alias
      if(b.bid)btn.id=b.bid;
      if(b.tid)btn.dataset.fctool=b.tid;
      tbEl.appendChild(btn);
    });
    rowEls[bar.row].appendChild(tbEl);
  });

  shell.appendChild(mb);
  rowEls.forEach(r=>shell.appendChild(r));
  document.body.insertBefore(shell,document.body.firstChild);
  document.body.classList.add('fc-on');

  // ── Snap sub-type state (which snap types are active) ──
  const snapTypes={end:true,mid:true,cen:true,per:true,int:false,nea:false,grid:true};
  const snapTypeMap={_snapEnd:'end',_snapMid:'mid',_snapCen:'cen',_snapPer:'per',_snapInt:'int',_snapNea:'nea',_gridToggle:'grid'};

  function runAct(act){
    if(act==='_orthoToggle'){document.body.classList.toggle('fc-ortho');updateStates();return;}
    if(act==='_workplane'){document.body.classList.toggle('fc-globalwp');updateStates();return;}
    if(snapTypeMap[act]){
      const k=snapTypeMap[act];
      snapTypes[k]=!snapTypes[k];
      // expose to snap engine
      if(window.__cadSnapTypes)window.__cadSnapTypes[k]=snapTypes[k];
      updateStates();
      return;
    }
    try{
      if(window.RUN?.[act])window.RUN[act]();
      else if(typeof window.cadRun==='function')window.cadRun(act);
    }catch(e){}
    // small delay for tool state to settle
    setTimeout(updateStates,60);
  }

  // ── Click handler ──
  shell.addEventListener('click',e=>{
    // Toolbar button
    const btn=e.target.closest('[data-fca]');
    if(btn&&!btn.classList.contains('fc-mbtn')){
      runAct(btn.dataset.fca);
      return;
    }
    // Menu bar button
    const mbtn=e.target.closest('.fc-mbtn');
    if(mbtn){
      const menu=mbtn.closest('.fc-menu');
      const wasOpen=menu.classList.contains('open');
      mb.querySelectorAll('.fc-menu.open').forEach(m=>m.classList.remove('open'));
      if(!wasOpen)menu.classList.add('open');
      return;
    }
    // Dropdown item
    const ddi=e.target.closest('.fc-dd-item');
    if(ddi){
      mb.querySelectorAll('.fc-menu.open').forEach(m=>m.classList.remove('open'));
      runAct(ddi.dataset.fca);
      return;
    }
  });

  document.addEventListener('pointerdown',e=>{
    if(!e.target.closest('#fc-shell')){
      mb.querySelectorAll('.fc-menu.open').forEach(m=>m.classList.remove('open'));
    }
  },true);

  // ── Active state updates ──
  function updateStates(){
    // Active drawing tool from CAD engine
    const tool=window.__draftActiveTool?.()||
                window.__cadActiveTool||
                window.__currentDraftTool||'';
    shell.querySelectorAll('[data-fctool]').forEach(b=>{
      b.classList.toggle('active',b.dataset.fctool===tool);
    });
    // Snap lock
    const snapOn=window.__cadSnapCurrentState!==false&&window.__cadSnapOn!==false;
    const sb=document.getElementById('fc-b-snap');
    if(sb)sb.classList.toggle('active',snapOn);
    // Snap types
    Object.entries({end:'fc-b-snap-end',mid:'fc-b-snap-mid',cen:'fc-b-snap-cen',
                    per:'fc-b-snap-per',int:'fc-b-snap-int',nea:'fc-b-snap-nea',
                    grid:'fc-b-gridsnap'}).forEach(([k,id])=>{
      const b2=document.getElementById(id);
      if(b2)b2.classList.toggle('active',!!snapTypes[k]);
    });
    // Polar
    const polarOn=!!window.__polarTrackingOn||!!window.__cadPolarOn;
    const pb=document.getElementById('fc-b-polar');
    if(pb)pb.classList.toggle('active',polarOn);
    // Ortho
    const ob=document.getElementById('fc-b-ortho');
    if(ob)ob.classList.toggle('active',document.body.classList.contains('fc-ortho'));
    // Working plane
    const wb2=document.getElementById('fc-b-wp');
    if(wb2)wb2.classList.toggle('active',document.body.classList.contains('fc-globalwp'));
    // Grid
    const gb=document.getElementById('fc-b-grid');
    if(gb){
      const gridOn=!document.body.classList.contains('grid-off');
      gb.classList.toggle('active',gridOn);
    }
  }

  // Initial states: snap types all on
  ['fc-b-snap-end','fc-b-snap-mid','fc-b-snap-cen','fc-b-snap-per','fc-b-gridsnap'].forEach(id=>{
    const b=document.getElementById(id);
    if(b)b.classList.add('active');
  });

  setInterval(updateStates,600);
  setTimeout(updateStates,800);
  window.__topbarUIUpdate=updateStates;
})();

// Compat: ensure window.RUN.poly -> wire, and add bimSnap alias for test compat
(function fixRUNAliases(){
  function patch(){
    if(!window.RUN||!window.RUN.draftWire){setTimeout(patch,100);return;}
    if(!window.RUN.poly) window.RUN.poly = window.RUN.draftWire;
    // bimSnap compat — add hidden button for test selectors
    if(!document.getElementById('fc-compat-bimsnap')){
      var b=document.createElement('button');
      b.id='fc-compat-bimsnap';
      b.setAttribute('data-cadr-act','bimSnap');
      b.style.cssText='position:fixed;left:-9999px;top:-9999px;pointer-events:none;opacity:0';
      document.body.appendChild(b);
    }
  }
  setTimeout(patch,200);
})();

</script>
