  function makePalette(){
    if($('#uploaded-command-palette'))return;
    const pal=document.createElement('div'); pal.id='uploaded-command-palette';
    pal.innerHTML='<div class="uc-input"><span>⌘</span><input placeholder="Search commands…" aria-label="Search commands"></div><div class="uc-results"></div>';
    document.body.appendChild(pal);
    const input=pal.querySelector('input');
    function draw(){const q=input.value.toLowerCase().trim(); const rows=commands.filter(c=>!q||c.label.toLowerCase().includes(q)); pal.querySelector('.uc-results').innerHTML=rows.map((c,i)=>`<div class="uc-row ${i===0?'active':''}" data-label="${c.label}"><span>${c.label}</span><span class="uc-key">${c.key||'Enter'}</span></div>`).join('')||'<div class="uc-row">No commands</div>';}
