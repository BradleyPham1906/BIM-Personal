    b.classList.toggle('crossing',marq.dir==='crossing');
    b.style.left=Math.min(marq.sx,e.clientX)+'px';
    b.style.top=Math.min(marq.sy,e.clientY)+'px';
    b.style.width=Math.abs(dx)+'px';
    b.style.height=Math.abs(dy)+'px';
    marq.ex=e.clientX; marq.ey=e.clientY;
  },true);
