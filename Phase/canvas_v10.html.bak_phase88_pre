<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Enhanced Obsidian Canvas</title>
<style>
  :root{
    --bg:#191919; --grid:#2d2d2b; --surface:#202020; --raised:#2b2b29; --hover:#383836;
    --border:rgba(255,255,255,.16); --text:#ffffff; --muted:rgba(255,255,255,.64);
    --accent:#8f7aff; --blue:#5E9FE8; --green:#72BC8F; --orange:#DE9255; --red:#E97366;
    --shadow:0 1px 2px rgba(0,0,0,.25),0 10px 35px rgba(0,0,0,.28);
  }
  *{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden}
  body{background:var(--bg);color:var(--text);font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  button,input,textarea,select{font:inherit}
  #viewport{position:fixed;inset:0;overflow:hidden;touch-action:none;background-image:radial-gradient(circle,var(--grid) 1px,transparent 1px);background-size:24px 24px}
  #viewport.pan-tool{cursor:grab} #viewport.panning{cursor:grabbing}
  #world{position:absolute;left:0;top:0;transform-origin:0 0}
  #edges{position:absolute;left:0;top:0;width:10px;height:10px;overflow:visible;z-index:1}
  #edges path.edge{fill:none;stroke:var(--muted);stroke-width:2.2;cursor:pointer;filter:drop-shadow(0 2px 2px rgba(0,0,0,.25))}
  #edges path.edge.selected{stroke:var(--accent);stroke-width:3.2}
  #edges path.hit{fill:none;stroke:transparent;stroke-width:18;pointer-events:stroke;cursor:pointer}
  #edges text{font-size:13px;fill:var(--text);paint-order:stroke;stroke:#111;stroke-width:5;user-select:none;cursor:pointer}

  .node{position:absolute;z-index:3;border:2px solid var(--bc,var(--border));border-radius:12px;background:var(--nbg,#242424);box-shadow:0 1px 0 rgba(255,255,255,.05) inset;user-select:none;overflow:visible}
  .node.selected{box-shadow:0 0 0 3px rgba(143,122,255,.75),0 1px 0 rgba(255,255,255,.05) inset}
  .node .titlebar{height:34px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:8px;padding:0 10px;color:var(--muted);cursor:move;background:rgba(255,255,255,.025);border-radius:10px 10px 0 0}
  .node .titlebar .dot{width:9px;height:9px;border-radius:50%;background:var(--bc,var(--accent));box-shadow:0 0 0 3px rgba(255,255,255,.04)}
  .node .titlebar .ntitle{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12.5px;letter-spacing:.01em}
  .node .content{position:absolute;left:0;right:0;top:34px;bottom:0;overflow:auto;padding:12px 16px;cursor:default}
  .node .content::-webkit-scrollbar{width:8px}.node .content::-webkit-scrollbar-thumb{background:#444;border-radius:4px}
  .node textarea{position:absolute;left:0;right:0;top:34px;bottom:0;width:100%;height:calc(100% - 34px);resize:none;border:0;outline:0;background:#1f1f1f;color:var(--text);font:14px/1.55 ui-monospace,Menlo,Consolas,monospace;padding:13px 16px;display:none;border-radius:0 0 10px 10px}
  .node.editing textarea{display:block}.node.editing .content{visibility:hidden}
  .node.group{z-index:2;background:rgba(255,255,255,.025);border-style:dashed;border-radius:18px}
  .node.group .titlebar{display:none}.node.group .content,.node.group textarea{display:none}
  .node.group .glabel{position:absolute;left:12px;top:-37px;background:var(--bc,#444);color:#fff;padding:5px 13px;border-radius:9px;font-weight:700;font-size:14px;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis;cursor:text;box-shadow:var(--shadow)}
  .node.group .glabel input{width:180px;background:transparent;border:0;outline:0;color:inherit;font:inherit}
  .node.image-card .content{padding:0;display:flex;flex-direction:column;overflow:hidden}
  .node.image-card img{width:100%;height:100%;object-fit:cover;display:block;flex:1;min-height:0;background:#111}
  .node.image-card .caption{padding:8px 12px;border-top:1px solid rgba(255,255,255,.1);color:var(--muted);font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:rgba(0,0,0,.18)}
  .node.image-card.contain img{object-fit:contain}
  .node.whiteboard-card .content{padding:8px;overflow:hidden;background:rgba(255,255,255,.02)}
  .node.whiteboard-card .draw-wrap{position:relative;width:100%;height:100%;border-radius:10px;background:#121214;border:1px dashed rgba(255,255,255,.12);overflow:hidden}
  .node.whiteboard-card canvas.draw-surface{display:block;width:100%;height:100%;touch-action:none;cursor:crosshair;background:linear-gradient(180deg,rgba(255,255,255,.01),rgba(255,255,255,.02))}
  .node.whiteboard-card .titlebar{cursor:move}
  .node.table-card .content{padding:10px;overflow:hidden;background:rgba(255,255,255,.02);display:flex;flex-direction:column;gap:8px}
  .node.table-card .table-toolbar,.node.chart-card .chart-toolbar{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
  .node.table-card .table-toolbar button,.node.chart-card .chart-toolbar button,.node.chart-card .chart-toolbar select{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);color:var(--text);border-radius:9px;padding:6px 10px;font-size:11px}
  .node.chart-card .chart-toolbar select{padding-right:24px}
  .node.table-card .table-grid{flex:1;min-height:0;overflow:auto;border:1px solid rgba(255,255,255,.08);border-radius:10px}
  .node.table-card table{width:100%;border-collapse:collapse;font-size:12.5px;min-width:100%}
  .node.table-card th,.node.table-card td{border:1px solid rgba(255,255,255,.09);padding:8px 10px;text-align:left;white-space:nowrap;min-width:92px}
  .node.table-card th{position:sticky;top:0;background:rgba(18,18,20,.98);z-index:1;font-weight:700}
  .node.table-card th[contenteditable],.node.table-card td[contenteditable]{outline:none;cursor:text}
  .node.table-card th[contenteditable]:focus,.node.table-card td[contenteditable]:focus{background:rgba(143,122,255,.14)}
  .node.table-card tr:nth-child(even) td{background:rgba(255,255,255,.025)}

  /* Canva-style interactive tables */
  .node.table-card .table-toolbar{gap:8px;align-items:center}
  .node.table-card .table-toolbar .table-status{margin-left:auto;color:var(--muted);font-size:11px;white-space:nowrap}
  .node.table-card .table-grid{background:#151516;position:relative;cursor:default}
  .node.table-card table.canvas-table{table-layout:fixed;border-collapse:separate;border-spacing:0;min-width:max-content;width:max-content}
  .node.table-card .row-handle,.node.table-card .corner-cell{position:sticky;left:0;z-index:3;background:#18181a!important;color:var(--muted);text-align:center;min-width:42px;width:42px;padding:0;border-right:1px solid rgba(255,255,255,.16);cursor:pointer;user-select:none}
  .node.table-card .corner-cell{top:0;z-index:5;height:34px;font-size:13px}
  .node.table-card thead th.data-head{top:0;z-index:4;height:34px;background:#1b1b1d;position:sticky;overflow:hidden;text-overflow:ellipsis}
  .node.table-card tbody .row-handle{font-size:11px;font-weight:800}
  .node.table-card th,.node.table-card td{height:34px;position:relative;transition:background .12s,border-color .12s;vertical-align:middle}
  .node.table-card td{background:rgba(255,255,255,.01)}
  .node.table-card td:hover,.node.table-card th.data-head:hover,.node.table-card .row-handle:hover{background:rgba(143,122,255,.12)!important}
  .node.table-card td.active-cell,.node.table-card th.active-cell{background:rgba(143,122,255,.22)!important;box-shadow:inset 0 0 0 2px var(--accent);z-index:2}
  .node.table-card tr.row-selected td,.node.table-card tr.row-selected .row-handle{background:rgba(94,159,232,.16)!important}
  .node.table-card .col-selected{background:rgba(94,159,232,.16)!important}
  .node.table-card .resize-col{position:absolute;right:-4px;top:0;width:8px;height:100%;cursor:col-resize;z-index:8}
  .node.table-card .resize-col:hover{background:rgba(143,122,255,.35)}
  .node.table-card .table-mini{display:flex;gap:6px;align-items:center;padding:6px;border:1px solid rgba(255,255,255,.10);border-radius:10px;background:rgba(18,18,20,.82);box-shadow:0 8px 26px rgba(0,0,0,.25)}
  .node.table-card .table-mini button{min-height:30px;padding:5px 8px;border-radius:8px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.10);color:var(--text);font-size:11px;cursor:pointer}
  .node.table-card .table-mini button:hover,.node.table-card .table-toolbar button:hover{background:rgba(143,122,255,.18);border-color:rgba(143,122,255,.45)}
  .node.table-card .table-help{font-size:10.5px;color:var(--muted);line-height:1.25;margin-left:2px}
  .node.chart-card .chart-toolbar{gap:8px}
  .node.chart-card .chart-toolbar .chart-hint{margin-left:auto;display:flex;align-items:center;min-width:0}
  .node.chart-card .chart-toolbar .chart-browse{height:28px;padding:0 10px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:transparent;color:var(--muted);font-size:11px;font-weight:700;white-space:nowrap;cursor:pointer}
  .node.chart-card .chart-toolbar .chart-browse:hover{background:rgba(255,255,255,.06);color:var(--text)}
  .node.chart-card svg [title]{cursor:crosshair}


  /* Refined Canva-like table experience */
  .node.table-card{border-radius:10px;background:#18191a;border-color:rgba(255,255,255,.18)}
  .node.table-card .titlebar{height:30px;border-bottom:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.018)}
  .node.table-card .content{padding:8px;gap:6px;background:#171819;overflow:hidden}
  .node.table-card .table-toolbar{height:28px;display:flex;align-items:center;gap:6px;opacity:.82;transition:opacity .12s}
  .node.table-card:hover .table-toolbar{opacity:1}
  .node.table-card .table-toolbar button{height:26px;padding:0 8px;border-radius:7px;background:transparent;border:1px solid transparent;color:rgba(255,255,255,.68);font-size:11px;cursor:pointer}
  .node.table-card .table-toolbar button:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.10);color:#fff}
  .node.table-card .table-toolbar .table-title-chip{font-size:10px;color:rgba(255,255,255,.52);font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-right:auto}
  .node.table-card .table-toolbar .table-status{font-size:10.5px;color:rgba(255,255,255,.42);white-space:nowrap}
  .node.table-card .table-grid{position:relative;flex:1;min-height:0;overflow:auto;border:1px solid rgba(255,255,255,.09);border-radius:8px;background:#111213;cursor:default}
  .node.table-card table.canvas-table{table-layout:fixed;border-collapse:separate;border-spacing:0;min-width:max-content;width:max-content;font-size:12px}
  .node.table-card .corner-cell{position:sticky;left:0;top:0;z-index:7;width:34px;min-width:34px;background:#191a1c!important;border-right:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.48);text-align:center;cursor:pointer}
  .node.table-card .row-handle{position:sticky;left:0;z-index:4;width:34px;min-width:34px;background:#17181a!important;border-right:1px solid rgba(255,255,255,.09);color:rgba(255,255,255,.42);text-align:center;font-size:10px;font-weight:700;cursor:pointer;user-select:none}
  .node.table-card thead th.data-head{position:sticky;top:0;z-index:5;height:30px;background:#191a1c!important;border-bottom:1px solid rgba(255,255,255,.12);font-weight:700;color:rgba(255,255,255,.82);overflow:hidden;text-overflow:ellipsis}
  .node.table-card th,.node.table-card td{height:32px;min-width:86px;padding:6px 9px;border-right:1px solid rgba(255,255,255,.075);border-bottom:1px solid rgba(255,255,255,.075);white-space:nowrap;text-align:left;vertical-align:middle;position:relative;outline:none;transition:background .1s,box-shadow .1s,border-color .1s}
  .node.table-card td{background:#141516;color:rgba(255,255,255,.78)}
  .node.table-card tbody tr:nth-child(even) td{background:#161719}
  .node.table-card td:hover,.node.table-card th.data-head:hover,.node.table-card .row-handle:hover{background:rgba(143,122,255,.12)!important}
  .node.table-card td.active-cell,.node.table-card th.active-cell{background:rgba(143,122,255,.18)!important;box-shadow:inset 0 0 0 2px #8f7aff;z-index:3}
  .node.table-card tr.row-selected td,.node.table-card tr.row-selected .row-handle{background:rgba(94,159,232,.14)!important;box-shadow:inset 0 1px 0 rgba(94,159,232,.38), inset 0 -1px 0 rgba(94,159,232,.38)}
  .node.table-card .col-selected{background:rgba(94,159,232,.14)!important;box-shadow:inset 1px 0 0 rgba(94,159,232,.35), inset -1px 0 0 rgba(94,159,232,.35)}
  .node.table-card .resize-col{position:absolute;right:-4px;top:0;width:8px;height:100%;cursor:col-resize;z-index:9;opacity:0;transition:opacity .1s}.node.table-card th:hover .resize-col{opacity:1}.node.table-card .resize-col:hover{background:rgba(143,122,255,.45)}
  .node.table-card .table-add{position:absolute;z-index:12;width:22px;height:22px;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:#202124;color:#ddd;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:opacity .12s,transform .12s;font-size:16px;line-height:1;box-shadow:0 5px 16px rgba(0,0,0,.35)}
  .node.table-card:hover .table-add{opacity:1}.node.table-card .table-add:hover{background:#2a2b2f;transform:scale(1.04)}
  .node.table-card .table-add-row{left:43px;bottom:8px}.node.table-card .table-add-col{right:8px;top:43px}
  .node.table-card .table-help,.node.table-card .table-mini{display:none!important}
  .table-context-menu{position:fixed;z-index:9999;min-width:250px;background:rgba(24,25,26,.98);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:8px;box-shadow:0 18px 60px rgba(0,0,0,.45);backdrop-filter:blur(16px);display:none;color:#f2f2f2;font:14px/1.2 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  .table-context-menu.show{display:block}.table-context-menu .mi{display:flex;align-items:center;gap:11px;width:100%;height:38px;padding:0 10px;border:0;background:transparent;color:rgba(255,255,255,.88);border-radius:9px;cursor:pointer;text-align:left}.table-context-menu .mi:hover{background:rgba(255,255,255,.07)}.table-context-menu .mi[disabled]{opacity:.38;cursor:not-allowed}.table-context-menu .mi .ico{width:20px;text-align:center;color:rgba(255,255,255,.72)}.table-context-menu .mi .key{margin-left:auto;color:rgba(255,255,255,.38);font-size:12px}.table-context-menu .sep{height:1px;background:rgba(255,255,255,.08);margin:6px 2px}

  .node.chart-card .content{padding:10px 12px;overflow:hidden;background:rgba(255,255,255,.02);display:flex;flex-direction:column;gap:8px}
  .node.chart-card .chart-wrap{position:relative;flex:1;min-height:170px;width:100%;border-radius:10px;background:linear-gradient(180deg,rgba(255,255,255,.02),rgba(255,255,255,.01));border:1px solid rgba(255,255,255,.08);padding:10px;overflow:hidden}
  .node.chart-card svg{width:100%;height:100%;display:block;overflow:visible}
  .node.chart-card .chart-empty,.node.table-card .table-empty{height:100%;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);font-size:12.5px;padding:12px}
  .node.chart-card .chart-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--muted)}
  .node.chart-card .legend-item{display:flex;align-items:center;gap:6px}
  .node.chart-card .legend-swatch{width:10px;height:10px;border-radius:3px;display:inline-block}
  .node.chart-card .chart-tip{position:absolute;pointer-events:none;background:rgba(10,10,12,.96);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:6px 8px;font-size:11px;color:#fff;white-space:nowrap;transform:translate(-50%,-120%);opacity:0;transition:opacity .12s ease;z-index:5}
  .node.chart-card .chart-tip.show{opacity:1}
  .node.chart-card .chart-wrap svg .chart-hit{cursor:pointer;transition:filter .12s ease,transform .12s ease,opacity .12s ease}
  .node.chart-card .chart-wrap svg .chart-hit:hover{filter:brightness(1.08)}
  .node.chart-card .chart-wrap svg .chart-hit.chart-hit-active{filter:drop-shadow(0 0 0.45rem rgba(143,122,255,.45)) brightness(1.1)}

  .anchor{position:absolute;width:15px;height:15px;border-radius:50%;background:var(--accent);border:2px solid #121018;opacity:0;cursor:crosshair;z-index:8;transition:opacity .12s,transform .12s}.node:hover .anchor,.node.selected .anchor{opacity:1}.anchor:hover{transform:scale(1.35)}
  .a-t{left:calc(50% - 7.5px);top:-9px}.a-b{left:calc(50% - 7.5px);bottom:-9px}.a-l{top:calc(50% - 7.5px);left:-9px}.a-r{top:calc(50% - 7.5px);right:-9px}
  .rh{position:absolute;width:16px;height:16px;z-index:9;opacity:0}.node:hover .rh,.node.selected .rh{opacity:1}.rh::after{content:"";position:absolute;inset:4px;border-radius:4px;background:#e7e7e7;border:1px solid #111}.rh-nw{left:-8px;top:-8px;cursor:nwse-resize}.rh-se{right:-8px;bottom:-8px;cursor:nwse-resize}.rh-ne{right:-8px;top:-8px;cursor:nesw-resize}.rh-sw{left:-8px;bottom:-8px;cursor:nesw-resize}

  .md h1{font-size:1.8em;line-height:1.18;margin:.05em 0 .38em;font-weight:800}.md h2{font-size:1.42em;line-height:1.24;margin:.12em 0 .32em;font-weight:760}.md h3{font-size:1.15em;margin:.16em 0 .28em;font-weight:750}.md p{margin:.36em 0}.md ul,.md ol{margin:.36em 0;padding-left:1.3em}.md li{margin:.18em 0}.md li.task{list-style:none;margin-left:-1.12em}.md code{background:rgba(255,255,255,.1);padding:1px 5px;border-radius:5px;font:0.88em ui-monospace,Menlo,Consolas,monospace}.md a{color:#91c4ff;text-decoration:none}.md mark{background:rgba(224,222,113,.35);color:inherit;border-radius:4px;padding:0 3px}.md blockquote{border-left:3px solid var(--accent);padding-left:10px;color:#c7c7c7;margin:.4em 0}.md input[type=checkbox]{accent-color:var(--accent);margin-right:6px;vertical-align:-2px}.md hr{border:0;border-top:1px solid rgba(255,255,255,.14);margin:10px 0}.md s{color:var(--muted)}

  .bar{position:fixed;display:flex;gap:3px;background:rgba(32,32,32,.94);backdrop-filter:blur(14px);border:1px solid var(--border);border-radius:12px;padding:5px;z-index:60;box-shadow:var(--shadow)}
  .bar button,.toolbtn{width:38px;height:38px;display:flex;align-items:center;justify-content:center;background:transparent;border:0;border-radius:8px;color:#c9c9c9;cursor:pointer;position:relative}.bar button:hover,.toolbtn:hover{background:var(--hover);color:#fff}.bar button.active{background:rgba(143,122,255,.22);color:var(--accent)}.bar button svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.tip{position:absolute;left:calc(100% + 10px);top:50%;transform:translateY(-50%);background:#101010;color:#eee;font-size:12px;padding:5px 9px;border-radius:7px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s;border:1px solid #333}.bar button:hover .tip{opacity:1}
  #toolbar{right:14px;top:50%;transform:translateY(-50%);flex-direction:column}.divider{height:1px;background:var(--border);margin:3px 4px}#toolbar button .tip{left:auto;right:calc(100% + 10px)}.bar button:disabled{opacity:.38;cursor:not-allowed}.bar button:disabled:hover{background:transparent;color:#c9c9c9}
  #topbar{left:50%;top:12px;transform:translateX(-50%);align-items:center;gap:5px;max-width:calc(100vw - 28px);transition:opacity .18s ease, transform .18s ease;opacity:.72}
  #topbar:hover,#topbar.open,#topbar:focus-within{opacity:1}
  #topbar button{width:auto;min-width:38px;padding:0 12px;gap:7px;white-space:nowrap}
  #topbar .tools-toggle{font-weight:750;color:#fff;background:rgba(143,122,255,.18);border:1px solid rgba(143,122,255,.35)}
  #topbar .tool-drawer{display:flex;gap:4px;overflow:hidden;max-width:0;opacity:0;transform:translateX(-10px);transition:max-width .24s ease, opacity .18s ease, transform .24s ease;pointer-events:none}
  #topbar.open .tool-drawer,#topbar:hover .tool-drawer,#topbar:focus-within .tool-drawer{max-width:760px;opacity:1;transform:translateX(0);pointer-events:auto}
  #topbar.open .tools-toggle{background:rgba(143,122,255,.30)}
  #formatbar{left:50%;top:68px;transform:translateX(-50%);align-items:center;gap:2px;display:none;max-width:calc(100vw - 28px);overflow:auto} #formatbar.show{display:flex} #formatbar button{font-weight:700}.mini{height:30px!important;min-width:30px!important;width:auto!important;padding:0 9px!important;font-size:13px}
