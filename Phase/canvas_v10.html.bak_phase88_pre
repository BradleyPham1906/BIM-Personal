      flat:A3D.flat,viewLabel:A3D.view,levelId:A3D.activeLevel,levelFilter:!!A3D.levelFilter,
      section:A3D.section?{p:A3D.section.p,dir:A3D.section.dir,keepSign:A3D.section.keepSign}:null
