        border: '1px solid ' + b.color,
        borderRadius: '4px', padding: '1px 5px',
        fontFamily: 'monospace', fontSize: '11px', fontWeight: '800',
        lineHeight: '16px', pointerEvents: 'none',
      });
      cov.appendChild(span);
      offsetX += 28;
    }
  }
  window.__drawConstraintBadges = drawConstraintBadges;

  // ─── Hook into pointermove: augment snap + polar + badges ───────────────────────
  function hookVp() {
    const vp = document.getElementById('viewport');
    if (!vp) { setTimeout(hookVp, 300); return; }

    vp.addEventListener('pointermove', e => {
      const wp = tw(e.clientX, e.clientY);
      // Wire snaps: find enhanced snap and store in __cadSnapCurrent
      const wireSnap = findSnapEnhanced(e.clientX, e.clientY);
      if (wireSnap) {
        window.__cadSnapCurrent = { wx: wireSnap.wx, wy: wireSnap.wy,
          x: wireSnap.wx, y: wireSnap.wy, type: wireSnap.type };
      } else {
        window.__cadSnapCurrent = null;
      }
      // Polar: if snapping wasn't found, try polar tracking
      if (!wireSnap && lastPolarBase) {
        const polar = applyPolar(wp.wx || wp.x, wp.wy || wp.y);
        if (polar) {
          window.__cadSnapCurrent = { wx: polar.wx, wy: polar.wy,
            x: polar.wx, y: polar.wy, type: 'polar' };
          drawPolarLine(polar);
        } else {
          drawPolarLine(null);
        }
      } else {
        drawPolarLine(null);
      }
      // Constraint badges
      drawConstraintBadges(wp.wx || wp.x, wp.wy || wp.y);
    }, { capture: false, passive: true });
  }
  hookVp();

  // ─── Keyboard: F9 snap, F10 polar ──────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    const tag = (e.target && e.target.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target?.isContentEditable) return;
    if (e.key === 'F9') {
      e.preventDefault();
      if (typeof CAD !== 'undefined') {
        CAD.snapOn = !CAD.snapOn;
        toast?.((CAD.snapOn ? '▦ SNAP ON' : '▧ SNAP OFF') + '  (F9)');
        updateHUD();
      }
    }
    if (e.key === 'F10') {
      e.preventDefault();
      polarOn = !polarOn;
      pov.innerHTML = '';
      cov.innerHTML = '';
      toast?.(polarOn ? '🧭 POLAR TRACKING ON  (F10)' : '🧭 POLAR TRACKING OFF  (F10)');
      updateHUD();
    }
  });

  // ─── HUD update (adds Polar indicator) ───────────────────────────────────────────
  function updateHUD() {
    const el = document.getElementById('hud-polar');
    if (el) {
      el.textContent = polarOn ? '🧭 POLAR' : '';
      el.style.color = '#ffd93d';
    }
  }

  // Inject polar indicator span into existing HUD
  function injectPolarHUD() {
    const hud = document.getElementById('cad-coord-hud');
    if (!hud) { setTimeout(injectPolarHUD, 500); return; }
    if (document.getElementById('hud-polar')) return;
    const span = document.createElement('span');
    span.id = 'hud-polar'; span.style.color = '#ffd93d';
    hud.appendChild(span);
  }
  injectPolarHUD();

  // Hook polar base into drafting engine: whenever a wire point is committed,
  // update the polar base. The drafting engine exposes __draftLastPoint.
  setInterval(() => {
    const lp = window.__draftLastPoint;
    if (lp && (lp.wx !== (lastPolarBase && lastPolarBase.wx) ||
               lp.wy !== (lastPolarBase && lastPolarBase.wy))) {
      lastPolarBase = { wx: lp.wx, wy: lp.wy };
    }
  }, 60);

  // Also expose SNAP_COLORS for new types (quadrant, polar)
  setTimeout(() => {
    if (typeof SNAP_COLORS !== 'undefined') {
      SNAP_COLORS.quadrant = '#ff9f43';
      SNAP_COLORS.polar    = '#ffd93d';
      SNAP_COLORS.nearest  = '#c77dff';
    }
  }, 1000);

  // Also patch cad_drafting to expose last point
  // cad_drafting.js sets TOOL.pts but doesn't expose it globally;
  // We hook pointerdown to capture the last clicked world point
  function hookLastPoint() {
    const vp = document.getElementById('viewport');
    if (!vp) { setTimeout(hookLastPoint, 300); return; }
    vp.addEventListener('pointerdown', e => {
      if (e.button !== 0) return;
      // Update polar base on any left click in viewport
      const snap = window.__cadSnapCurrent;
      if (snap) {
        window.__draftLastPoint = { wx: snap.x || snap.wx, wy: snap.y || snap.wy };
      } else {
        const wp = tw(e.clientX, e.clientY);
        window.__draftLastPoint = { wx: wp.wx || wp.x, wy: wp.wy || wp.y };
      }
      lastPolarBase = window.__draftLastPoint;
    }, { capture: false, passive: true });
  }
  hookLastPoint();

  // Register RUN commands
  function hookRUN() {
    if (!window.RUN) { setTimeout(hookRUN, 300); return; }
    window.RUN.polarToggle = () => {
      polarOn = !polarOn;
      toast?.(polarOn ? '🧭 POLAR ON' : '🧭 POLAR OFF');
      updateHUD();
    };
    window.RUN.snapToggle = () => {
      if (typeof CAD !== 'undefined') {
        CAD.snapOn = !CAD.snapOn;
        toast?.(CAD.snapOn ? '▦ SNAP ON' : '▧ SNAP OFF');
        updateHUD();
      }
    };
  }
  hookRUN();
})();

</script>
