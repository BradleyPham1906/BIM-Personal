  var st=window.state||{},z=cam().z,tol=14/Math.max(z,1e-4),best=null,bd=tol;
  (st.wires||[]).forEach(function(t){(t.points||[]).forEach(function(p,idx){
    var d=Math.hypot(w.x-p.x,w.y-p.y); if(d<=bd){bd=d;best={wire:t,idx:idx,pt:{x:p.x,y:p.y}}}
  })});
  return best;
}
function snapPt(w){var v=nearestVertex(w);return v?v.pt:w}

/* ---------------- ISO 286 hole/shaft fit calculator ---------------- */
function fitNominalRange(v){var R=FIT.measureRanges,i=1;while(v>R[i])i++;return i-1}
function fitITValue(q,r){var t=FIT.itTables['IT'+q];return t[Math.min(r,t.length-1)]}
function fitFieldValue(ch,r){var t=FIT.fieldTables[ch+'Field'];if(!t)return null;return t[Math.min(r,t.length-1)]}
function iso286(value,fieldChar,quality){
  /* computes upper/lower deviation for a given field letter + IT grade + nominal size */
  var r=fitNominalRange(value);
  var upper=fitFieldValue(fieldChar,r);
  var lower=upper-fitITValue(quality,r);
  if(fieldChar==='H'){upper=-lower;lower=0;}
  return {upper:upper/1000,lower:lower/1000};
}
function fmtTol(v){
  /* format a signed tolerance value: trim trailing zeros, show sign for +/- */
  var s=v.toFixed(6).replace(/0+$/,'').replace(/\.$/,'');
  if(v>0)s='+'+s; if(v===0)s='0';
  return s;
}
var FIT_TYPE_LABEL={loose:'Loose fit',snug:'Snug fit',press:'Press fit'};

/* ---------------- regular-polygon / hexagon profiles ---------------- */
function makeRegularPolygonPts(sides,centerPoint,firstCornerPoint){
  /* rotate the center->corner vector by 2*pi/sides steps */
  if(sides<3)return null;
  var dx=firstCornerPoint.x-centerPoint.x, dy=firstCornerPoint.y-centerPoint.y;
  var angular_diff=2*Math.PI/sides, pointList=[];
  for(var i=0;i<sides;i++){
    var cos_v=Math.cos(angular_diff*i), sin_v=Math.sin(angular_diff*i);
    pointList.push({x:centerPoint.x+(cos_v*dx-sin_v*dy), y:centerPoint.y+(cos_v*dy+sin_v*dx)});
  }
  return pointList;
}
function commitRegularPolygon(sides,center,corner,profileName){
  var pts=makeRegularPolygonPts(sides,center,corner);
  if(!pts){say('Number of sides must be at least 3');return null}
  /* constraint set: coincident chain, equal sides, points on construction circle */
  var cons=[],i;
  for(i=0;i<sides;i++)cons.push({type:'Coincident',a:i,b:(i+1)%sides});
  for(i=1;i<sides;i++)cons.push({type:'Equal',a:0,b:i});
  for(i=0;i<sides;i++)cons.push({type:'PointOnObject',v:i});
  var w=newWire(pts,true,{constraints:cons,profile:profileName||('RegularPolygon'+sides)});
  /* construction circle (marked non-solid/reference geometry) */
  newCircle(center,Math.hypot(corner.x-center.x,corner.y-center.y),{construction:true,lineStyle:'dashed',kind:'construction'});
  persist();
  return w;
}

/* ---------------- constraint direct-solver (sketcher constraints) ---------------- */
function segOfPick(pick){
  if(!pick||pick.seg<0)return null;
  var pts=pick.wire.points;
  return {a:pts[pick.seg],b:pts[(pick.seg+1)%pts.length],wire:pick.wire,seg:pick.seg};
}
function recordCon(wire,con){wire.constraints=wire.constraints||[];wire.constraints.push(con)}
function solveHorizontal(seg){
  var mid={x:(seg.a.x+seg.b.x)/2,y:(seg.a.y+seg.b.y)/2},L=Math.hypot(seg.b.x-seg.a.x,seg.b.y-seg.a.y)/2;
  var dir=(seg.b.x>=seg.a.x)?1:-1;
  seg.a.x=mid.x-L*dir;seg.a.y=mid.y;seg.b.x=mid.x+L*dir;seg.b.y=mid.y;
  recordCon(seg.wire,{type:'Horizontal',seg:seg.seg});
}
function solveVertical(seg){
  var mid={x:(seg.a.x+seg.b.x)/2,y:(seg.a.y+seg.b.y)/2},L=Math.hypot(seg.b.x-seg.a.x,seg.b.y-seg.a.y)/2;
  var dir=(seg.b.y>=seg.a.y)?1:-1;
  seg.a.x=mid.x;seg.a.y=mid.y-L*dir;seg.b.x=mid.x;seg.b.y=mid.y+L*dir;
  recordCon(seg.wire,{type:'Vertical',seg:seg.seg});
}
function solveAngleTo(segB,targetAng,conType,refWire){
  var cur=segAngle(segB.a,segB.b);
  /* rotate by smallest amount (allow +-pi flip like the solver would) */
  var d=targetAng-cur;
  while(d>Math.PI/2)d-=Math.PI; while(d<-Math.PI/2)d+=Math.PI;
  var mid={x:(segB.a.x+segB.b.x)/2,y:(segB.a.y+segB.b.y)/2};
  var na=rotAbout(segB.a,mid,d),nb=rotAbout(segB.b,mid,d);
  segB.a.x=na.x;segB.a.y=na.y;segB.b.x=nb.x;segB.b.y=nb.y;
  recordCon(segB.wire,{type:conType,seg:segB.seg,ref:refWire.id});
}
function solveEqual(pickA,pickB){
  if(pickA.wire.radius!=null&&pickB.wire.radius!=null){
    pickB.wire.radius=pickA.wire.radius;
    recordCon(pickB.wire,{type:'Equal',ref:pickA.wire.id});return true;
  }
  var sa=segOfPick(pickA),sb=segOfPick(pickB);
  if(!sa||!sb)return false;
  var La=Math.hypot(sa.b.x-sa.a.x,sa.b.y-sa.a.y),Lb=Math.hypot(sb.b.x-sb.a.x,sb.b.y-sb.a.y);
  if(Lb<1e-9)return false;
  var k=La/Lb,mid={x:(sb.a.x+sb.b.x)/2,y:(sb.a.y+sb.b.y)/2};
  [sb.a,sb.b].forEach(function(p){p.x=mid.x+(p.x-mid.x)*k;p.y=mid.y+(p.y-mid.y)*k});
  recordCon(sb.wire,{type:'Equal',seg:sb.seg,ref:pickA.wire.id});return true;
}
function solveCoincident(vA,vB){
  vB.wire.points[vB.idx].x=vA.pt.x; vB.wire.points[vB.idx].y=vA.pt.y;
  recordCon(vB.wire,{type:'Coincident',idx:vB.idx,ref:vA.wire.id});
}

/* ---------------- vertex tools (intersection / offset) ---------------- */
function allIntersections(w1,w2){
  var pts=[];
  function segsOf(w){return (w.radius!=null&&w.cx!=null)?null:wireSegs(w)}
  var s1=segsOf(w1),s2=segsOf(w2);
  if(s1&&s2){s1.forEach(function(A){s2.forEach(function(B){var p=segIntersect(A[0],A[1],B[0],B[1]);if(p)pts.push(p)})})}
  else if(s1&&!s2){s1.forEach(function(A){segCircleIntersect(A[0],A[1],w2.cx,w2.cy,w2.radius).forEach(function(p){pts.push(p)})})}
  else if(!s1&&s2){s2.forEach(function(A){segCircleIntersect(A[0],A[1],w1.cx,w1.cy,w1.radius).forEach(function(p){pts.push(p)})})}
  else if(!s1&&!s2){
    var d=Math.hypot(w2.cx-w1.cx,w2.cy-w1.cy);
    if(d>1e-9&&d<=w1.radius+w2.radius&&d>=Math.abs(w1.radius-w2.radius)){
      var a=(w1.radius*w1.radius-w2.radius*w2.radius+d*d)/(2*d),h=Math.sqrt(Math.max(0,w1.radius*w1.radius-a*a));
      var mx=w1.cx+a*(w2.cx-w1.cx)/d,my=w1.cy+a*(w2.cy-w1.cy)/d;
      pts.push({x:mx+h*(w2.cy-w1.cy)/d,y:my-h*(w2.cx-w1.cx)/d});
      if(h>1e-9)pts.push({x:mx-h*(w2.cy-w1.cy)/d,y:my+h*(w2.cx-w1.cx)/d});
    }
  }
  /* dedupe */
  var out=[];pts.forEach(function(p){if(!out.some(function(q){return Math.hypot(q.x-p.x,q.y-p.y)<1e-6}))out.push(p)});
  return out;
}

/* ---------------- measure (distance / angle / area & COM) ---------------- */
var MEAS=[];
function addMeasure(type,at,text){MEAS.push({type:type,at:{x:at.x,y:at.y},text:text});drawOverlay()}
function measureShape(wire){
  var area,com,label;
  if(wire.radius!=null&&wire.cx!=null){
    area=Math.PI*wire.radius*wire.radius; com={x:wire.cx,y:wire.cy};
  }else{
    if(!wire.closed){say('Select a closed shape or circle');return false}
    area=Math.abs(polyArea(wire.points)); com=polyCOM(wire.points);
  }
  /* result string: "COM X: Y:" (Z omitted since this is a 2D workspace) */
  label='COM  X: '+com.x.toFixed(2)+'  Y: '+com.y.toFixed(2)+'\nArea: '+area.toFixed(2)+' u\u00b2';
  if(wire.material&&wire.material.density){
    var g=wire.material.density*area*1e-6; /* density kg/m3 * mm2 * 1mm thickness -> grams */
    label+='\nMass: '+g.toFixed(2)+' g ('+wire.material.name+', t=1mm)';
  }
  addMeasure('COM',com,label);
  say('COM  X: '+com.x.toFixed(2)+'  Y: '+com.y.toFixed(2));
  return true;
}

/* ---------------- command machine ---------------- */
var cmd=null,cursor=null,lastPt=null;
function startCmd(name,hint,data){
  try{document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}))}catch(e){}
  try{window.__draftCancelTool&&__draftCancelTool()}catch(e){}
  cmd={name:name,step:0,data:data||{}};
  setHint(hint); var v=VP(); if(v)v.classList.add('acadwb-pick');
  drawOverlay();
}
function endCmd(msg){
  cmd=null;lastPt=null; var v=VP(); if(v)v.classList.remove('acadwb-pick');
  setHint(msg||'Ready'); drawOverlay();
}
function parseCoordWb(txt){
  var m=txt.match(/^@?\s*(-?\d*\.?\d+)\s*,\s*(-?\d*\.?\d+)$/);
  if(m){var x=parseFloat(m[1]),y=parseFloat(m[2]);
    if(txt.charAt(0)==='@'){if(!lastPt)return null;return {x:lastPt.x+x,y:lastPt.y+y}}
    return {x:x,y:y};
  }
  var p=txt.match(/^@\s*(-?\d*\.?\d+)\s*<\s*(-?\d*\.?\d+)$/);
  if(p&&lastPt){var r=parseFloat(p[1]),a=parseFloat(p[2])*Math.PI/180;
    return {x:lastPt.x+r*Math.cos(a),y:lastPt.y-r*Math.sin(a)};}
  return null;
}
function feedPoint(w){
  if(!cmd)return;
  var d=cmd.data;lastPt=w;
  switch(cmd.name){
    case 'wbHexagon': case 'wbPolygon':
      if(cmd.step===0){d.center=w;cmd.step=1;setHint((cmd.name==='wbHexagon'?'Hexagon':'Polygon ('+(d.sides||6)+' sides')+': pick first corner  (or type x,y)');}
      else{
        var sides=cmd.name==='wbHexagon'?6:(d.sides||6);
        var wire=commitRegularPolygon(sides,d.center,w,sides===6&&cmd.name==='wbHexagon'?'Hexagon':'RegularPolygon'+sides);
        if(wire)say((cmd.name==='wbHexagon'?'Hexagon':sides+'-gon')+' created (+ construction circle)');
        endCmd();
      }
      break;
    case 'wbConH': case 'wbConV':{
      var pk=pickWire(w),sg=segOfPick(pk);
      if(!sg){say('Pick a line segment');return}
      (cmd.name==='wbConH'?solveHorizontal:solveVertical)(sg);
      persist();say((cmd.name==='wbConH'?'Horizontal':'Vertical')+' constraint applied');endCmd();break;}
    case 'wbConPar': case 'wbConPerp':{
      var pk2=pickWire(w);
      if(!pk2||pk2.seg<0){say('Pick a line segment');return}
      if(cmd.step===0){d.first=pk2;cmd.step=1;setHint('Pick second line (will be made '+(cmd.name==='wbConPar'?'parallel':'perpendicular')+')');}
      else{
        if(pk2.wire===d.first.wire&&pk2.seg===d.first.seg){say('Pick a different segment');return}
        var sa=segOfPick(d.first),sb=segOfPick(pk2);
        var target=segAngle(sa.a,sa.b)+(cmd.name==='wbConPerp'?Math.PI/2:0);
        solveAngleTo(sb,target,cmd.name==='wbConPar'?'Parallel':'Perpendicular',d.first.wire);
        persist();say((cmd.name==='wbConPar'?'Parallel':'Perpendicular')+' constraint applied');endCmd();
      }break;}
    case 'wbConEq':{
      var pk3=pickWire(w);
      if(!pk3){say('Pick an edge or circle');return}
      if(cmd.step===0){d.first=pk3;cmd.step=1;setHint('Pick second edge/circle (made equal to first)');}
      else{if(solveEqual(d.first,pk3)){persist();say('Equal constraint applied')}else say('Cannot apply Equal here');endCmd();}
      break;}
    case 'wbConCoinc':{
      var v=nearestVertex(w);
      if(!v){say('Pick near a vertex');return}
      if(cmd.step===0){d.first=v;cmd.step=1;setHint('Pick vertex to move onto the first');}
      else{
        if(v.wire===d.first.wire&&v.idx===d.first.idx){say('Pick a different vertex');return}
        solveCoincident(d.first,v);persist();say('Coincident constraint applied');endCmd();
      }break;}
    case 'wbVertexInt':{
      var pk4=pickWire(w);
      if(!pk4){say('Pick an edge');return}
      if(cmd.step===0){d.first=pk4.wire;cmd.step=1;setHint('Pick second edge (vertices at all intersections)');}
      else{
        if(pk4.wire===d.first){say('Pick a different edge');return}
        var ints=allIntersections(d.first,pk4.wire);
        if(!ints.length){say('No intersection found');endCmd();return}
        ints.forEach(function(p){newPoint(p)});persist();
        say(ints.length+' vertex'+(ints.length>1?'es':'')+' created at intersection');endCmd();
      }break;}
    case 'wbVertexOff':{
      var v2=nearestVertex(w);
      if(!v2){say('Pick near a vertex');return}
      d.base=v2.pt;cmd.step=1;setHint('Offset vertex: type dx,dy in command line (e.g. 20,-10)');
      break;}
    case 'wbMeasureDist':{
      var sp=snapPt(w);
      if(cmd.step===0){d.p1=sp;cmd.step=1;setHint('Measure distance: pick second point');}
      else{
        var dx=sp.x-d.p1.x,dy=sp.y-d.p1.y,L=Math.hypot(dx,dy);
        var midp={x:(sp.x+d.p1.x)/2,y:(sp.y+d.p1.y)/2};
        addMeasure('Distance',midp,'Distance: '+L.toFixed(2)+'\n\u0394X: '+dx.toFixed(2)+'  \u0394Y: '+dy.toFixed(2));
        say('Distance: '+L.toFixed(2));endCmd();
      }break;}
    case 'wbMeasureAngle':{
      var pk5=pickWire(w),sg5=segOfPick(pk5);
      if(!sg5){say('Pick a line segment');return}
      if(cmd.step===0){d.first=sg5;d.at=w;cmd.step=1;setHint('Measure angle: pick second line');}
      else{
        var a1=segAngle(d.first.a,d.first.b),a2=segAngle(sg5.a,sg5.b);
        var deg=Math.abs(a1-a2)*180/Math.PI;deg=deg%180;if(deg>90+1e-9)deg=180-deg;
        addMeasure('Angle',w,'Angle: '+deg.toFixed(2)+'\u00b0');
        say('Angle: '+deg.toFixed(2)+'\u00b0');endCmd();
      }break;}
    case 'wbMeasureCOM':{
      var pk6=pickWire(w);
      if(!pk6){say('Pick a closed shape or circle');return}
      if(measureShape(pk6.wire))endCmd();
      break;}
    case 'wbFitPlace':{
      newTextNode(w,d.text);persist();say('Fit annotation placed');endCmd();break;}
    case 'wbMatAssign':{
      var pk7=pickWire(w);
      if(!pk7||!(pk7.wire.closed||pk7.wire.radius!=null)){say('Pick a closed shape or circle');return}
      pk7.wire.material={name:d.card.name,density:d.card.density,youngsModulus:d.card.youngsModulus,poissonRatio:d.card.poissonRatio,kindOfMaterial:d.card.kind,hatch:d.card.hatch,hatchColor:d.card.color};
      persist();matVer++;say(d.card.name+' assigned');endCmd();
      break;}
  }
  drawOverlay();
}
function handleTyped(v){
  if(!cmd)return false;
  if((cmd.name==='wbPolygon')&&cmd.step===0&&!cmd.data.center&&/^\d+$/.test(v)){
    var n=parseInt(v,10);
    if(n<3){say('Number of sides must be at least 3');return true}
    cmd.data.sides=n;setHint('Polygon ('+n+' sides): pick center');return true;
  }
  if(cmd.name==='wbVertexOff'&&cmd.step===1){
    var m=v.match(/^(-?\d*\.?\d+)\s*,\s*(-?\d*\.?\d+)$/);
    if(!m){say('Type offset as dx,dy');return true}
    newPoint({x:cmd.data.base.x+parseFloat(m[1]),y:cmd.data.base.y+parseFloat(m[2])});
    persist();say('Offset vertex created');endCmd();return true;
  }
  var p=parseCoordWb(v);
  if(p){feedPoint(p);return true}
  return false;
}

/* ---------------- overlay ---------------- */
var overlay=null;
function ensureOverlay(){
  var v=VP(); if(!v)return null;
  if(overlay&&overlay.parentNode===v)return overlay;
  overlay=document.createElementNS('http://www.w3.org/2000/svg','svg');
  overlay.id='acadwb-overlay';
  v.appendChild(overlay);
  return overlay;
}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')}
var matVer=0,lastHatchSig='';
function hatchDefs(){
  var c=cam(),defs='',idx=0;
  var out='';
  (window.state&&state.wires||[]).forEach(function(w){
    if(!w.material||!w.material.hatch)return;
    idx++;
    var gap=Math.max(3,(w.material.hatch.gap||8)*c.z),pid='wbhp'+idx;
    var stroke=w.material.hatchColor||'#8aa2b8';
    var lines='<path d="M0 0 L0 '+gap.toFixed(2)+'" stroke="'+stroke+'" stroke-width="1"/>';
    if(w.material.hatch.cross)lines+='<path d="M0 '+(gap/2).toFixed(2)+' L'+gap.toFixed(2)+' '+(gap/2).toFixed(2)+'" stroke="'+stroke+'" stroke-width="1"/>';
    defs+='<pattern id="'+pid+'" width="'+gap.toFixed(2)+'" height="'+gap.toFixed(2)+'" patternUnits="userSpaceOnUse" patternTransform="rotate('+(w.material.hatch.angle||45)+')">'+lines+'</pattern>';
    var shape;
    if(w.radius!=null&&w.cx!=null){var sc=scr({x:w.cx,y:w.cy});shape='<circle cx="'+sc.x.toFixed(1)+'" cy="'+sc.y.toFixed(1)+'" r="'+(w.radius*c.z).toFixed(1)+'"';}
    else{shape='<path d="M '+w.points.map(function(p){var s=scr(p);return s.x.toFixed(1)+' '+s.y.toFixed(1)}).join(' L ')+' Z"';}
    out+=shape+' fill="url(#'+pid+')" fill-opacity="0.55" stroke="none"/>';
  });
  return '<defs>'+defs+'</defs><g id="wb-hatch">'+out+'</g>';
}
function drawOverlay(){
  var o=ensureOverlay(); if(!o)return;
  var h=hatchDefs();
  /* measurement labels */
  MEAS.forEach(function(m){
    var s=scr(m.at),lines=m.text.split('\n');
    var wpx=Math.max.apply(null,lines.map(function(l){return l.length}))*6.4+14,hpx=lines.length*14+8;
    h+='<g><rect x="'+(s.x+8).toFixed(1)+'" y="'+(s.y-hpx-6).toFixed(1)+'" width="'+wpx.toFixed(1)+'" height="'+hpx+'" rx="3" fill="#1d2022" fill-opacity="0.92" stroke="#2f7bd9"/>';
    h+='<circle cx="'+s.x.toFixed(1)+'" cy="'+s.y.toFixed(1)+'" r="3" fill="#2f7bd9"/>';
    lines.forEach(function(l,i){h+='<text x="'+(s.x+14).toFixed(1)+'" y="'+(s.y-hpx+8+i*14).toFixed(1)+'" font-size="11" font-family="Consolas,monospace" fill="#d5e8c8">'+esc(l)+'</text>'});
    h+='</g>';
  });
  /* command ghost previews */
  if(cmd&&cursor){
    var cs=scr(cursor);
    if((cmd.name==='wbHexagon'||cmd.name==='wbPolygon')&&cmd.step===1&&cmd.data.center){
      var sides=cmd.name==='wbHexagon'?6:(cmd.data.sides||6);
      var pts=makeRegularPolygonPts(sides,cmd.data.center,cursor)||[];
      if(pts.length){
        h+='<path d="M '+pts.map(function(p){var s=scr(p);return s.x.toFixed(1)+' '+s.y.toFixed(1)}).join(' L ')+' Z" fill="none" stroke="#39d0d8" stroke-width="1.5" stroke-dasharray="6 4"/>';
        var c0=scr(cmd.data.center),rr=Math.hypot(cs.x-c0.x,cs.y-c0.y);
        h+='<circle cx="'+c0.x.toFixed(1)+'" cy="'+c0.y.toFixed(1)+'" r="'+rr.toFixed(1)+'" fill="none" stroke="#39d0d8" stroke-width="1" stroke-dasharray="2 4" opacity="0.6"/>';
      }
    }
    if(cmd.name==='wbMeasureDist'&&cmd.step===1&&cmd.data.p1){
      var p1=scr(cmd.data.p1);
      h+='<line x1="'+p1.x.toFixed(1)+'" y1="'+p1.y.toFixed(1)+'" x2="'+cs.x.toFixed(1)+'" y2="'+cs.y.toFixed(1)+'" stroke="#39d0d8" stroke-width="1" stroke-dasharray="5 4"/>';
    }
  }
  o.innerHTML=h;
}
/* hatch stays synced with camera */
setInterval(function(){
  var c=cam();
  var sig=c.ox.toFixed(1)+':'+c.oy.toFixed(1)+':'+c.z.toFixed(4)+':'+matVer+':'+MEAS.length+':'+((window.state&&state.wires)||[]).filter(function(w){return w.material}).length;
