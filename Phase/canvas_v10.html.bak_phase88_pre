  function drawGrids(ctx,V,W,H){
    if(A3D.section)return;
    if(!A3D.grids||!A3D.grids.length)return;
    var y0=bimGetActiveLevel().elev,i;
    ctx.save();
    for(i=0;i<A3D.grids.length;i++){
      var g=A3D.grids[i];
      var s1=toScreen([g.p1[0],y0,g.p1[1]],V,W,H),s2=toScreen([g.p2[0],y0,g.p2[1]],V,W,H);
      ctx.beginPath();
      ctx.moveTo(s1[0],s1[1]);ctx.lineTo(s2[0],s2[1]);
      ctx.strokeStyle='#6f7681';
      ctx.lineWidth=1;
      ctx.setLineDash([9,4,2,4]);
      ctx.stroke();
      ctx.setLineDash([]);
      /* Bubble at both ends, the way a Revit grid head reads in plan. */
      var ends=[s1,s2],k;
      for(k=0;k<2;k++){
        ctx.beginPath();
        ctx.arc(ends[k][0],ends[k][1],9,0,Math.PI*2);
        ctx.fillStyle='rgba(20,22,26,0.85)';ctx.fill();
        ctx.strokeStyle='#8f97a3';ctx.lineWidth=1.1;ctx.stroke();
        ctx.font='bold 9px system-ui,sans-serif';
        ctx.textAlign='center';ctx.textBaseline='middle';
        ctx.fillStyle='#dfe4ea';
        ctx.fillText(g.name,ends[k][0],ends[k][1]);
      }
    }
    ctx.restore();
  }
  /* ---------- Phase 42: parametric beam engine ----------
     A beam is a horizontal prism swept along its plan axis. Unlike a column it cannot use
     padMesh (which only extrudes vertically), so the six faces are emitted directly with
     outward winding. Revit hangs a beam below its level, so the level elevation is the
     top of the section and depth runs downward. ---------- */
  function bimBuildBeamGeometry(p1,p2,topY,w,dep){
    var dx=p2[0]-p1[0],dz=p2[1]-p1[1];
    var L=Math.sqrt(dx*dx+dz*dz);
    if(!(L>1e-9))return {error:'Beam endpoints coincide'};
    if(!(w>0))return {error:'Beam width must be positive'};
    if(!(dep>0))return {error:'Beam depth must be positive'};
    var ux=dx/L,uz=dz/L,nx=-uz,nz=ux,hw=w/2;
    var yTop=topY,yBot=topY-dep;
    var aL=[p1[0]+nx*hw,p1[1]+nz*hw],aR=[p1[0]-nx*hw,p1[1]-nz*hw];
    var bL=[p2[0]+nx*hw,p2[1]+nz*hw],bR=[p2[0]-nx*hw,p2[1]-nz*hw];
    var v=[
      [aR[0],yBot,aR[1]],[aL[0],yBot,aL[1]],[bL[0],yBot,bL[1]],[bR[0],yBot,bR[1]],
      [aR[0],yTop,aR[1]],[aL[0],yTop,aL[1]],[bL[0],yTop,bL[1]],[bR[0],yTop,bR[1]]
    ];
    var f=[[0,3,2,1],[4,5,6,7],[0,1,5,4],[3,7,6,2],[1,2,6,5],[0,4,7,3]];
    var mesh={v:v,f:f};
    return {mesh:mesh,length:L,
      bim:{type:'beam',p1:[p1[0],p1[1]],p2:[p2[0],p2[1]],width:w,depth:dep,
        baseY:yBot,topY:yTop,length:L,levelId:A3D.activeLevel}};
  }
