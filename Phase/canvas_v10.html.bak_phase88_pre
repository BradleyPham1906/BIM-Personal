  pointer-events: none;
}

/* ── Separator ── */
.fc-sep {
  width: 1px;
  height: 18px;
  background: var(--fc-sep);
  margin: 0 3px;
  flex-shrink: 0;
  border-radius: 1px;
}

/* ── Tooltip enhancement (title attr) — done via native, but style popover ── */

/* === Viewport offset fix ===
   #viewport is position:fixed;inset:0 — push it below the FC toolbar */
body.fc-on #viewport {
  top: 146px !important;
