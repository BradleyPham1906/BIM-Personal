    else if(n?.type==='whiteboard') html+=sec('Whiteboard',whiteboardGrid())+sec('Style',swatches(n))+common;
    else if(n?.type==='image') html+=sec('Image',row('fit','⛶','Fit / fill')+row('replaceImg','↻','Replace URL')+row('uploadReplace','↑','Upload replacement'))+common;
    else if(n?.type==='group') html+=sec('Group',row('inspect','□','Group settings')+shapeGrid(n)+borderGrid(n))+common;
    else html+=sec('Text',alignGrid(n)+row('edit','T','Edit text')+row('text-panel','⚙','Text settings'))+sec('Shape',shapeGrid(n)+borderGrid(n))+sec('Fill',swatches(n))+common;
    html+=sec('Danger',row('delete','⌫','Delete','⌘⌫',true)); return html;
  }
  function positionMenu(x,y){ctxmenu.style.display='flex';ctxmenu.style.left='-9999px';ctxmenu.style.top='-9999px';const pad=10,w=ctxmenu.offsetWidth||272,h=ctxmenu.offsetHeight||360;let l=x,t=y;if(l+w>innerWidth-pad)l=Math.max(pad,x-w);if(t+h>innerHeight-pad)t=Math.max(pad,innerHeight-pad-h);ctxmenu.style.left=l+'px';ctxmenu.style.top=t+'px'}
  const previousShow=window.showCtx || showCtx;
  window.showCtx=showCtx=function(x,y,type,id){
    const normalized=(type==='node'||type==='edge')?type:'canvas'; ctxmenu.dataset.type=normalized; ctxmenu.dataset.id=id||''; ctxmenu.dataset.kind='figma'; ctxmenu.classList.add('figma-menu');
    if(normalized==='canvas'){const p=toWorld(x,y);ctxmenu.dataset.x=p.x;ctxmenu.dataset.y=p.y;ctxmenu.innerHTML=canvasMenu()}
