        for(var i=1;i<P.length;i++) ctx.lineTo(tx(P[i].x),ty(P[i].y));
        if(w.closed||w.type==='rect') ctx.closePath();
      }
      ctx.stroke();
    });
  }
  function dwgData(){ try{return JSON.parse(localStorage.getItem('acadDrawingsV1')||'null')||{active:'d1',store:{}};}catch(e){return {active:'d1',store:{}};} }
  function addStartThumbs(){
    var start=$('#acad-start'); if(!start||!start.classList.contains('show')) return;
    var d=dwgData();
    Array.prototype.forEach.call(start.querySelectorAll('.st-card[data-open]'),function(card){
      if(card.querySelector('.st-thumb')) return;
      var id=card.getAttribute('data-open');
      var wires=id===d.active?(state.wires||[]):((d.store||{})[id]||[]);
      var cv=document.createElement('canvas');
      cv.className='st-thumb'; cv.width=200; cv.height=96;
      card.insertBefore(cv,card.firstChild);
      drawWiresToCanvas(cv,wires);
    });
  }
  var thumbPending=false;
  new MutationObserver(function(){
    if(thumbPending) return; thumbPending=true;
    requestAnimationFrame(function(){ thumbPending=false; addStartThumbs(); });
  }).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
  addStartThumbs();

  // ============ 4. WORKSPACE DROPDOWN ============
  // Three workspaces, matching how the tabs actually divide by discipline. Previously the
  // Canva/Figma whiteboard tools (Cards, Sticky, Board, Table, Chart, Media) were buried in the
  // Insert tab of the "Drafting & Annotation" workspace alongside AutoCAD draw/modify tools --
  // two unrelated toolsets sharing one workspace. Splitting them means each workspace shows only
  // the tabs that belong to it.
  var ACAD_WS='da';
  // Canvas runs the whiteboard engine. Drafting & Annotation and 3D both run the SAME BIM
  // engine -- they differ only in camera mode and which ribbon tabs are shown, which is exactly
  // how Revit works: a floor plan is a *view of the model*, not a separate drawing. Previously
  // D&A showed the whiteboard, so 2D drafting had no connection to the model at all.
  /* __acad3dV73: CANVAS IS RETIRED AS A WORKSPACE.

     Drafting & Annotation and 3D have run the same BIM engine since the workspaces were split --
     they differ only in camera mode. Canvas ran the whiteboard engine on its own data model
     (state.nodes / state.wires) with its own panels, and after V64-V72 unified the shell around
     the BIM engine it was the last surface that did not belong to the rest of the app. Worse,
     the app BOOTED into it: the workspace label read "Drafting & Annotation" while the screen
     showed the Canvas board, because the startup path applied the workspace's ribbon tabs
     without ever entering the BIM shell.

     What is removed is the WORKSPACE, not the code. The whiteboard module still supplies two
     things the unified shell depends on: the file dock and rail that host the BIM navigator
     since V65, and the shared material card library (window.__WB_MATERIAL_CARDS, V69). Ripping
     the module out would take both with it; removing it from the workspace list is the change
     that was actually asked for. */
  var ACAD_WS_TABS={
    da:['a3ddraft','a3dannotate','a3dview','a3dinsert','a3dmanage','wbprec'],
    '3d':['arch','struct','a3dannotate','a3dinsert','a3dview','a3dmodify','a3dmassing','a3dmanage','wbprec']
  };
  var ACAD_WS_LABEL={da:'Drafting &amp; Annotation','3d':'3D'};
  /* A session that last ran before this phase can have 'canvas' persisted as its workspace.
     It is migrated rather than rejected, so an existing user lands in Drafting & Annotation
     instead of a workspace that no longer exists. */
  if(window.ACAD_WS_CUR==='canvas')window.ACAD_WS_CUR='da';
  function acadApplyWorkspace(ws,opts){
    if(!ACAD_WS_TABS[ws])ws='da';
    ACAD_WS=ws;
    var tabs=document.getElementById('acad-tabs');
    var allow=ACAD_WS_TABS[ws],firstVisible=null,activeStillVisible=false;
    if(tabs){
      var btns=tabs.querySelectorAll('.acad-tab'),i;
      for(i=0;i<btns.length;i++){
        var id=btns[i].getAttribute('data-acad-tab');
        var ok=allow.indexOf(id)>=0;
        btns[i].style.display=ok?'':'none';
        if(ok){
          if(!firstVisible)firstVisible=btns[i];
          if(btns[i].classList.contains('active'))activeStillVisible=true;
        }
      }
      // if the workspace change hid the active tab, fall back to its first visible tab so the
      // ribbon is never left blank
      if(!activeStillVisible&&firstVisible&&!(opts&&opts.keepActive)){
        for(i=0;i<btns.length;i++)btns[i].classList.remove('active');
        firstVisible.classList.add('active');
        try{
          var fid=firstVisible.getAttribute('data-acad-tab');
          if(window.__a3dIsRibbonTab&&window.__a3dIsRibbonTab(fid)){if(window.renderA3dPanels)window.renderA3dPanels(fid);}
          else if(fid==='wbprec'){firstVisible.click();}
          else if(window.__acadRenderTab)window.__acadRenderTab(fid);
        }catch(eR){}
      }
    }
    /* __acad3dV84: the label reports the ACTIVE VIEW, not the workspace. Reporting the
       workspace is what made it read "Drafting & Annotation" over an isometric 3D view. The
       old workspace name is kept as the fallback for the window between first paint and the
       BIM engine publishing its hook, and for any build where that engine failed to load --
       a wrong label is bad, no label at all is worse. */
    var lab=document.querySelector('.acad-ws');
    if(lab){
      var named=false;
      try{if(window.__a3dSyncViewLabel)named=!!window.__a3dSyncViewLabel();}
      catch(eL){console.warn('[BIM] View label sync failed; showing the workspace name.',eL);}
      if(!named)lab.innerHTML=ACAD_WS_LABEL[ws]+' <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>';
    }
    return ws;
  }
  window.__acadApplyWorkspace=acadApplyWorkspace;
  /* __acad3dV73: boot INTO the drafting workspace, not just into its ribbon tabs. Before this,
     startup applied the tab set for 'da' and stopped, so the first thing on screen was the
     Canvas board under a label that said Drafting & Annotation. __a3dEnter may not be defined
     at 60ms, so this retries briefly and gives up quietly rather than throwing on a slow load --
     the workspace tabs are applied either way. */
  function acadBootWorkspace(tries){
    var ws=window.ACAD_WS_CUR||'da';
    if(ws==='canvas')ws='da';
    try{acadApplyWorkspace(ws);}catch(eS){}
    if(typeof window.__a3dEnter!=='function'){
      if(tries>0)setTimeout(function(){acadBootWorkspace(tries-1);},120);
      else console.warn('[BIM] Could not enter the drafting workspace on startup; the shell is '+
        'reachable from the workspace menu.');
      return;
    }
    try{
      /* Set BEFORE entering, not after: enter3d -> installA3dTab re-applies the workspace from
         window.ACAD_WS_CUR, and reads an undefined value as '3d'. Setting it afterwards left the
         label reading "3D" over a plan view on every cold start. */
      window.ACAD_WS_CUR=ws;
      window.__a3dEnter();
      if(ws==='3d'){if(window.__a3dSet3DView)window.__a3dSet3DView();}
      else if(window.__a3dSetPlanView)window.__a3dSetPlanView();
      if(window.__acadApplyWorkspace)window.__acadApplyWorkspace(ws,{keepActive:true});
    }catch(eB){console.warn('[BIM] Startup entry into the drafting workspace failed.',eB);}
  }
  setTimeout(function(){acadBootWorkspace(25);},60);
  /* __acad3dV75: published here, NOT inside the function body -- an assignment in the body only
     runs after the menu has already been built once, which is the very state __a3dWorkspaces
     needed a way out of. Function declarations hoist, so this is safe above the definition. */
  window.__acadBuildWsMenu=buildWsMenu;
  function buildWsMenu(){
    var m=$('#acad-wsmenu');
    if(!m){ m=document.createElement('div'); m.id='acad-wsmenu'; document.body.appendChild(m); }
    var in3d=!!window.__a3dOn;
    var cur=in3d?'3d':(window.ACAD_WS_CUR||ACAD_WS);
    function row(key,label,note){
      return '<div class="wsm-item" data-wsm="'+key+'"><span class="wsm-check">'+(cur===key?'\u2713':'')+'</span>'+label+
        (note?'<span class="wsm-note">'+note+'</span>':'')+'</div>';
    }
    /* __acad3dV84: these are VIEWS now, named as views. The keys stay 'da' and '3d' because
       they still select the ribbon tool set; what changed is that picking one opens the
       matching view rather than putting the app into a mode. */
    m.innerHTML=row('da','Floor Plan','Drafting &amp; Annotation tools')+
                row('3d','3D View','Modelling tools');
    m.querySelector('[data-wsm="da"]').addEventListener('click',function(){
      m.classList.remove('show');
      window.ACAD_WS_CUR='da';
      try{
        if(window.__a3dEnter)window.__a3dEnter();          // same BIM engine as 3D...
        if(window.__a3dSetPlanView)window.__a3dSetPlanView(); // ...just locked to the plan view
      }catch(e){}
      acadApplyWorkspace('da');
      if(window.renderA3dPanels&&window.__a3dIsRibbonTab&&window.__a3dIsRibbonTab('a3ddraft')){
        var dt=document.querySelector('[data-acad-tab="a3ddraft"]');
        if(dt){
          var all=document.querySelectorAll('#acad-tabs .acad-tab'),q;
          for(q=0;q<all.length;q++)all[q].classList.remove('active');
          dt.classList.add('active');
          window.renderA3dPanels('a3ddraft');
        }
      }
      try{window.toast&&toast('Workspace: Drafting & Annotation (plan view)');}catch(e){}
    });
    m.querySelector('[data-wsm="3d"]').addEventListener('click',function(){
      m.classList.remove('show');
      window.ACAD_WS_CUR='3d';
      try{
        if(window.__a3dEnter)window.__a3dEnter();
        if(window.__a3dSet3DView)window.__a3dSet3DView();
        window.toast&&toast('Workspace: 3D');
      }catch(e){}
      acadApplyWorkspace('3d');
      if(window.renderA3dPanels){
        var at=document.querySelector('[data-acad-tab="arch"]');
        if(at){
          var all2=document.querySelectorAll('#acad-tabs .acad-tab'),q2;
          for(q2=0;q2<all2.length;q2++)all2[q2].classList.remove('active');
          at.classList.add('active');
          window.renderA3dPanels('arch');
        }
      }
    });
    return m;
  }
  document.addEventListener('click',function(e){
    var ws=e.target.closest&&e.target.closest('#acad-shell .acad-ws');
    var menu=$('#acad-wsmenu');
    if(ws){
      e.stopPropagation();
      menu=buildWsMenu();
      var r=ws.getBoundingClientRect();
      menu.style.left=r.left+'px'; menu.style.top=(r.bottom+4)+'px';
      menu.classList.toggle('show');
      return;
    }
    if(menu&&menu.classList.contains('show')&&!e.target.closest('#acad-wsmenu')) menu.classList.remove('show');
  },true);

  // ============ 5. MODEL / LAYOUT TABS + PAPER SPACE ============
  var LKEY='acadLayoutsV1';
  var space='model';
  function layData(){ try{return JSON.parse(localStorage.getItem(LKEY)||'{}');}catch(e){return {};} }
  function saveLay(d){ try{localStorage.setItem(LKEY,JSON.stringify(d));}catch(e){} }
  function activeDwg(){ return dwgData().active||'d1'; }
  function layoutsFor(id){ var d=layData(); if(!d[id]){ d[id]=['Layout1']; saveLay(d); } return d[id]; }
  function buildStrip(){
    var s=$('#acad-mltabs');
    if(!s){ s=document.createElement('div'); s.id='acad-mltabs'; document.body.appendChild(s); }
    var id=activeDwg(), lays=layoutsFor(id);
    var html='<button data-ml="model"'+(space==='model'?' class="active"':'')+'>Model</button>';
    lays.forEach(function(n,i){ html+='<button data-ml="lay:'+i+'"'+(space==='lay:'+i?' class="active"':'')+'>'+String(n).replace(/[&<>]/g,'')+'<span class="ml-x" data-mlx="'+i+'" title="Close layout">\u00d7</span></button>'; });
    html+='<button class="ml-plus" data-ml="plus" title="New layout">+</button>';
    s.innerHTML=html;
  }
  function layoutEl(){
    var el=$('#acad-layout');
    if(!el){
      el=document.createElement('div'); el.id='acad-layout';
      el.innerHTML='<div class="al-paper"><div class="al-margin"></div><canvas></canvas><div class="al-vpframe"></div><div class="al-label"></div></div>';
      document.body.appendChild(el);
      el.querySelector('canvas').addEventListener('dblclick',function(){ setSpace('model'); });
    }
    return el;
  }
  function renderLayout(){
    var el=layoutEl();
    var paper=el.querySelector('.al-paper');
    var availW=el.clientWidth-90, availH=el.clientHeight-70;
    var w=availW, h=w/1.414;
    if(h>availH){ h=availH; w=h*1.414; }
    paper.style.width=Math.max(300,w)+'px'; paper.style.height=Math.max(212,h)+'px';
    var cv=el.querySelector('canvas');
    cv.width=Math.max(1,paper.clientWidth-68); cv.height=Math.max(1,paper.clientHeight-68);
    drawWiresToCanvas(cv,state.wires||[]);
    var idx=+String(space).split(':')[1]||0;
    var name=layoutsFor(activeDwg())[idx]||'Layout1';
    el.querySelector('.al-label').textContent=name+' \u00b7 Paper space \u00b7 1:1 \u00b7 double-click the viewport to return to model space';
  }
  function setSpace(sp){
    space=sp;
    var el=layoutEl();
    if(sp==='model'){ el.classList.remove('show'); }
    else{ el.classList.add('show'); renderLayout(); }
    buildStrip();
  }
  window.__ws2Space=function(){ return {space:space,layouts:layoutsFor(activeDwg())}; };
  document.addEventListener('click',function(e){
    var mx=e.target.closest&&e.target.closest('#acad-mltabs [data-mlx]');
    if(mx){
      e.preventDefault(); e.stopPropagation();
      var mi=+mx.getAttribute('data-mlx');
      var md=layData(), mid=activeDwg();
      var arr=md[mid]||[];
      var nm=arr[mi]||('Layout'+(mi+1));
      arr.splice(mi,1);
      md[mid]=arr;
      saveLay(md);
      var cur=String(space);
      if(cur==='lay:'+mi){ setSpace('model'); }
      else if(cur.indexOf('lay:')===0&&+cur.split(':')[1]>mi){ setSpace('lay:'+(+cur.split(':')[1]-1)); }
      else buildStrip();
      try{window.toast&&toast('Closed '+nm+' (saved)');}catch(err){}
      return;
    }
    var b=e.target.closest&&e.target.closest('#acad-mltabs [data-ml]');
    if(b){
      var v=b.getAttribute('data-ml');
      if(v==='plus'){
        var d=layData(), id=activeDwg();
        if(!d[id]) d[id]=['Layout1'];
        d[id].push('Layout'+(d[id].length+1));
        saveLay(d);
        setSpace('lay:'+(d[id].length-1));
        try{window.toast&&toast('Created '+d[id][d[id].length-1]);}catch(err){}
      }
      else setSpace(v);
      return;
    }
    var dt=e.target.closest&&e.target.closest('#acad-doctabs [data-dt], #acad-start [data-open], #acad-start [data-st]');
    if(dt) setTimeout(function(){ space='model'; layoutEl().classList.remove('show'); buildStrip(); },60);
  });
  window.addEventListener('resize',function(){ if(space!=='model') renderLayout(); });
  var stripBoot=0;
  (function bootStrip(){ if(document.body.classList.contains('acad-on')||stripBoot>20){ buildStrip(); return; } stripBoot++; setTimeout(bootStrip,300); })();

  // ============ 6. DELETE KEY FOR CAD SHAPES ============
  window.__ws3Del=function(){
    try{ if(window.__draftActiveTool&&window.__draftActiveTool()) return false; }catch(err2){}
    var wires=state.wires||[];
    var selW=wires.filter(function(w){return w.selected;});
    if(selW.length){
      state.wires=wires.filter(function(w){return !w.selected;});
      try{save();}catch(err2){}
      try{renderAll();}catch(err2){}
      try{window.toast&&toast('Erased '+selW.length+' object'+(selW.length>1?'s':''));}catch(err2){}
      return true;
    }
    try{
      if((typeof sel!=='undefined'&&sel.size)||(typeof selEdge!=='undefined'&&selEdge)){
        deleteSelected();
        return true;
      }
    }catch(err2){}
    return false;
  };
  document.addEventListener('keydown',function(e){
    if(e.key!=='Delete'&&e.key!=='Backspace') return;
    if(e.metaKey||e.ctrlKey) return;
    var ae=document.activeElement;
    if(ae&&(ae.tagName==='TEXTAREA'||ae.tagName==='INPUT'||ae.isContentEditable)) return;
    if(e.target&&e.target.closest&&e.target.closest('input,textarea,[contenteditable="true"],.rich-editor,.rich-inspector-editor')) return;
    if(window.__ws3Del()){ e.preventDefault(); e.stopImmediatePropagation(); }
  },true);
  window.__ws3Fixes='delete,rail,tabclose,icons,3dmenu';
  window.__ws4Layers='table,bylayer,hide,lock,rename';

  }catch(err){ window.__ws2Err=String(err&&err.stack||err); }
})();
</script>

<script>
/* a3d_engine.js v2 - 3D (Part) workspace integrated into the AutoCAD-style shell.
   Original implementation of the parametric solid primitives (box, cylinder,
   sphere, cone, torus, tube, prism, wedge, ellipsoid) and their parameters.
   ES5 only. Injected as the final script block by patch_3d.py. */
(function(){
try{
  var LSK='acad3dV1';
  var SCALE=0.35;
  var DEFCAM={yaw:-0.7,pitch:0.42,dist:30,tx:0,ty:1,tz:0};
  var A3D={
    on:false, sel:null, sel2:null, view:'Home', frames:0, seq:1, built:false,
    flat:false, navMode:'orbit', sk:null, prevCam:null, prevView:null,
    /* __acad3dV60: Phase 52a. A runtime view toggle, not a saved project field -- deliberately not
       part of bimSnapshotState/bimBuildProjectEnvelope, the same way camera orbit state (A3D.cam)
       and A3D.flat itself are ephemeral rather than persisted. Starts false so a freshly loaded
       project renders exactly as it always has. */
    presentMode:false,
    cam:{yaw:DEFCAM.yaw,pitch:DEFCAM.pitch,dist:DEFCAM.dist,tx:DEFCAM.tx,ty:DEFCAM.ty,tz:DEFCAM.tz},
    objs:[], counts:{}, lastPolys:[], cubePolys:[], homeRect:null, meshes:{}, grips:[], selSet:[], section:null,
    views:[], activeViewId:null, levelFilter:false, types:null, activeWallType:null, grids:[],
    levels:[{id:'lvl-0',name:'Level 0',elev:0,height:3,buildingId:'bldg-0'}], activeLevel:'lvl-0',
    buildings:[{id:'bldg-0',name:'Building 1'}], activeBuilding:'bldg-0',
    site:{name:'Site'},
    layers:[{id:'layer-0',name:'Model',color:'#7f9db8',visible:true,locked:false}], activeLayer:'layer-0',
    sheets:[], activeSheetId:null, sheetSelVp:null, sheetDrag:null,
    titleBlock:{project:'',client:'',drawnBy:'',checkedBy:''}, sheetCapture:false,
    conPick:null, classifications:[]
  };
  var el={};
  try{
    var raw=localStorage.getItem(LSK);
    if(raw){
      var st=JSON.parse(raw);
      if(st&&st.objs&&st.objs.length){A3D.objs=st.objs;}
      if(st&&st.cam&&typeof st.cam.dist==='number'){A3D.cam=st.cam;}
      if(st&&typeof st.seq==='number'){A3D.seq=st.seq;}
      if(st&&st.counts){A3D.counts=st.counts;}
      if(st&&st.levels){
        if(Array.isArray(st.levels)&&st.levels.length&&st.levels.every(function(L){return L&&typeof L.id==='string'&&isFinite(L.elev)&&isFinite(L.height);})){
          A3D.levels=st.levels;
        }else{
          console.warn('[BIM] Corrupted level data in '+LSK+' storage; falling back to default levels.');
        }
      }
      if(st&&typeof st.activeLevel==='string')A3D.activeLevel=st.activeLevel;
      if(st&&Array.isArray(st.grids)){
        A3D.grids=st.grids.filter(function(g){
          return g&&typeof g.id==='string'&&g.p1&&g.p2&&g.p1.length===2&&g.p2.length===2;
        });
        if(A3D.grids.length!==st.grids.length)console.warn('[BIM] Discarded malformed grid datums from '+LSK+' storage.');
      }
      if(st&&st.types&&typeof st.types==='object')A3D.types=st.types;
      if(st&&typeof st.activeWallType==='string')A3D.activeWallType=st.activeWallType;
      if(st&&Array.isArray(st.views))A3D.views=st.views;
      if(st&&typeof st.activeViewId==='string')A3D.activeViewId=st.activeViewId;
      if(st&&typeof st.levelFilter==='boolean')A3D.levelFilter=st.levelFilter;
      if(st&&st.layers){
        if(Array.isArray(st.layers)&&st.layers.length&&st.layers.every(function(L){return L&&typeof L.id==='string'&&typeof L.name==='string';})){
          A3D.layers=st.layers;
        }else{
          console.warn('[BIM] Corrupted layer data in '+LSK+' storage; falling back to default layers.');
        }
      }
      if(st&&typeof st.activeLayer==='string')A3D.activeLayer=st.activeLayer;
      if(st&&Array.isArray(st.sheets)){
        A3D.sheets=st.sheets.filter(function(s){
          return s&&typeof s.id==='string'&&isFinite(s.w)&&isFinite(s.h)&&Array.isArray(s.viewports);
        });
        if(A3D.sheets.length!==st.sheets.length)console.warn('[BIM] Discarded malformed sheet(s) from '+LSK+' storage.');
      }
      if(st&&st.titleBlock&&typeof st.titleBlock==='object')A3D.titleBlock=st.titleBlock;
      if(st&&Array.isArray(st.buildings)){
        var goodBldgs=st.buildings.filter(function(b){return b&&typeof b.id==='string'&&typeof b.name==='string';});
        if(goodBldgs.length){
          A3D.buildings=goodBldgs;
          if(goodBldgs.length!==st.buildings.length)console.warn('[BIM] Discarded malformed building(s) from '+LSK+' storage.');
        }else{
          console.warn('[BIM] Corrupted building data in '+LSK+' storage; falling back to default building.');
        }
      }
      if(st&&typeof st.activeBuilding==='string')A3D.activeBuilding=st.activeBuilding;
      if(st&&st.site&&typeof st.site==='object'&&typeof st.site.name==='string')A3D.site=st.site;
      if(st&&Array.isArray(st.classifications)){
        A3D.classifications=st.classifications.filter(function(c){return c&&typeof c.id==='string'&&typeof c.code==='string';});
        if(A3D.classifications.length!==st.classifications.length)console.warn('[BIM] Discarded malformed classification(s) from '+LSK+' storage.');
      }
    }
  }catch(e0){
    console.warn('[BIM] Failed to restore 3D/BIM state from localStorage; starting from defaults.',e0);
  }

  function vsub(a,b){return [a[0]-b[0],a[1]-b[1],a[2]-b[2]];}
  function vcross(a,b){return [a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];}
  function vdot(a,b){return a[0]*b[0]+a[1]*b[1]+a[2]*b[2];}
  function vnorm(a){var l=Math.sqrt(vdot(a,a))||1;return [a[0]/l,a[1]/l,a[2]/l];}
  var LIGHT=vnorm([0.5,0.8,0.6]);
  function faceNormal(pts){
    var n=[0,0,0],i,p,q;
    for(i=0;i<pts.length;i++){
      p=pts[i];q=pts[(i+1)%pts.length];
      n[0]+=(p[1]-q[1])*(p[2]+q[2]);
      n[1]+=(p[2]-q[2])*(p[0]+q[0]);
      n[2]+=(p[0]-q[0])*(p[1]+q[1]);
    }
    return vnorm(n);
  }

  function mkMesh(v,f){return {v:v,f:f};}
  function mkBoxP(lx,ly,lz){
