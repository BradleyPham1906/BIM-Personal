  ];

  // ─ Build shell ─
  var shell=document.createElement('div');shell.id='acad-shell';
  // QAT
  var qat=document.createElement('div');qat.id='acad-qat';
  var QAT=[['saveJson','Save'],['openJson','Open'],'|',['undo','Undo'],['redo','Redo'],'|',['print','Plot']];
  qat.innerHTML='<div class="acad-logo" title="Ultimate Canvas">A</div>'+QAT.map(function(q){
    if(q==='|')return '<div class="acad-qsep"></div>';
    return '<button class="acad-qbtn" data-acad-act="'+q[0]+'" title="'+q[1]+'">'+iconFor(q[0])+'</button>';
  }).join('')+'<div class="acad-ws">Drafting &amp; Annotation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><div class="acad-spring"></div>';
  shell.appendChild(qat);
  // Tabs
  var tabsEl=document.createElement('div');tabsEl.id='acad-tabs';
  tabsEl.innerHTML=TABS.map(function(t,i){return '<button class="acad-tab'+(i===0?' active':'')+'" data-acad-tab="'+t.id+'">'+t.name+'</button>'}).join('');
  shell.appendChild(tabsEl);
  // Panels
  var panelsEl=document.createElement('div');panelsEl.id='acad-panels';
  shell.appendChild(panelsEl);
  // Doc tabs
  var dt=document.createElement('div');dt.id='acad-doctabs';
  dt.innerHTML='<button class="acad-doctab">Start</button><button class="acad-doctab active">Drawing1</button><button class="acad-doctab acad-plus" title="New drawing (coming soon)">+</button>';
  shell.appendChild(dt);

  function chunk3(arr){var cols=[];for(var i=0;i<arr.length;i+=3)cols.push(arr.slice(i,i+3));return cols}
  window.__acadRenderTab=function(id){try{renderTab(id);}catch(e){}};
  function renderTab(tabId){
    var tab=null;for(var i=0;i<TABS.length;i++)if(TABS[i].id===tabId)tab=TABS[i];
    if(!tab)return;
    var html='';
    tab.panels.forEach(function(p,pi){
      if(pi>0)html+='<div class="acad-vsep"></div>';
      var body='';
      (p.big||[]).forEach(function(b){
        var tool=TOOLMAP[b[0]]?' data-tool="'+TOOLMAP[b[0]]+'"':'';
        body+='<button class="acad-big" data-acad-act="'+b[0]+'"'+tool+' title="'+b[1].replace(/\n/g,' ')+'">'+iconFor(b[0])+'<span>'+b[1].split('\n')[0]+'</span></button>';
      });
      if(p.small&&p.small.length){
        chunk3(p.small).forEach(function(col){
          body+='<div class="acad-col">'+col.map(function(s){
            var tool=TOOLMAP[s[0]]?' data-tool="'+TOOLMAP[s[0]]+'"':'';
            return '<button class="acad-sm" data-acad-act="'+s[0]+'"'+tool+' title="'+s[1]+'">'+iconFor(s[0])+'<span>'+s[1]+'</span></button>';
          }).join('')+'</div>';
        });
      }
      html+='<div class="acad-panel"><div class="acad-panel-body">'+body+'</div><div class="acad-panel-title">'+p.t+' <span class="acad-caret">\u25be</span></div></div>';
    });
    panelsEl.innerHTML=html;
  }
  renderTab('home');

  // ─ Events ─
  shell.addEventListener('click',function(e){
    var tb=e.target.closest('[data-acad-tab]');
    if(tb){$$('.acad-tab',tabsEl).forEach(function(x){x.classList.toggle('active',x===tb)});var _tid=tb.dataset.acadTab;if(window.__a3dIsRibbonTab&&window.__a3dIsRibbonTab(_tid)){window.renderA3dPanels(_tid);return}renderTab(_tid);return}
    var ab=e.target.closest('[data-acad-act]');
    if(ab){dispatch(ab.dataset.acadAct)}
  });
  // ─ Active tool highlight sync ─
  setInterval(function(){
    var t=null;try{t=window.__draftActiveTool&&window.__draftActiveTool()}catch(e){}
    $$('#acad-panels [data-tool]').forEach(function(b){b.classList.toggle('active',!!t&&b.dataset.tool===t)});
  },350);

  document.body.appendChild(shell);
  document.body.classList.add('acad-on');
  }catch(err){/* fail open: keep the other toolbar if anything goes wrong */ try{document.body.classList.remove('acad-on')}catch(e){} }
})();
</script>

<style id="acad-pro-css">
/* ============================================================
   AutoCAD Pro engine: status bar + interactive modify previews
   ============================================================ */
#acad-status{position:fixed;left:0;right:0;bottom:0;height:26px;z-index:9650;display:flex;align-items:center;gap:8px;padding:0 10px;background:#1d2022;border-top:1px solid #101214;font:11px/1 "Segoe UI",Inter,system-ui,sans-serif;color:#a9abae;user-select:none}
#acadst-hint{color:#d5d7da;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:46vw}
#acad-status .acadst-spring{flex:1}
#acadst-coords{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:10.5px;color:#8f9296;min-width:150px;text-align:right}
.acadst-tog{height:20px;padding:0 10px;border:0;border-radius:3px;background:#26282b;color:#a9abae;font:inherit;font-weight:700;letter-spacing:.03em;cursor:pointer}
.acadst-tog:hover{background:#3a3d40;color:#fff}
.acadst-tog.on{background:#1f4f7d;color:#fff}
body.acad-on #viewport{height:calc(100vh - 196px) !important}
/* __acad3dV64 (shell unification, step 2): one work-area contract for every workspace --
   "the drawing surface begins where the left dock ends."

   #acad3d has always honoured that (left:var(--figma-dock-w,0px)); #viewport never did. It
   inherited left:0 from its `inset:0` base rule, so the Canvas board ran full-bleed UNDERNEATH
   the file dock while the BIM shell started beside it. Switching workspaces therefore moved the
   origin of the work surface, and board content that had been hidden under the dock appeared to
   jump out from behind it.

   Binding #viewport to the same custom property makes the rule identical in both directions and
   self-maintaining: --figma-dock-w is already kept current by __figmaDockSyncW() whenever the
   dock expands or collapses, so neither surface can drift from the other again. The two modes
   still resolve to different pixel values (296px with the dock's panel open in Canvas, 54px with
   it collapsed to its rail in Drafting/3D) -- that is correct, not a leftover inconsistency: the
   contract is "after the left panel," and each mode's left panel is a different width. What is
   gone is a surface silently extending under another one. */
body.acad-on #viewport{left:var(--figma-dock-w,0px) !important;width:auto !important;right:0 !important}
body.acad-on #zoombar{bottom:36px !important}
body.acad-on #hint{bottom:36px !important}
#acadpro-overlay{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:60}
#viewport.acadpro-pick, #viewport.acadpro-pick *{cursor:crosshair !important}
/* dock the command bar above the status bar, clear of the left layers panel */
body.acad-on #cad-cmdbar{position:fixed !important;left:304px !important;right:10px !important;bottom:32px !important;width:auto !important;z-index:9500 !important;border-radius:4px}
</style>
<script>
// AutoCAD Pro engine: real MOVE/COPY/ROTATE/SCALE/MIRROR/OFFSET,
// command-line coordinate entry, bottom status bar.
(function acadProEngine(){
  if(window.__acadProV1) return; window.__acadProV1=true;
  try{
  var VP=document.getElementById('viewport');
  if(!VP) return;
  function cam(){
    var r=VP.getBoundingClientRect();
    try{
      if(window.toWorld){
        var a=window.toWorld(r.left,r.top), b=window.toWorld(r.left+100,r.top);
        var z=100/((b.x-a.x)||100);
        return {ox:a.x,oy:a.y,z:z,r:r};
      }
    }catch(e){}
    var v=window.view||{x:0,y:0,z:1};
    return {ox:-v.x/v.z,oy:-v.y/v.z,z:v.z,r:r};
  }
  function S(){ return window.state||{}; }
  function wires(){ var s=S(); if(!s.wires) s.wires=[]; return s.wires; }
  function nodes(){ var s=S(); return s.nodes||[]; }
  function worldOf(e){ return window.toWorld ? window.toWorld(e.clientX,e.clientY) : {x:e.clientX,y:e.clientY}; }
  function scr(p){ var c=cam(); return {x:(p.x-c.ox)*c.z, y:(p.y-c.oy)*c.z}; }
  function newId(){ try{ if(typeof window.nid==='function') return window.nid(); }catch(e){}
    return 'w'+Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
  function persist(){ try{ window.save && window.save(); }catch(e){} }
  function rerender(){ try{ window.__draftRenderWires && window.__draftRenderWires(); }catch(e){}
    try{ window.renderAll && window.renderAll(); }catch(e){} }
  function toastMsg(m){ try{ window.toast && window.toast(m); }catch(e){} }

  // ---------- geometry helpers ----------
  function dist(a,b){ return Math.hypot(b.x-a.x,b.y-a.y); }
  function distSeg(p,a,b){
    var dx=b.x-a.x, dy=b.y-a.y, L2=dx*dx+dy*dy;
    if(L2<1e-12) return dist(p,a);
    var t=((p.x-a.x)*dx+(p.y-a.y)*dy)/L2; t=Math.max(0,Math.min(1,t));
    return Math.hypot(p.x-(a.x+t*dx), p.y-(a.y+t*dy));
  }
  function segsOf(w){
    var pts=w.points||[], out=[];
    for(var i=0;i<pts.length-1;i++) out.push([pts[i],pts[i+1]]);
    if(w.closed&&pts.length>2) out.push([pts[pts.length-1],pts[0]]);
    return out;
  }
  function hitWire(w,p,tol){
    if(w.type==='circle'&&typeof w.cx==='number'&&typeof w.radius==='number')
      return Math.abs(Math.hypot(p.x-w.cx,p.y-w.cy)-w.radius)<=tol;
    var sg=segsOf(w);
    for(var i=0;i<sg.length;i++) if(distSeg(p,sg[i][0],sg[i][1])<=tol) return true;
    return false;
  }
  function pickAt(p){
    var tol=8/(cam().z||1);
    var ws=wires();
    for(var i=ws.length-1;i>=0;i--) if(hitWire(ws[i],p,tol)) return {kind:'wire',obj:ws[i]};
    var ns=nodes();
    for(var j=ns.length-1;j>=0;j--){ var n=ns[j];
      if(typeof n.x==='number'&&typeof n.w==='number'&&p.x>=n.x&&p.x<=n.x+n.w&&p.y>=n.y&&p.y<=n.y+n.h) return {kind:'node',obj:n}; }
    return null;
  }

  // transforms: fn maps a world point {x,y} -> {x,y}
  function xfWire(w,fn,scaleFactor){
    if(w.points) w.points=w.points.map(function(p){ var q=fn(p); return {x:q.x,y:q.y}; });
    if(w.type==='circle'&&typeof w.cx==='number'){ var c=fn({x:w.cx,y:w.cy}); w.cx=c.x; w.cy=c.y;
      if(scaleFactor) w.radius=Math.abs(w.radius*scaleFactor); }
    if(typeof w.x==='number'&&typeof w.y==='number'&&!w.points){ var t=fn({x:w.x,y:w.y}); w.x=t.x; w.y=t.y; }
  }
  function xfNode(n,fn,scaleFactor){
    var cx=n.x+n.w/2, cy=n.y+n.h/2, c=fn({x:cx,y:cy});
    if(scaleFactor){ n.w=Math.max(20,n.w*scaleFactor); n.h=Math.max(20,n.h*scaleFactor); }
    n.x=c.x-n.w/2; n.y=c.y-n.h/2;
  }
  function applyXf(hit,fn,scaleFactor){
    if(hit.kind==='wire') xfWire(hit.obj,fn,scaleFactor); else xfNode(hit.obj,fn,scaleFactor);
  }
  function cloneEnt(hit){
    var c=JSON.parse(JSON.stringify(hit.obj)); c.id=newId(); c.selected=false;
    if(hit.kind==='wire') wires().push(c); else nodes().push(c);
    return {kind:hit.kind,obj:c};
  }
  function translator(dx,dy){ return function(p){ return {x:p.x+dx,y:p.y+dy}; }; }
  function rotator(b,deg){ var t=deg*Math.PI/180, c=Math.cos(t), s=Math.sin(t);
    // y-down screen space: positive deg = counter-clockwise visually
    return function(p){ var x=p.x-b.x,y=p.y-b.y; return {x:b.x+x*c+y*s, y:b.y-x*s+y*c}; }; }
  function scaler(b,f){ return function(p){ return {x:b.x+(p.x-b.x)*f, y:b.y+(p.y-b.y)*f}; }; }
  function reflector(a1,a2){
    var dx=a2.x-a1.x, dy=a2.y-a1.y, L2=dx*dx+dy*dy;
    if(L2<1e-12) return function(p){return p;};
    return function(p){ var t=((p.x-a1.x)*dx+(p.y-a1.y)*dy)/L2;
      var fx=a1.x+t*dx, fy=a1.y+t*dy;
      return {x:2*fx-p.x, y:2*fy-p.y}; };
  }
  function lineIntersect(p1,p2,p3,p4){
    var d=(p2.x-p1.x)*(p4.y-p3.y)-(p2.y-p1.y)*(p4.x-p3.x);
    if(Math.abs(d)<1e-9) return null;
    var t=((p3.x-p1.x)*(p4.y-p3.y)-(p3.y-p1.y)*(p4.x-p3.x))/d;
    return {x:p1.x+t*(p2.x-p1.x), y:p1.y+t*(p2.y-p1.y)};
  }
  function offsetPolyline(pts,closed,d,toward){
    // side from nearest segment
    var best=1e18,bi=0;
    for(var i=0;i<pts.length-1;i++){ var dd=distSeg(toward,pts[i],pts[i+1]); if(dd<best){best=dd;bi=i;} }
    var ax=pts[bi].x,ay=pts[bi].y,bx=pts[bi+1].x,by=pts[bi+1].y;
    var cross=(bx-ax)*(toward.y-ay)-(by-ay)*(toward.x-ax);
    var s=cross>=0?1:-1;
    // offset each segment
    var offSegs=[];
    for(var j=0;j<pts.length-1;j++){
      var dx=pts[j+1].x-pts[j].x, dy=pts[j+1].y-pts[j].y, L=Math.hypot(dx,dy)||1;
      var nx=-dy/L*s*d, ny=dx/L*s*d;
      offSegs.push([{x:pts[j].x+nx,y:pts[j].y+ny},{x:pts[j+1].x+nx,y:pts[j+1].y+ny}]);
    }
    var out=[offSegs[0][0]];
    for(var k=0;k<offSegs.length-1;k++){
      var ip=lineIntersect(offSegs[k][0],offSegs[k][1],offSegs[k+1][0],offSegs[k+1][1]);
      out.push(ip||{x:(offSegs[k][1].x+offSegs[k+1][0].x)/2,y:(offSegs[k][1].y+offSegs[k+1][0].y)/2});
    }
    out.push(offSegs[offSegs.length-1][1]);
    return out;
  }

  // ---------- overlay ----------
  var overlay=document.createElementNS('http://www.w3.org/2000/svg','svg');
  overlay.id='acadpro-overlay';
  VP.appendChild(overlay);
  function entSvg(hit,fn,stroke,dash,scaleFactor){
    var st=' fill="none" stroke="'+stroke+'" stroke-width="1.5"'+(dash?' stroke-dasharray="5 4"':'');
    var o=hit.obj;
    if(hit.kind==='node'){
      var q=fn?fn:function(p){return p;};
      var w2=o.w*(scaleFactor||1), h2=o.h*(scaleFactor||1);
      var c=q({x:o.x+o.w/2,y:o.y+o.h/2}), tl=scr({x:c.x-w2/2,y:c.y-h2/2});
      var zz=cam().z;
      return '<rect x="'+tl.x+'" y="'+tl.y+'" width="'+(w2*zz)+'" height="'+(h2*zz)+'"'+st+'/>';
    }
    if(o.type==='circle'&&typeof o.cx==='number'){
      var cc=fn?fn({x:o.cx,y:o.cy}):{x:o.cx,y:o.cy};
      var sc2=scr(cc), r=(o.radius*(scaleFactor||1))*cam().z;
      return '<circle cx="'+sc2.x+'" cy="'+sc2.y+'" r="'+Math.abs(r)+'"'+st+'/>';
    }
    var pts=(o.points||[]).map(function(p){ var q=fn?fn(p):p; var sp=scr(q); return sp.x.toFixed(1)+','+sp.y.toFixed(1); });
    if(!pts.length) return '';
    var tag=o.closed?'polygon':'polyline';
    return '<'+tag+' points="'+pts.join(' ')+'"'+st+'/>';
  }
  function rubber(a,b,color){
    var sa=scr(a), sb=scr(b);
    return '<line x1="'+sa.x+'" y1="'+sa.y+'" x2="'+sb.x+'" y2="'+sb.y+'" stroke="'+(color||'#9aa1a8')+'" stroke-width="1" stroke-dasharray="4 4"/>';
  }
  function clearOverlay(){ overlay.innerHTML=''; }

  // ---------- status bar ----------
  var sb=document.createElement('div'); sb.id='acad-status';
  sb.innerHTML='<span id="acadst-hint"></span><span class="acadst-spring"></span>'+
    '<span id="acadst-coords">0.00, 0.00</span>'+
    '<button class="acadst-tog" data-acadst="grid" title="Display grid (F7)">GRID</button>'+
    '<button class="acadst-tog" data-acadst="ortho" title="Ortho mode (F8)">ORTHO</button>'+
    '<button class="acadst-tog" data-acadst="polar" title="Polar tracking (F10)">POLAR</button>'+
    '<button class="acadst-tog" data-acadst="osnap" title="Object snap (F9)">OSNAP</button>';
  document.body.appendChild(sb);
  var hintEl=document.getElementById('acadst-hint');
  var coordsEl=document.getElementById('acadst-coords');
  function hint(m){ hintEl.textContent=m||''; }
  sb.addEventListener('click',function(e){
    var b=e.target.closest('[data-acadst]'); if(!b) return;
    var k=b.dataset.acadst;
    if(k==='grid'){ window.cadRun&&window.cadRun('grid'); b.classList.toggle('on'); }
    else if(k==='ortho'){ document.dispatchEvent(new KeyboardEvent('keydown',{key:'F8',bubbles:true,cancelable:true})); }
    else if(k==='polar'){ window.cadRun&&window.cadRun('polarToggle'); b.classList.toggle('on'); }
    else if(k==='osnap'){ window.cadRun&&window.cadRun('snapToggle'); }
    setTimeout(syncTogs,80);
  });
  function syncTogs(){
    var C=window.CAD||{};
    var ob=sb.querySelector('[data-acadst="ortho"]');
    if(ob) ob.classList.toggle('on',!!C.orthoOn);
    var osb=sb.querySelector('[data-acadst="osnap"]');
    if(osb&&typeof C.snapOn==='boolean') osb.classList.toggle('on',C.snapOn);
    var gb=sb.querySelector('[data-acadst="grid"]');
    if(gb&&!gb.dataset.manual) gb.classList.toggle('on',!document.body.classList.contains('grid-off'));
    var pb=sb.querySelector('[data-acadst="polar"]');
    if(pb&&(typeof window.__polarTrackingOn==='boolean'||typeof window.__cadPolarOn==='boolean'))
      pb.classList.toggle('on',!!(window.__polarTrackingOn||window.__cadPolarOn));
  }
  setInterval(syncTogs,500); setTimeout(syncTogs,900);
  // safety: if the command bar still overlaps the status bar, nudge it up
  setTimeout(function(){
    var cb=document.getElementById('cad-cmdbar');
    if(cb){ var r=cb.getBoundingClientRect(), s=sb.getBoundingClientRect();
      if(r.bottom>s.top) cb.style.transform='translateY(-'+((r.bottom-s.top)+4)+'px)'; }
  },600);

  // ---------- interactive command state machine ----------
  var cmd=null, cursor=null, lastPoint=null, offsetDist=20;
  var PROMPT={
    move:{pick:'MOVE  Select object:',base:'MOVE  Specify base point:',dest:'MOVE  Specify second point (or type x,y / @dx,dy / @r<a):'},
    copy:{pick:'COPY  Select object:',base:'COPY  Specify base point:',dest:'COPY  Specify second point — Enter/Esc to finish:'},
    rotate:{pick:'ROTATE  Select object:',base:'ROTATE  Specify base point:',angle:'ROTATE  Specify rotation angle (drag or type degrees):'},
    scale:{pick:'SCALE  Select object:',base:'SCALE  Specify base point:',factor:'SCALE  Specify scale factor (drag or type number):'},
    mirror:{pick:'MIRROR  Select object:',axis1:'MIRROR  Specify first point of mirror line:',axis2:'MIRROR  Specify second point of mirror line:'},
    offset:{pick:'OFFSET ['+offsetDist+']  Type distance or select object:',side:'OFFSET  Click the side to offset toward:'}
  };
  function startCmd(name){
    endCmd(true);
    try{ window.__draftCancelTool && window.__draftCancelTool(); }catch(e){}
    cmd={name:name,step:'pick'};
    if(name==='offset') PROMPT.offset.pick='OFFSET ['+offsetDist+']  Type distance or select object:';
    hint(PROMPT[name].pick);
    toastMsg(name.toUpperCase()+': '+(name==='offset'?('distance '+offsetDist+' — type a number to change, then click an object'):'click an object'));
    VP.classList.add('acadpro-pick');
  }
  function endCmd(silent){
    cmd=null; clearOverlay(); VP.classList.remove('acadpro-pick');
    if(!silent) hint('');
  }
  function finishOp(msg){
    persist(); rerender(); clearOverlay();
    if(msg) toastMsg(msg);
  }
  function feedPoint(p){
    if(!cmd) return;
    lastPoint=p;
    var c=cmd;
    if(c.step==='pick'){
      var hit=pickAt(p);
      if(!hit){ hint(PROMPT[c.name][c.step]+'  (no object there)'); return; }
      c.picked=hit; c.pickPt=p;
      if(c.name==='mirror'){ c.step='axis1'; }
      else if(c.name==='offset'){ c.step='side'; }
      else { c.step='base'; }
      hint(PROMPT[c.name][c.step]); updatePreview(); return;
    }
    if(c.step==='base'){ c.base=p; c.refD=null;
      c.step=(c.name==='rotate')?'angle':(c.name==='scale')?'factor':'dest';
      hint(PROMPT[c.name][c.step]); updatePreview(); return; }
    if(c.step==='dest'){
      var dx=p.x-c.base.x, dy=p.y-c.base.y;
      if(c.name==='move'){ applyXf(c.picked,translator(dx,dy)); finishOp('Moved 1 object'); endCmd(); return; }
      // copy: place a copy, stay active
      var cp=cloneEnt(c.picked); applyXf(cp,translator(dx,dy));
      finishOp('Copied 1 object'); hint(PROMPT.copy.dest); return;
    }
    if(c.step==='angle'){
      var deg=curAngle(p); applyXf(c.picked,rotator(c.base,deg));
      finishOp('Rotated '+deg.toFixed(1)+'\u00b0'); endCmd(); return;
    }
    if(c.step==='factor'){
      var f=curFactor(p);
      applyXf(c.picked,scaler(c.base,f),f);
      finishOp('Scaled \u00d7'+f.toFixed(3)); endCmd(); return;
    }
    if(c.step==='axis1'){ c.a1=p; c.step='axis2'; hint(PROMPT.mirror.axis2); updatePreview(); return; }
    if(c.step==='axis2'){
      var cp2=cloneEnt(c.picked); applyXf(cp2,reflector(c.a1,p));
      finishOp('Mirrored 1 object (source kept)'); endCmd(); return;
    }
    if(c.step==='side'){
      applyOffset(c.picked,p);
      finishOp('Offset '+offsetDist);
      c.picked=null; c.step='pick'; hint(PROMPT.offset.pick+'  (Esc to finish)');
      return;
    }
  }
  function applyOffset(hit,toward){
    if(hit.kind==='node'){ toastMsg('OFFSET supports lines, polylines and circles'); return; }
    var w=hit.obj;
    if(w.type==='circle'&&typeof w.cx==='number'){
      var out=Math.hypot(toward.x-w.cx,toward.y-w.cy)>w.radius;
      var c=JSON.parse(JSON.stringify(w)); c.id=newId(); c.selected=false;
      c.radius=Math.max(0.5,w.radius+(out?offsetDist:-offsetDist));
      wires().push(c); return;
    }
    var pts=w.points||[];
    if(pts.length<2){ toastMsg('OFFSET supports lines, polylines and circles'); return; }
    var c2=JSON.parse(JSON.stringify(w)); c2.id=newId(); c2.selected=false;
    c2.points=offsetPolyline(pts,!!w.closed,offsetDist,toward);
    wires().push(c2);
  }
  function curAngle(p){
    var a=Math.atan2(-(p.y-cmd.base.y),p.x-cmd.base.x)*180/Math.PI;
    return a;
  }
  function curFactor(p){
    var ref=cmd.refD||dist(cmd.base,cmd.pickPt)||100;
    if(ref<1e-6) ref=100;
    var f=dist(cmd.base,p)/ref;
    return Math.max(0.001,f);
  }
  function updatePreview(){
    if(!cmd||!cmd.picked){ return; }
    var c=cmd, html=entSvg(c.picked,null,'#f59e0b',true);
    if(cursor){
      if(c.step==='dest'&&c.base){
        var fn=translator(cursor.x-c.base.x,cursor.y-c.base.y);
        html+=rubber(c.base,cursor)+entSvg(c.picked,fn,'#38bdf8',true);
      } else if(c.step==='angle'&&c.base){
        var deg=curAngle(cursor);
        html+=rubber(c.base,cursor)+entSvg(c.picked,rotator(c.base,deg),'#38bdf8',true);
        var sp=scr(cursor);
        html+='<text x="'+(sp.x+10)+'" y="'+(sp.y-8)+'" fill="#38bdf8" font-size="11">'+deg.toFixed(1)+'\u00b0</text>';
      } else if(c.step==='factor'&&c.base){
