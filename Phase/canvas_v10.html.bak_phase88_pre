    var savedFlat=A3D.flat,savedActiveLevel=A3D.activeLevel,savedLevelFilter=A3D.levelFilter,
        savedActiveViewId=A3D.activeViewId,savedSection=A3D.section,savedSel=A3D.sel,savedSel2=A3D.sel2,
        savedView=A3D.view;
    try{
