  document.addEventListener('pointerdown',e=>{ if(!e.target.closest('#uploaded-command-palette')) closePalette(); },true);
})();
</script>
<script>

// Developed Figma-like File / Assets / Tools sidebar tabs.
(function developFigmaSidebarTabs(){
  if(window.__developedFigmaSidebarTabs)return; window.__developedFigmaSidebarTabs=true;
  const $=(q,r=document)=>r.querySelector(q); const $$=(q,r=document)=>Array.from(r.querySelectorAll(q));
  const mod=(navigator.platform||'').toLowerCase().includes('mac')?'⌘':'Ctrl';
  function icon(name){const m={card:'<rect x="3" y="4" width="14" height="10" rx="2"/><path d="M6 8h8M6 11h5"/>',text:'<path d="M4 4h10M9 4v10M7 14h4"/>',table:'<rect x="3" y="4" width="14" height="10" rx="1"/><path d="M3 8h14M8 4v10M12 4v10"/>',chart:'<path d="M3 15h12"/><rect x="5" y="9" width="2" height="4"/><rect x="8.5" y="5" width="2" height="8"/><rect x="12" y="7" width="2" height="6"/>',board:'<path d="M4 13c3-7 6 1 10-6"/>',shape:'<rect x="3" y="3" width="5" height="5"/><circle cx="13" cy="5.5" r="2.5"/><path d="m9 15 3-5 3 5z"/>',image:'<rect x="3" y="4" width="12" height="10" rx="1"/><path d="m4 12 3-3 2 2 2-3 3 4"/>',select:'<path d="M4 3l6 13 2-5 5-2z"/>',pan:'<path d="M7 9V5a1.2 1.2 0 0 1 2.4 0v4M9.4 8V4a1.2 1.2 0 0 1 2.4 0v5M12 8.5V6a1.2 1.2 0 0 1 2.4 0v4c0 3-1.8 5-5 5-2 0-3.3-.9-4.1-2L3.6 10.8a1.2 1.2 0 0 1 1.8-1.6L7 11"/>',cmd:'<path d="M6 6h6v6H6z"/><path d="M3 3h2v2H3zM13 3h2v2h-2zM3 13h2v2H3zM13 13h2v2h-2z"/>',upload:'<path d="M9 13V4"/><path d="m5 8 4-4 4 4"/><path d="M4 14h10"/>',group:'<rect x="3" y="3" width="12" height="12" rx="1" stroke-dasharray="2 2"/>',fit:'<path d="M3 7V3h4M11 3h4v4M15 11v4h-4M7 15H3v-4"/>'};return `<svg viewBox="0 0 18 18">${m[name]||m.shape}</svg>`}
