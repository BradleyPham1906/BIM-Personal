  const commands=[
    {label:'Select tool',key:'⌘/Ctrl V',run:()=>setTool&&setTool('select')},
    {label:'Pan tool',key:'⌘/Ctrl H',run:()=>setTool&&setTool('pan')},
    {label:'Add card',key:'⌘/Ctrl N',run:()=>{const p=toWorld?toWorld(innerWidth/2,innerHeight/2):{x:200,y:200};addCard&&addCard(p.x-165,p.y-95)}},
    {label:'Add table',key:'',run:()=>{const p=toWorld?toWorld(innerWidth/2,innerHeight/2):{x:200,y:200};addTable&&addTable(p.x-210,p.y-125)}},
    {label:'Add chart',key:'',run:()=>{const p=toWorld?toWorld(innerWidth/2,innerHeight/2):{x:200,y:200};addChart&&addChart(p.x-190,p.y-125)}},
    {label:'Duplicate selected',key:'⌘/Ctrl D',run:()=>duplicateSelected&&duplicateSelected()},
    {label:'Delete selected',key:'⌘/Ctrl Del',run:()=>deleteSelected&&deleteSelected()},
    {label:'Zoom to fit',key:'',run:()=>zoomToFit&&zoomToFit()},
    {label:'Toggle theme',key:'',run:()=>$('#t-theme')?.click()},
    {label:'Toggle layers',key:'',run:()=>$('#uploaded-layers-panel')?.classList.toggle('layer-mini')}
