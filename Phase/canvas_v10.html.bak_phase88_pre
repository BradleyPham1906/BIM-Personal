#fc-menubar {
  height: var(--fc-mb-h);
  display: flex;
  align-items: center;
  background: var(--fc-bg-mb);
  border-bottom: 1px solid var(--fc-border);
  box-shadow: var(--fc-shadow);
  padding: 0;
  gap: 0;
}

