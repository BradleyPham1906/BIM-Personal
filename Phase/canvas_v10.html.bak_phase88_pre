      }
      syncRail();
    },0);
    syncRail(); setTimeout(syncRail,60);
  },true);
  document.addEventListener('click',function(e){
    if(e.target.closest&&e.target.closest('.acad-dkbtn')){ e.preventDefault(); e.stopImmediatePropagation(); }
  },true);
  // Native File/Assets rail clicks close the CAD dock so the panels never fight.
  document.addEventListener('pointerdown',function(e){
    var nb=e.target.closest&&e.target.closest('#figma-layers-rail .fl-rail-btn:not(.acad-dkbtn), #figma-layers-rail .fl-logo');
    if(!nb) return;
    var p=document.getElementById('acad-dockpanel');
    if(p&&p.classList.contains('open')){
      var c=document.getElementById('dk-close');
      if(c) c.click();
    }
    setTimeout(syncRail,0);
  },true);
  // keep rail buttons alive if the sidebar rebuilds; keep active states synced with the panel
  var railPending=false;
  new MutationObserver(function(){
