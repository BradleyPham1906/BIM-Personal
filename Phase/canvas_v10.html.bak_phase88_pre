  width: 32px;
  height: var(--fc-mb-h);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-right: 1px solid var(--fc-border);
  padding: 0 6px;
  box-sizing: border-box;
}
.fc-logo svg { width: 16px; height: 16px; }

/* Menu items */
.fc-menu { position: relative; height: var(--fc-mb-h); display: flex; align-items: center; }

.fc-mbtn {
  height: var(--fc-mb-h);
  padding: 0 9px;
