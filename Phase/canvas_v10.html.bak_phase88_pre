    if(!root){const oldContent=panel.querySelector('.fl-tab-content');if(oldContent)oldContent.remove();root=document.createElement('div');root.className='fak-root fl-tab-content';root.innerHTML=`<div class="fak-search"><span>\u2315</span><input placeholder="Search in this library" data-fak-search></div><div class="fak-scroll" data-fak-body></div>`;panel.appendChild(root);
      root.querySelector('[data-fak-search]').addEventListener('input',e=>{stateUI.query=e.target.value.trim();paint();});
      root.addEventListener('click',e=>{
        const back=e.target.closest('[data-fak-back]'); if(back){stateUI.folder=null;paint();return;}
