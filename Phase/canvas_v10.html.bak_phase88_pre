    if(act?.startsWith('bw:')){ctxBorderW?.(act.split(':')[1]);return}
    if(act?.startsWith('bs:')){ctxBorderS?.(act.split(':')[1]);return}
    if(act?.startsWith('edge-dash:')){ctxEdgeDash?.(act.split(':')[1]);return}
    if(act?.startsWith('edge-dir:')){ctxEdgeDir?.(act.split(':')[1]);return}
    if(act?.startsWith('text-align:')&&n){n.textStyle=Object.assign({align:'left',valign:'top'},n.textStyle||{},{align:act.split(':')[1]});save();renderAll();select(n.id);return}
