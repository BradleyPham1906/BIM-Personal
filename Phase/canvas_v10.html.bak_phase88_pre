<script>
// ============================================================
// CAD ENGINE v1 — Snap, Ortho, Layers, Dimensions, Coord HUD
// Snap candidates, ortho lock, layer table, dimension state,
// and the coordinate readout are all original implementations.
// ============================================================
(function cadEngine() {
  if (window.__cadEngineV1) return;
  window.__cadEngineV1 = true;

  // ── helpers ────────────────────────────────────────────────
  const $ = id => document.getElementById(id);
  const svgNS = 'http://www.w3.org/2000/svg';

  // toWorld / fromWorld — reuse canvas helpers if available
  function tw(cx, cy) {
    if (typeof toWorld === 'function') return toWorld(cx, cy);
    const v = window.view || { x: 0, y: 0, z: 1 };
    return { x: (cx - v.x) / v.z, y: (cy - v.y) / v.z };
  }
  function fw(wx, wy) {
    const v = window.view || { x: 0, y: 0, z: 1 };
    return { x: wx * v.z + v.x, y: wy * v.z + v.y };
  }

  // ── STATE ──────────────────────────────────────────────────
  const CAD = {
    snapOn: false,
    orthoOn: false,
    dimMode: false,
    snapRadius: 18,       // px on screen
    snapTypes: ['endpoint','midpoint','center','intersection','grid'],
    activeSnap: null,     // { type, wx, wy } world coords
    orthoBase: null,      // { wx, wy } first point for ortho lock
    dimState: null,       // null | { phase:'first'|'second'|'offset', p1, p2 }
    layers: [],
    activeLyr: null,
  };
  window.CAD = CAD;

  // seed default layers
  function initLayers() {
    if (!window.state) return;
    if (!window.state.layers) window.state.layers = [];
    if (window.state.layers.length === 0) {
      window.state.layers = [
        { id: 'lyr-0', name: '0',          color: '#e0e0e0', lineWeight: 1,   visible: true, locked: false },
        { id: 'lyr-1', name: 'Walls',      color: '#5E9FE8', lineWeight: 2,   visible: true, locked: false },
        { id: 'lyr-2', name: 'Dimensions', color: '#DE9255', lineWeight: 1,   visible: true, locked: false },
        { id: 'lyr-3', name: 'Annotation', color: '#72BC8F', lineWeight: 0.5, visible: true, locked: false },
        { id: 'lyr-4', name: 'Grid',       color: '#888888', lineWeight: 0.5, visible: true, locked: false },
      ];
      window.state.activeLyr = 'lyr-0';
    }
    CAD.layers = window.state.layers;
    CAD.activeLyr = window.state.activeLyr || (CAD.layers[0]?.id ?? null);
  }

  // ── SNAP ENGINE ───────────────────────────────────────────
  // Ported from DraftGeomUtils.findMidpoint, isPtOnEdge,
  // findIntersection and gui_snapper snap candidate logic

  function getSnapCandidates() {
    const pts = [];
    const nodes = window.state?.nodes || [];
    const gridSize = 24; // matches HTML background-size
    const z = window.view?.z || 1;

    nodes.forEach(n => {
      if (!n.x && n.x !== 0) return;
      // 4 corners (endpoints)
      const corners = [
        { x: n.x,         y: n.y },
        { x: n.x + n.w,   y: n.y },
        { x: n.x,         y: n.y + n.h },
        { x: n.x + n.w,   y: n.y + n.h },
      ];
      corners.forEach(c => pts.push({ type: 'endpoint', wx: c.x, wy: c.y }));
      // center
      pts.push({ type: 'center', wx: n.x + n.w / 2, wy: n.y + n.h / 2 });
      // midpoints of 4 edges
      pts.push({ type: 'midpoint', wx: n.x + n.w / 2, wy: n.y });
      pts.push({ type: 'midpoint', wx: n.x + n.w / 2, wy: n.y + n.h });
      pts.push({ type: 'midpoint', wx: n.x,            wy: n.y + n.h / 2 });
      pts.push({ type: 'midpoint', wx: n.x + n.w,      wy: n.y + n.h / 2 });
    });
    return pts;
  }

  // Grid snap: snap to nearest grid point
  function snapToGrid(wx, wy) {
    const gridSize = 24;
    return {
      type: 'grid',
      wx: Math.round(wx / gridSize) * gridSize,
      wy: Math.round(wy / gridSize) * gridSize,
    };
  }

  // Find best snap point for a screen position
  function findSnap(screenX, screenY) {
    if (!CAD.snapOn) return null;
    const z = window.view?.z || 1;
    const r = CAD.snapRadius / z;  // radius in world coords
    const { wx: mx, wy: my } = tw(screenX, screenY);
    const candidates = getSnapCandidates();
    let best = null, bestDist = Infinity;

    candidates.forEach(c => {
      const d = Math.hypot(c.wx - mx, c.wy - my);
      if (d < r && d < bestDist) { best = c; bestDist = d; }
    });

    // fallback: grid snap
    if (!best) {
      const g = snapToGrid(mx, my);
      const dg = Math.hypot(g.wx - mx, g.wy - my);
      if (dg < r * 1.5) best = g;
    }
    return best;
  }

