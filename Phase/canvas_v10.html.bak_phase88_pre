<style>
/* ===================================================================
   Toolbar UI — replaces the AutoCAD-style ribbon
   4 toolbar rows (menu 22px + 3×30px rows) = ~116px total
   =================================================================== */

/* Hide old ribbon */
#cad-ribbon { display:none !important; }

/* ── Shell & layout ── */
#fc-shell {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 9800;
  background: var(--fc-bg, #3c3f41);
  color: var(--fc-txt, #c2c2c2);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: 12px;
  user-select: none;
  -webkit-user-select: none;
}

/* Hide legacy chrome when toolbar mode is on (offsets live in the acad-on block) */
body.fc-on #topbar { display: none !important; }
body.fc-on #toolbar { display: none !important; }
/* keep command bar at bottom */
body.fc-on #cad-cmdbar { /* unchanged */ }

/* ── CSS Variables (dark theme default) ── */
#fc-shell {
  --fc-bg:      #3c3f41;
  --fc-bg-mb:   #2e2f30;
  --fc-bg-row:  #3a3d3f;
  --fc-border:  #262728;
  --fc-txt:     #c2c2c2;
  --fc-txt-dim: #888;
  --fc-ico-sz:  16px;
  --fc-btn-sz:  26px;
  --fc-row-h:   30px;
  --fc-mb-h:    26px;
  --fc-accent:  #4b6eaf;
  --fc-active-bg:  rgba(75,110,175,0.40);
  --fc-active-brd: #4b88d4;
  --fc-hover-bg:   rgba(255,255,255,0.08);
  --fc-sep:     rgba(255,255,255,0.13);
  --fc-shadow:  0 2px 10px rgba(0,0,0,0.55);
}

/* Light theme overrides */
body.light-theme #fc-shell {
  --fc-bg:      #ececec;
  --fc-bg-mb:   #d8d8d8;
  --fc-bg-row:  #e8e8e8;
  --fc-border:  #c0c0c0;
  --fc-txt:     #1a1a1a;
  --fc-txt-dim: #666;
  --fc-accent:  #2b5ea8;
  --fc-active-bg:  rgba(43,94,168,0.16);
  --fc-active-brd: #2b5ea8;
  --fc-hover-bg:   rgba(0,0,0,0.07);
