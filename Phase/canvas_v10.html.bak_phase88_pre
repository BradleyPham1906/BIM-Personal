    if(!marq) return;
    var m=marq; marq=null;
    if(marqEl) marqEl.style.display='none';
    document.body.classList.remove('ws2-nosel');
    try{ var gs=window.getSelection&&getSelection(); if(gs) gs.removeAllRanges(); }catch(err){}
    if(!m.live) return;
    var a=toWorld(m.sx,m.sy), b=toWorld(e.clientX,e.clientY);
    var r={x1:Math.min(a.x,b.x),x2:Math.max(a.x,b.x),y1:Math.min(a.y,b.y),y2:Math.max(a.y,b.y)};
