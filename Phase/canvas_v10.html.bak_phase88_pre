  const stateUI={folder:'cards',query:''};
  function tileHtml(it){return `<button class="fak-item" data-fak-item="${it.key}"><div class="fak-prev">${ico(it.icon)}</div><div class="fak-name">${it.name}<small>${it.sub}</small></div></button>`}
  function rowHtml(it){return `<button class="fak-prow" data-fak-item="${it.key}" title="Drag onto the canvas or click to insert">${ico(it.icon)}<span class="fak-prow-t">${it.name}<small>${it.sub}</small></span><span class="fak-prow-grip">\u22ee\u22ee</span></button>`}
