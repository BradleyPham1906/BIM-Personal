      {t:'Annotation',big:[['text','Text']],small:[['dimLinear','Linear'],['dimAligned','Aligned'],['dimRadius','Radius'],['leader','Leader'],['dimAngular','Angular'],['dimDiameter','Diameter']]},
      {t:'Layers',big:[['layers','Layer\nProperties']]},
      {t:'Utilities',small:[['select','Select'],['pan','Pan'],['measure','Measure']]}
    ]},
    {id:'insert',name:'Insert',panels:[
      {t:'Cards',big:[['card','Card'],['sticky','Sticky'],['group','Group']]},
      {t:'Data',big:[['table','Table'],['chart','Chart'],['board','Board']]},
      {t:'Media',big:[['image','Image'],['upload','Upload']]}
    ]},
    {id:'cvarrange',name:'Arrange',panels:[
      {t:'Order',small:[['front','Bring to Front'],['top','Bring Forward'],['bottom','Send Backward'],['back','Send to Back']]},
      {t:'Group',big:[['group','Group']],small:[['duplicate','Duplicate'],['lock','Lock'],['del','Delete']]},
      {t:'Object',small:[['shape','Shape'],['text','Text'],['comment','Comment'],['checklist','Checklist'],['link','Link']]}
    ]},
    {id:'annotate',name:'Annotate',panels:[
      {t:'Dimension',big:[['dimAligned','Aligned'],['dimLinear','Linear']],small:[['dimAngular','Angular'],['dimRadius','Radial'],['dimDiameter','Diameter']]},
      {t:'Detail',small:[['line','Detail Line'],['hatch','Filled Region'],['spline','Spline'],['draw','Freehand']]},
