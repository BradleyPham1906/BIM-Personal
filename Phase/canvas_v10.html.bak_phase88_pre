    {k:'note',   label:'Note card',  w:170,h:96, why:'a titled card'},
    {k:'rect',   label:'Rectangle',  w:150,h:90, why:'a rectangle'},
    {k:'ellipse',label:'Ellipse',    w:150,h:90, why:'an ellipse'},
    {k:'line',   label:'Rule / line',w:170,h:0,  why:'a straight rule'},
    {k:'image',  label:'Image',      w:180,h:120,why:'a placed picture'},
    {k:'table',  label:'Table',      w:220,h:96, why:'a grid of cells'}
  ];
  function bimNoteDef(kind){
    var i;
    for(i=0;i<BIM_NOTE_KINDS.length;i++)if(BIM_NOTE_KINDS[i].k===kind)return BIM_NOTE_KINDS[i];
    return BIM_NOTE_KINDS[0];
  }
  var BIM_NOTE_STYLE={fill:'#f6e7a8',stroke:'#3a4048',color:'#1b1f24',lineWidth:1.2,fontSize:12};
  function bimCreateNote(kind,ptXZ,opts){
    var def=bimNoteDef(kind);
    var lvl=bimGetActiveLevel();
    A3D.counts.note=(A3D.counts.note||0)+1;
    var o={
      id:'a3d-'+Date.now().toString(36)+'-'+(A3D.seq++),
      t:'note',kind:def.k,
      name:def.label+'_'+A3D.counts.note,
      pt:[ptXZ[0],ptXZ[1]],
      y:lvl?lvl.elev:0,
      pos:[0,0,0],
      w:def.w,h:def.h,
      title:(def.k==='note')?'Note':'',
      body:(def.k==='note')?'Double-click the Text field in Properties to edit.':'',
      cells:(def.k==='table')?'Item\tQty\nBeam\t4\nColumn\t6':'',
      src:'',
      style:{fill:BIM_NOTE_STYLE.fill,stroke:BIM_NOTE_STYLE.stroke,color:BIM_NOTE_STYLE.color,
             lineWidth:BIM_NOTE_STYLE.lineWidth,fontSize:BIM_NOTE_STYLE.fontSize},
      layer:A3D.activeLayer,
      bim:{type:'note',kind:def.k,levelId:A3D.activeLevel}
    };
    if(opts&&opts.src)o.src=opts.src;
    if(def.k==='rect'||def.k==='ellipse'){o.style.fill='rgba(78,161,255,0.16)';o.style.stroke='#4ea1ff';}
    if(def.k==='line'){o.style.stroke='#e05c4a';o.style.lineWidth=2;}
    if(def.k==='table'){o.style.fill='rgba(255,255,255,0.94)';}
    if(def.k==='image'){o.style.fill='rgba(255,255,255,0.06)';}
    A3D.objs.push(o);
    return o;
  }
  /* The screen rectangle an overlay item occupies right now. One place, so draw, pick and the
     resize handles cannot disagree about where the thing is. */
  function bimNoteRect(o,V,W,H){
    var q=bimObjOffset(o);
    var sp=toScreen([o.pt[0]+q[0],(o.y||0)+q[1],o.pt[1]+q[2]],V,W,H);
    if(!isFinite(sp[0])||!isFinite(sp[1]))return null;
    return {ax:sp[0],ay:sp[1],x:sp[0],y:sp[1]-(o.h||0),w:o.w||10,h:o.h||0};
  }
  function bimNoteImageEl(o){
    if(!o.src)return null;
    if(!A3D._noteImgs)A3D._noteImgs={};
    var cached=A3D._noteImgs[o.id];
    if(cached&&cached.__src===o.src)return cached.complete?cached:null;
    var im=new Image();
    im.__src=o.src;
    im.onload=function(){paint();};
    im.onerror=function(){console.warn('[BIM] Overlay image failed to decode for '+o.name);};
    im.src=o.src;
    A3D._noteImgs[o.id]=im;
    return im.complete?im:null;
  }
  function drawNotes(ctx,V,W,H){
    if(A3D.section)return;
    var i,o;
    for(i=0;i<A3D.objs.length;i++){
      o=A3D.objs[i];
      if(o.t!=='note')continue;
      var lyr=bimLayerOf(o);
      if(lyr&&lyr.visible===false)continue;
      if(!bimObjectVisibleOnLevel(o))continue;
      var r=bimNoteRect(o,V,W,H);
      if(!r)continue;
      var sel=(o.id===A3D.sel||(A3D.selSet&&A3D.selSet.indexOf(o.id)>=0));
      var st=o.style||BIM_NOTE_STYLE;
      ctx.save();
      ctx.lineWidth=st.lineWidth||1.2;
      ctx.strokeStyle=sel?'#4ea1ff':(st.stroke||'#3a4048');
      ctx.fillStyle=st.fill||'#f6e7a8';
      if(o.kind==='line'){
        ctx.beginPath();ctx.moveTo(r.ax,r.ay);ctx.lineTo(r.ax+r.w,r.ay);ctx.stroke();
      }else if(o.kind==='ellipse'){
        ctx.beginPath();
        ctx.ellipse(r.x+r.w/2,r.y+r.h/2,Math.abs(r.w/2),Math.abs(r.h/2),0,0,Math.PI*2);
        ctx.fill();ctx.stroke();
      }else{
        ctx.beginPath();
        if(ctx.roundRect)ctx.roundRect(r.x,r.y,r.w,r.h,o.kind==='note'?6:3);
        else ctx.rect(r.x,r.y,r.w,r.h);
        ctx.fill();ctx.stroke();
      }
      ctx.fillStyle=st.color||'#1b1f24';
      ctx.textBaseline='top';ctx.textAlign='left';
      if(o.kind==='note'){
        ctx.font='700 '+((st.fontSize||12)+1)+'px Inter,system-ui,sans-serif';
        ctx.fillText(bimNoteClip(ctx,o.title||'',r.w-16),r.x+8,r.y+7);
        ctx.font=(st.fontSize||12)+'px Inter,system-ui,sans-serif';
        bimNoteWrap(ctx,o.body||'',r.x+8,r.y+7+(st.fontSize||12)+7,r.w-16,
                    (st.fontSize||12)+4,r.h-20);
      }else if(o.kind==='table'){
        bimNoteTable(ctx,o,r,st);
      }else if(o.kind==='image'){
        var im=bimNoteImageEl(o);
        if(im){
          try{ctx.drawImage(im,r.x,r.y,r.w,r.h);}catch(eD){}
          ctx.strokeStyle=sel?'#4ea1ff':(st.stroke||'#3a4048');
          ctx.strokeRect(r.x,r.y,r.w,r.h);
        }else{
          ctx.font='11px Inter,system-ui,sans-serif';
          ctx.fillStyle='#9aa3ad';
          ctx.fillText(o.src?'loading image...':'no image chosen',r.x+8,r.y+8);
        }
      }
      // the anchor dot: this overlay item belongs to a POINT in the model, not to the screen
      ctx.fillStyle=sel?'#4ea1ff':'rgba(140,150,162,0.9)';
      ctx.beginPath();ctx.arc(r.ax,r.ay,2.6,0,Math.PI*2);ctx.fill();
      ctx.restore();
    }
  }
  function bimNoteClip(ctx,s,maxW){
    if(ctx.measureText(s).width<=maxW)return s;
    var t=s;
    while(t.length>1&&ctx.measureText(t+'\u2026').width>maxW)t=t.slice(0,-1);
    return t+'\u2026';
  }
  function bimNoteWrap(ctx,text,x,y,maxW,lh,maxH){
    var words=String(text).split(/\s+/),line='',yy=y,i;
    for(i=0;i<words.length;i++){
      var probe=line?(line+' '+words[i]):words[i];
      if(ctx.measureText(probe).width>maxW&&line){
        ctx.fillText(line,x,yy);yy+=lh;line=words[i];
        if(yy-y+lh>maxH)return;
      }else line=probe;
    }
    if(line&&yy-y<=maxH)ctx.fillText(line,x,yy);
  }
  function bimNoteTable(ctx,o,r,st){
    var rows=String(o.cells||'').split('\n').filter(function(s){return s.length;});
    if(!rows.length)return;
    var grid=rows.map(function(l){return l.split('\t');});
    var nc=0,i,j;
    for(i=0;i<grid.length;i++)if(grid[i].length>nc)nc=grid[i].length;
    if(!nc)return;
    var cw=r.w/nc,ch=r.h/grid.length;
    ctx.font=(st.fontSize||12)+'px Inter,system-ui,sans-serif';
    ctx.strokeStyle='rgba(60,68,78,0.55)';
    ctx.lineWidth=0.8;
    for(i=0;i<grid.length;i++){
      for(j=0;j<nc;j++){
        var cx=r.x+j*cw,cy=r.y+i*ch;
        ctx.strokeRect(cx,cy,cw,ch);
        ctx.fillStyle=(i===0)?'#0f1216':(st.color||'#1b1f24');
        ctx.font=((i===0)?'700 ':'')+(st.fontSize||12)+'px Inter,system-ui,sans-serif';
        ctx.fillText(bimNoteClip(ctx,grid[i][j]||'',cw-8),cx+4,cy+Math.max(2,(ch-(st.fontSize||12))/2));
      }
    }
  }
  function bimPickNote(x,y){
    var V=camVecs(A3D.cam),W=cvW(),H=cvH();
    var i,o;
    // back to front: the last drawn is the one on top, and it is the one a click should reach
    for(i=A3D.objs.length-1;i>=0;i--){
      o=A3D.objs[i];
      if(o.t!=='note')continue;
      var lyr=bimLayerOf(o);
      if(lyr&&(lyr.visible===false||lyr.locked))continue;
      if(!bimObjectVisibleOnLevel(o))continue;
      var r=bimNoteRect(o,V,W,H);
      if(!r)continue;
      if(o.kind==='line'){
        if(bimPointSegDist(x,y,r.ax,r.ay,r.ax+r.w,r.ay)<7)return o;
        continue;
      }
      if(x>=r.x-2&&x<=r.x+r.w+2&&y>=r.y-2&&y<=r.y+r.h+2)return o;
    }
    return null;
  }
  /* Placed at the centre of the SAFE view rectangle (V79), un-projected onto the active level --
     so a new note lands where the user is looking and not behind the tool dock. */
  function bimPlaceNoteAtViewCentre(kind,opts){
    var s=bimSafeViewRect();
    var lvl=bimGetActiveLevel();
    var g=groundPoint(s.x+s.w/2,s.y+s.h/2,lvl?lvl.elev:0);
    if(!g){
      console.warn('[BIM] Could not un-project the view centre; placing the '+kind+' at the origin.');
      g=[0,0,0];
    }
    pushUndo();
    var o=bimCreateNote(kind,[g[0],g[2]],opts);
    A3D.sel=o.id;A3D.sel2=null;A3D.selSet=[o.id];
    refreshTree();refreshHud();paint();saveSoon();
    a3dToast(o.name+' placed \u2014 drag it, or edit it in Properties');
    return o;
  }
  /* The one kind that needs a file. Read as a data URI so the drawing stays self-contained and
     keeps working with no server and no external reference (Principle 5). */
  function bimPlaceImageNote(){
    var inp=document.createElement('input');
    inp.type='file';inp.accept='image/*';
    inp.onchange=function(){
      var f=inp.files&&inp.files[0];
      if(!f)return;
      if(f.size>4*1024*1024){
        a3dToast('That image is larger than 4 MB \u2014 pick a smaller one');
        return;
      }
      var rd=new FileReader();
      rd.onload=function(){bimPlaceNoteAtViewCentre('image',{src:String(rd.result)});};
      rd.onerror=function(){
        console.warn('[BIM] Could not read the chosen image file.');
        a3dToast('That image could not be read');
      };
      rd.readAsDataURL(f);
    };
    inp.click();
    return true;
  }
  /* ================= __acad3dV83: the rail's utility stack =================

     The foot of the left rail was a single 24px "A?" button under 900px of empty column. The
     reference tool stacks its view and document utilities there, and that is the right place for
     them: always reachable, never in the drawing.

     Inserted into the rendered rail rather than written into the whiteboard's template -- that
     template is a single-line string literal shared with a competing second sidebar
     implementation, and V80 already established this pass-over-the-shell pattern for exactly that
     reason. The same MutationObserver keeps the stack present across a re-render. */
  var A3D_RAIL_ICONS={
    zoom:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 L21 21"/><path d="M7.5 10.5h6"/></svg>',
    appear:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"/></svg>',
    snaps:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<path d="M4 9h16M4 15h16M9 4v16M15 4v16"/></svg>',
    units:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<path d="M3 14h18v5H3z"/><path d="M7 14v-3M11 14v-4M15 14v-3M19 14v-4"/></svg>',
    capture:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.2"/></svg>',
    /* __acad3dV85: a keyboard, because that is what this one opens. The button it replaces
       said "A?" and did nothing at all. */
    help:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">'+
      '<rect x="2.5" y="6.5" width="19" height="11" rx="2"/>'+
      '<path d="M6 10h.01M9 10h.01M12 10h.01M15 10h.01M18 10h.01M8 13.5h8"/></svg>'
  };
  var A3D_RAIL_UTILS=[
    {id:'zoom',   label:'Zoom',       menu:true },
    {id:'appear', label:'Appearance', menu:true },
    {id:'snaps',  label:'Snaps',      menu:true },
    {id:'units',  label:'Units',      menu:true },
    {id:'capture',label:'Save image', menu:false},
    {id:'help',   label:'Keyboard shortcuts', menu:true}
  ];

  /* ---- __acad3dV85: the shortcut registry ----

     One list, rendered into the sheet AND driven by the Phase 85 suite: every row carrying a
     `k` is dispatched as a real key event and asserted to do what its label claims. The key
     handlers in this app are a switch chain rather than a table, so this list cannot be derived
     from them the way V74 derived the schedule categories. Holding it to account with the suite
     is the next best thing, and it is what stops the sheet drifting into fiction -- which is
     precisely what the button this replaces had become.

     `k` is the ev.key value; `mod` means Ctrl (Cmd on a Mac). A row with k:null documents
     something a single synthetic keypress cannot demonstrate, and says so here rather than
     pretending. */
  var A3D_MODKEY=(navigator.platform&&/Mac|iPhone|iPad/.test(navigator.platform))?'Cmd':'Ctrl';
  var A3D_KEYS=[
    {grp:'Views',rows:[
      /* The handler tests ev.key === '>' and does not look at shiftKey. Producing '>' on a
         US keyboard involves Shift, but ">" reads as Shift AND '>', which is a
         different chord and is not what the app listens for. Measured: Playwright's 'Shift+.'
         delivers key='.' and does nothing; 'Shift+Period' delivers key='>' and works. */
      {keys:['>'],k:'>',label:'Switch between the plan and 3D'},
      {keys:['Esc'],k:'Escape',label:'Back out one step: menu, zoom window, dialog, sketch, section, then clear the selection'},
      {keys:['Enter'],k:null,label:'With nothing running, repeats the last command'}
    ]},
    /* __acad3dV86: rewritten for the AutoCAD input model. The previous rows described a
       grammar that accepted a bare length and nothing else, which is what the tools took
       before this phase. A help sheet describing the previous version is the same fault V85
       built its suite to catch, arriving from the other direction: the keys changed, not the
       sheet. */
    {grp:'Drawing',rows:[
      {keys:['Enter'],k:null,label:'Finish the current line, polyline, wall or stair'},
      {keys:['C'],k:null,label:'Close the path (from three points on)'},
      {keys:['U'],k:null,label:'Undo the last point'},
      {keys:['x,y'],k:null,label:'Absolute point. @x,y is relative to the last point; # forces absolute'},
      {keys:['d<a'],k:null,label:'Polar point: distance, then angle. @5<45 is relative'},
      {keys:['0-9'],k:null,label:'A bare length draws that far along the current direction'},
      {keys:['Arrows'],k:null,label:'Nudge the selected object'}
    ]},
    {grp:'Snaps',rows:[
      {keys:['F3'],k:'F3',label:'Object snap on or off'},
      {keys:['F8'],k:'F8',label:'Ortho on or off'},
      {keys:['F9'],k:'F9',label:'Grid snap on or off'}
    ]},
    {grp:'Editing',rows:[
      {keys:[A3D_MODKEY,'Z'],k:'z',mod:true,label:'Undo'},
      {keys:[A3D_MODKEY,'Y'],k:'y',mod:true,label:'Redo'},
      {keys:[A3D_MODKEY,'D'],k:'d',mod:true,label:'Duplicate the selection'},
      {keys:['Delete'],k:null,label:'Delete the selection'}
    ]},
    {grp:'Project',rows:[
      {keys:[A3D_MODKEY,'S'],k:null,label:'Export the project file'},
      {keys:[A3D_MODKEY,'K'],k:null,label:'Command palette'}
    ]}
  ];
  function bimShortcutsHtml(){
    var h='<div class="a3d-ruhd">Keyboard shortcuts</div><div class="a3d-rukeys">',g,r,i,j,k;
    for(i=0;i<A3D_KEYS.length;i++){
      g=A3D_KEYS[i];
      h+='<div class="a3d-rkgrp">'+bimEsc(g.grp)+'</div>';
      for(j=0;j<g.rows.length;j++){
        r=g.rows[j];
        h+='<div class="a3d-rkrow"><span class="a3d-rkkeys">';
        for(k=0;k<r.keys.length;k++){
          if(k)h+='<span class="a3d-rkplus">+</span>';
          h+='<kbd>'+bimEsc(r.keys[k])+'</kbd>';
        }
        h+='</span><span class="a3d-rklab">'+bimEsc(r.label)+'</span></div>';
      }
    }
    return h+'</div>';
  }
  function bimRailStackHtml(){
    var h='<div id="a3d-railutil">',i;
    for(i=0;i<A3D_RAIL_UTILS.length;i++){
      var u=A3D_RAIL_UTILS[i];
      h+='<button class="a3d-ru" title="'+bimEsc(u.label)+'" '+
         (u.menu?('data-a3drumenu="'+u.id+'"'):('data-a3druact="'+u.id+'"'))+'>'+
         A3D_RAIL_ICONS[u.id]+'</button>';
    }
    return h+'</div>';
  }
  function bimEnsureRailStack(){
    var rail=document.getElementById('figma-layers-rail');
    if(!rail||!A3D.on)return false;
    /* __acad3dV85: the whiteboard shell's "A?" button is REMOVED here, not left sitting under
       the stack. It had no click handler anywhere in the file, no title, and opened nothing --
       driven with a real pointer it produced no dialog, no toast and no visible change. It was
       Figma-style set dressing in a template this app inherited. Its job, keyboard help, is now
       a real entry in the stack above. Removed on every pass rather than once, because the
       whiteboard shell re-renders its own rail and would put it back. */
    var dead=rail.querySelector('.fl-help'),did=false;
    if(dead&&dead.parentNode){dead.parentNode.removeChild(dead);did=true;}
    if(rail.querySelector('#a3d-railutil'))return did;
    var box=document.createElement('div');
    box.innerHTML=bimRailStackHtml();
    rail.appendChild(box.firstChild);
    return true;
  }
  /* ---- the popover ----
     Appended to document.body and positioned in fixed coordinates against the button's own
     rectangle, then CLAMPED to the window. V70 is the reason for the clamp and for the suite that
     measures it: a fixed-position popover inside a transformed ancestor resolves against that
     ancestor, and the dock's carets once opened hundreds of pixels off-screen while every state
     check passed. */
  function bimRailPop(){
    var p=document.getElementById('a3d-rupop');
    if(!p){
      p=document.createElement('div');
      p.id='a3d-rupop';
      document.body.appendChild(p);
      p.addEventListener('click',function(ev){
        var b=ev.target&&ev.target.closest?ev.target.closest('[data-a3druitem]'):null;
        if(b){bimRailAction(b.getAttribute('data-a3druitem'));return;}
      });
      p.addEventListener('change',function(ev){
        var f=ev.target&&ev.target.closest?ev.target.closest('[data-a3druset]'):null;
        if(f)bimRailSet(f.getAttribute('data-a3druset'),f);
      });
    }
    return p;
  }
  function bimCloseRailPop(){
    var p=document.getElementById('a3d-rupop');
    if(p)p.classList.remove('open');
    var opened=document.querySelectorAll('#a3d-railutil .a3d-ru.on'),i;
    for(i=0;i<opened.length;i++)opened[i].classList.remove('on');
  }
