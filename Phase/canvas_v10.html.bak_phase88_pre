<style id="canva-chart-sidebar-style">
/* Canva-style chart sidebar */
#chart-panel{position:fixed!important;top:0!important;right:0!important;bottom:0!important;left:auto!important;width:320px!important;max-width:min(92vw,320px)!important;max-height:none!important;min-width:0!important;padding:0!important;border-radius:0!important;border-left:1px solid rgba(255,255,255,.10)!important;border-top:0!important;border-right:0!important;border-bottom:0!important;background:#ffffff!important;color:#202124!important;box-shadow:-12px 0 32px rgba(0,0,0,.18)!important;backdrop-filter:none!important;overflow:hidden!important;z-index:86!important;display:none}
#chart-panel.show{display:flex!important;flex-direction:column}
body.light-theme #chart-panel{background:#fff!important;color:#202124!important;border-left-color:rgba(0,0,0,.10)!important}
body:not(.light-theme) #chart-panel{background:#f8f6fb!important;color:#202124!important;border-left-color:rgba(0,0,0,.08)!important}
#chart-panel .ccs-head{display:flex;align-items:center;gap:10px;padding:16px 16px 10px;border-bottom:1px solid rgba(32,33,36,.08)}
#chart-panel .ccs-back,#chart-panel .ccs-close{width:32px;height:32px;border:0;border-radius:999px;background:transparent;color:#222;display:grid;place-items:center;cursor:pointer;font-size:18px;flex:0 0 auto}
#chart-panel .ccs-back:hover,#chart-panel .ccs-close:hover{background:rgba(0,0,0,.06)}
#chart-panel .ccs-head-main{min-width:0;flex:1}
#chart-panel .ccs-title{font-size:16px;font-weight:800;line-height:1.15;color:#202124}
#chart-panel .ccs-subtitle{font-size:11px;color:#7a7388;margin-top:3px;font-weight:600}
#chart-panel .ccs-body{padding:12px 14px 18px;overflow:auto;display:flex;flex-direction:column;gap:14px}
#chart-panel .ccs-search{height:36px;border:1px solid #e4d5ff;border-radius:14px;background:#fff;display:flex;align-items:center;gap:8px;padding:0 12px;color:#8d86a1;box-shadow:inset 0 1px 0 rgba(255,255,255,.7)}
#chart-panel .ccs-search input{all:unset;flex:1;min-width:0;font-size:12.5px;color:#202124}
#chart-panel .ccs-search svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2}
#chart-panel .ccs-start{height:38px;border:1px solid #e5e7eb;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;gap:8px;color:#111827;font-size:12.5px;font-weight:700;cursor:pointer}
#chart-panel .ccs-start:hover{background:#f6f7fb}
#chart-panel .ccs-start svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.9}
#chart-panel .ccs-group{display:flex;flex-direction:column;gap:8px}
#chart-panel .ccs-group-head{display:flex;align-items:center;justify-content:space-between;gap:8px}
#chart-panel .ccs-group-title{font-size:13px;font-weight:800;color:#423c4f}
#chart-panel .ccs-seeall{border:0;background:transparent;color:#423c4f;font-size:11px;font-weight:700;cursor:pointer;padding:0}
#chart-panel .ccs-seeall:hover{text-decoration:underline}
#chart-panel .ccs-featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
#chart-panel .ccs-all-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
#chart-panel .ccs-tile{border:0;background:transparent;padding:0;margin:0;cursor:pointer;text-align:left;color:inherit}
#chart-panel .ccs-thumb{height:74px;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;border:1px solid rgba(0,0,0,.06);box-shadow:0 1px 0 rgba(255,255,255,.7),0 4px 12px rgba(99,102,241,.06);overflow:hidden;transition:transform .12s ease,box-shadow .12s ease}
#chart-panel .ccs-tile:hover .ccs-thumb{transform:translateY(-1px);box-shadow:0 6px 16px rgba(99,102,241,.12)}
#chart-panel .ccs-thumb svg{width:72px;height:72px;display:block}
#chart-panel .ccs-name{font-size:10.5px;line-height:1.25;color:#534d63;font-weight:600;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#chart-panel .ccs-empty{padding:24px 10px;color:#7a7388;font-size:12px;text-align:center}
#chart-panel .ccs-foot{border:1px solid rgba(17,24,39,.12);border-radius:12px;padding:12px;background:#fff;display:flex;align-items:center;gap:10px;box-shadow:0 3px 10px rgba(0,0,0,.04)}
#chart-panel .ccs-foot-badge{width:28px;height:28px;border-radius:8px;background:#111827;color:#fff;display:grid;place-items:center;font-weight:900}
#chart-panel .ccs-foot-copy{min-width:0;flex:1}
#chart-panel .ccs-foot-copy strong{display:block;font-size:12px;color:#202124}
#chart-panel .ccs-foot-copy span{display:block;font-size:10px;color:#6b7280;margin-top:2px}
#chart-panel .ccs-foot-btn{height:28px;padding:0 10px;border:0;border-radius:8px;background:#8b5cf6;color:#fff;font-size:11px;font-weight:800;cursor:pointer}
#chart-panel .ccs-foot-btn:hover{filter:brightness(.95)}
#chart-panel .ccs-group-page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:8px}
#chart-panel .ccs-group-page-head .ccs-group-title{font-size:14px}
#chart-panel .ccs-chipline{display:flex;flex-wrap:wrap;gap:6px}
#chart-panel .ccs-chip{height:24px;padding:0 10px;border-radius:999px;border:1px solid rgba(139,92,246,.18);background:#fff;color:#6c4dd9;font-size:10px;font-weight:800;display:inline-flex;align-items:center}
</style>

