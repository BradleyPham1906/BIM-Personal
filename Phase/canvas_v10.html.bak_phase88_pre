    A3D.levelFilter=!!v.levelFilter;
    A3D.activeViewId=v.id;
    if(el.flip){el.flip.textContent=A3D.flat?'3D':'2D';el.flip.setAttribute('title',A3D.flat?'Go to 3D (>)':'Go to 2D (>)');}
