/* ---------------- ISO 286 fit dialog ---------------- */
var fitDlg=null;
function fitCombos(isHole){return isHole?FIT.holeValues:FIT.shaftValues}
function buildFitDlg(){
  if(fitDlg)return fitDlg;
  fitDlg=document.createElement('div');
  fitDlg.className='wb-dlg';fitDlg.id='wb-fit';
  fitDlg.style.cssText='right:12px;top:210px;width:296px;';
  fitDlg.innerHTML='<div class="wb-dlg-head"><span>Hole/Shaft Fit ISO 286</span><button data-wb-close="1" title="Close">\u2715</button></div>'+
    '<div class="wb-dlg-body">'+
    '<div class="wb-row"><label>System</label><label style="min-width:0"><input type="radio" name="wbfit-base" id="wbfit-hole" checked> Hole basis</label><label style="min-width:0"><input type="radio" name="wbfit-base" id="wbfit-shaft"> Shaft basis</label></div>'+
    '<div class="wb-row"><label>Fit</label><select id="wbfit-field"></select></div>'+
    '<div class="wb-row"><label>Nominal \u2300</label><input type="number" id="wbfit-nominal" value="40" min="0.01" max="500" step="0.5"></div>'+
    '<div class="wb-fit-res" id="wbfit-res"></div>'+
    '<div class="wb-row" style="margin-top:8px;margin-bottom:0"><button class="wb-btn" id="wbfit-place" style="width:100%;white-space:nowrap">Place annotation\u2026</button></div>'+
    '</div>';
  document.body.appendChild(fitDlg);
  function fillCombo(){
    var isHole=$('#wbfit-hole',fitDlg).checked,sel=$('#wbfit-field',fitDlg);
    /* setHoleFields/setShaftFields: base field + tolerance field + fit type */
    sel.innerHTML=fitCombos(isHole).map(function(v,i){
      return '<option value="'+i+'">'+v[0]+' / '+v[1]+' \u2014 '+(FIT_TYPE_LABEL[v[2]]||v[2])+'</option>';
    }).join('');
  }
  function currentFit(){
    var isHole=$('#wbfit-hole',fitDlg).checked;
    var idx=+$('#wbfit-field',fitDlg).value||0;
    var combo=fitCombos(isHole)[idx];
    /* selectedField is e.g. "H7": fieldChar is the letter, quality is the numeric grade */
    var selectedField=combo[1];
    return {combo:combo,field:selectedField,fieldChar:selectedField.charAt(0),quality:parseInt(selectedField.slice(1),10),isHole:isHole};
  }
  function refresh(){
    var f=currentFit(),v=parseFloat($('#wbfit-nominal',fitDlg).value);
    var res=$('#wbfit-res',fitDlg);
    if(!(v>0&&v<=500)){res.textContent='Nominal must be 0 < \u2300 \u2264 500 mm';return}
    var t=iso286(v,f.fieldChar,f.quality);
    res.textContent='\u2300'+v+' '+f.field+'\n  upper: '+fmtTol(t.upper)+' mm\n  lower: '+fmtTol(t.lower)+' mm\n  ('+(FIT_TYPE_LABEL[f.combo[2]]||f.combo[2])+', mates '+f.combo[0]+')';
  }
  fitDlg.addEventListener('click',function(e){if(e.target.closest('[data-wb-close]'))fitDlg.classList.remove('open')});
  $('#wbfit-hole',fitDlg).addEventListener('change',function(){fillCombo();refresh()});
  $('#wbfit-shaft',fitDlg).addEventListener('change',function(){fillCombo();refresh()});
  $('#wbfit-field',fitDlg).addEventListener('change',refresh);
  $('#wbfit-nominal',fitDlg).addEventListener('input',refresh);
  $('#wbfit-place',fitDlg).addEventListener('click',function(){
    var f=currentFit(),v=parseFloat($('#wbfit-nominal',fitDlg).value);
    if(!(v>0&&v<=500)){say('Enter a nominal size 0\u2013500 mm');return}
    var t=iso286(v,f.fieldChar,f.quality);
    var text='\u2300'+v+' '+f.field+'  ('+fmtTol(t.upper)+' / '+fmtTol(t.lower)+')';
    startCmd('wbFitPlace','Click to place fit annotation: '+text,{text:text});
  });
  fillCombo();refresh();
  return fitDlg;
}

