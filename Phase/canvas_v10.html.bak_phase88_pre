    pal.addEventListener('click',e=>{const r=e.target.closest('.uc-row'); if(!r)return; const c=commands.find(x=>x.label===r.dataset.label); if(c){closePalette(); c.run();}});
    input.addEventListener('keydown',e=>{if(e.key==='Enter'){const r=pal.querySelector('.uc-row.active'); const c=commands.find(x=>x.label===r?.dataset.label); if(c){e.preventDefault();closePalette();c.run();}} if(e.key==='Escape')closePalette();});
  }
  function openPalette(){makePalette(); const pal=$('#uploaded-command-palette'); pal.classList.add('show'); const input=pal.querySelector('input'); input.value=''; input.dispatchEvent(new Event('input')); setTimeout(()=>input.focus(),20)}
  function closePalette(){ $('#uploaded-command-palette')?.classList.remove('show') }
  window.openPalette=openPalette; window.closePalette=closePalette;
  function makeLiveTools(){
    // The uploaded reference had chat/reaction controls; this canvas keeps command palette keyboard-only.
