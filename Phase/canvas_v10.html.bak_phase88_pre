/* Adaptive light/dark settings panels for toolbar, inspectors, menus, and builders */
:root{
  --panel-bg:rgba(32,32,32,.96);
  --panel-bg-solid:#2c2c2c;
  --panel-bg-soft:#383838;
  --panel-bg-raised:#3a3a3a;
  --panel-border:rgba(255,255,255,.12);
  --panel-border-strong:rgba(255,255,255,.18);
  --panel-text:#f5f5f5;
  --panel-muted:#bdbdbd;
  --panel-subtle:rgba(255,255,255,.055);
  --panel-hover:rgba(255,255,255,.08);
  --panel-input:#171717;
  --panel-input-2:#3a3a3a;
  --panel-shadow:0 22px 80px rgba(0,0,0,.42);
  --panel-blue:#0d99ff;
}
body.light-theme{
  --panel-bg:rgba(255,255,255,.97);
  --panel-bg-solid:#ffffff;
  --panel-bg-soft:#f4f4f4;
  --panel-bg-raised:#f7f7f7;
