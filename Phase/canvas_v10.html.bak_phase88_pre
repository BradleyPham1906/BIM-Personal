<script>
// Figma-style inspector: object-type header, zoom %, X/Y/rotation + opacity wiring.
(function figmaInspectorLayout(){
  if(window.__figmaInspectorLayout) return; window.__figmaInspectorLayout=true;
  const $=q=>document.querySelector(q);
  function typeName(n){if(!n)return'Inspector';if(n.shape)return'Shape';if(n.sticky)return'Sticky';const m={card:'Card',table:'Table',chart:'Chart',image:'Image',whiteboard:'Whiteboard',group:'Group',text:n.plainText?'Text':'Card'};return m[n.type]||(n.type?n.type[0].toUpperCase()+n.type.slice(1):'Object')}
  function sync(){
    const n=typeof selectedNode==='function'?selectedNode():null;
    const t=$('#fig-obj-type'); if(t)t.textContent=typeName(n);
    const ae=document.activeElement;
    const set=(id,v)=>{const el=document.getElementById(id);if(el&&ae!==el)el.value=v};
    ['fig-x','fig-y','fig-rot','fig-opacity'].forEach(id=>{const el=document.getElementById(id);if(el)el.disabled=!n});
    if(n){
      set('fig-x',Math.round(n.x||0)); set('fig-y',Math.round(n.y||0)); set('fig-rot',Math.round(n.rotation||0));
      const op=Math.round((n.opacity??1)*100); set('fig-opacity',op);
      const ov=$('#fig-opacity-val'); if(ov)ov.textContent=op+'%';
    }
  }
  const _u=updateUI; updateUI=function(){_u();try{sync()}catch(e){}};
  const _av=applyView; applyView=function(){_av();const z=$('#fig-zoom');if(z)z.textContent=Math.round(((typeof view!=='undefined'&&view.z)||1)*100)+'%'};
  function live(fn){const n=typeof selectedNode==='function'?selectedNode():null;if(!n)return;fn(n);save();renderAll();if(typeof select==='function')select(n.id)}
  $('#fig-x')?.addEventListener('input',e=>live(n=>{n.x=Number(e.target.value)||0}));
  $('#fig-y')?.addEventListener('input',e=>live(n=>{n.y=Number(e.target.value)||0}));
  $('#fig-rot')?.addEventListener('input',e=>live(n=>{n.rotation=Number(e.target.value)||0}));
  $('#fig-opacity')?.addEventListener('input',e=>{const v=Math.max(10,Math.min(100,Number(e.target.value)||100));const ov=$('#fig-opacity-val');if(ov)ov.textContent=v+'%';live(n=>{n.opacity=v/100})});
  try{sync()}catch(e){}
  try{const z=$('#fig-zoom');if(z)z.textContent=Math.round(((typeof view!=='undefined'&&view.z)||1)*100)+'%'}catch(e){}
})();
