      return `<optgroup label="${escHtml(group)}">${items.map(item=>`<option value="${item.kind}" ${current===item.kind?'selected':''}>${escHtml(item.name)}</option>`).join('')}</optgroup>`;
    }).join('');
    return groups || oldChartTypeOptions(current);
  };

  const oldShowInspector = showInspector;
  showInspector = function(force){ if(force) panel?.classList.remove('show'); return oldShowInspector(force); };

  const oldAddChart = addChart;
  addChart = function(x,y,kind='bar'){
    const aliased = aliasKind(kind);
    const n = oldAddChart(x,y,aliased);
    if(n){
      n.chartKind = kind;
      n.title = chartTitle(kind);
      n.data = defaultChartData(kind);
      save(); renderAll(); select(n.id);
    }
    return n;
  };

  function patchChartToolbar(el,n){
    const sel = el.querySelector('[data-chart-kind]');
    if(sel){
      sel.innerHTML = chartTypeOptions(n.chartKind||'bar');
      sel.value = n.chartKind || 'bar';
      sel.onchange = (e) => { n.chartKind = e.target.value; if(!n.data || !String(n.data).trim()) n.data = defaultChartData(n.chartKind); save(); renderAll(); select(n.id); };
    }
    const hint = el.querySelector('.chart-hint');
    if(hint){
      hint.innerHTML = '<button type="button" class="chart-browse" data-chart-browse>More charts</button>';
      const browse = hint.querySelector('[data-chart-browse]');
      if(browse){
        browse.title = chartGroup(n.chartKind||'bar');
        browse.onclick = (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          if(typeof window.openChartLibraryFor === 'function') window.openChartLibraryFor(n.chartKind||'bar');
          else if(typeof window.openChartPanel === 'function') window.openChartPanel(true);
        };
      }
    }
  }

  const oldRenderChartNode = renderChartNode;
  renderChartNode = function(n,el){
    const kind = n.chartKind || 'bar';
    const alias = aliasKind(kind);
    const shadow = Object.assign({}, n, { chartKind: alias, data: n.data || defaultChartData(kind) });
    oldRenderChartNode(shadow, el);
    patchChartToolbar(el,n);
    const host = el.querySelector('.chart-wrap');
    if(!host) return;
    if(kind==='progressRing') renderProgressRing(host,n);
    if(kind==='treemap' || kind==='nestedTreemap') renderTreemap(host,n,kind==='nestedTreemap');
    if(kind==='dotPlot') renderDotPlot(host,n);
    if(typeof bindChartInteractivity==='function') bindChartInteractivity(host,n,parseDelimited(n.data || defaultChartData(kind)));
  };

  function renderProgressRing(host,n){
    const rows = parseDelimited(n.data || defaultChartData('progressRing'));
    const label = rows?.[1]?.[0] || 'Progress';
    const val = Math.max(0, Math.min(100, num(rows?.[1]?.[1] ?? rows?.[1]?.[0] ?? 72)));
    const w = Math.max(220, host.clientWidth-20), h = Math.max(150, host.clientHeight-34), cx = w/2, cy = h/2-4, r = Math.min(w,h)*0.26, sw = Math.max(14, r*0.34);
    const circumference = 2*Math.PI*r, dash = circumference*(val/100);
    host.innerHTML = `<svg viewBox="0 0 ${w} ${h}"><circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="rgba(94,159,232,.14)" stroke-width="${sw}"/><circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${n.color||paletteAt(0)}" stroke-width="${sw}" stroke-linecap="round" stroke-dasharray="${dash} ${circumference-dash}" transform="rotate(-90 ${cx} ${cy})"><title>${escHtml(label)}: ${val}%</title></circle><text x="${cx}" y="${cy+6}" text-anchor="middle" fill="rgba(255,255,255,.94)" font-size="${Math.max(20,sw)}" font-weight="800">${val}%</text><text x="${cx}" y="${cy+r+24}" text-anchor="middle" fill="rgba(255,255,255,.62)" font-size="11">${escHtml(label)}</text></svg><div class="chart-tip"></div>`;
  }

  function renderDotPlot(host,n){
    const rows = parseDelimited(n.data || defaultChartData('dotPlot')).slice(1);
    const vals = rows.map(r=>Math.max(0, Math.round(num(r[1]))));
    const labels = rows.map(r=>r[0]||'');
    const max = Math.max(...vals,1);
    const w = Math.max(220, host.clientWidth-20), h = Math.max(150, host.clientHeight-34), left = 26, right = 12, top = 10, bottom = 28, iw = w-left-right, ih = h-top-bottom;
    const band = iw/Math.max(vals.length,1);
    let dots='', xlabels='';
    vals.forEach((v,i)=>{
      const cx = left + i*band + band/2;
      for(let j=0;j<v;j++){
        const y = top + ih - (j+1)*(ih/(max+0.8));
        dots += `<circle cx="${cx}" cy="${y}" r="4.1" fill="${paletteAt(i)}"><title>${escHtml(labels[i])}: ${v}</title></circle>`;
      }
      xlabels += `<text x="${cx}" y="${h-8}" fill="rgba(255,255,255,.7)" font-size="11" text-anchor="middle">${escHtml(labels[i])}</text>`;
    });
    host.innerHTML = `<svg viewBox="0 0 ${w} ${h}">${dots}${xlabels}</svg>`;
  }

  function renderTreemap(host,n,nested){
    const rows = parseDelimited(n.data || defaultChartData(nested ? 'nestedTreemap' : 'treemap')).slice(1).map(r=>({label:r[0]||'', value:Math.max(1,num(r[1]))}));
    const total = rows.reduce((a,b)=>a+b.value,0) || 1;
    const w = Math.max(220, host.clientWidth-20), h = Math.max(150, host.clientHeight-34);
    let rects='';
    if(!nested){
      let x=0;
      rows.forEach((row,i)=>{
        let ww = i===rows.length-1 ? (w-x) : Math.max(38, Math.round(w*(row.value/total)));
        if(x+ww > w) ww = w-x;
        rects += `<rect x="${x}" y="0" width="${ww}" height="${h}" fill="${paletteAt(i)}" opacity=".92" rx="8"><title>${escHtml(row.label)}: ${row.value}</title></rect><text x="${x+8}" y="20" fill="white" font-size="11" font-weight="700">${escHtml(row.label)}</text>`;
        x += ww + 2;
      });
    } else {
      const top = rows[0] || {label:'Desktop',value:1};
      const topH = Math.max(52, Math.round(h*(top.value/total)));
      rects += `<rect x="0" y="0" width="${w}" height="${topH}" fill="${paletteAt(0)}" rx="8"><title>${escHtml(top.label)}: ${top.value}</title></rect><text x="10" y="20" fill="white" font-size="11" font-weight="700">${escHtml(top.label)}</text>`;
      const rest = rows.slice(1);
      const restTotal = rest.reduce((a,b)=>a+b.value,0) || 1;
      let x=0, y=topH+2, remH=h-topH-2;
      rest.forEach((row,i)=>{
        let ww = i===rest.length-1 ? (w-x) : Math.max(34, Math.round(w*(row.value/restTotal)));
        if(x+ww > w) ww = w-x;
        const hh = i%2===0 ? Math.max(24, remH*0.56-2) : Math.max(20, remH*0.44-2);
        const yy = i%2===0 ? y : y + remH*0.56 + 2;
        rects += `<rect x="${x}" y="${yy}" width="${ww}" height="${hh}" fill="${paletteAt(i+1)}" rx="6"><title>${escHtml(row.label)}: ${row.value}</title></rect><text x="${x+7}" y="${yy+16}" fill="white" font-size="10.5" font-weight="700">${escHtml(row.label)}</text>`;
        x += ww + 2;
      });
    }
    host.innerHTML = `<svg viewBox="0 0 ${w} ${h}">${rects}</svg>`;
  }

  function groupItems(group){ return CHART_CATALOG.filter(item=>item.group===group); }
  function filteredItems(items){ const q=(chartPanelState.query||'').trim().toLowerCase(); return !q ? items : items.filter(item => `${item.name} ${item.group}`.toLowerCase().includes(q)); }
  function filteredGroups(){ return GROUP_ORDER.map(group => ({ group, items: filteredItems(groupItems(group)) })).filter(x=>x.items.length); }
  function tileHtml(item){ return `<button class="ccs-tile" data-chart-kind="${item.kind}"><div class="ccs-thumb">${chartSvg(item.kind)}</div><div class="ccs-name">${escHtml(item.name)}</div></button>`; }

  function renderMain(){
    const groups = filteredGroups();
    const body = groups.length ? groups.map(({group,items})=>{
      const featured = items.filter(item=>item.featured).slice(0,3);
      const top = featured.length ? featured : items.slice(0,3);
      return `<section class="ccs-group"><div class="ccs-group-head"><div class="ccs-group-title">${escHtml(group)}</div>${items.length>top.length?`<button class="ccs-seeall" data-chart-group="${escHtml(group)}">See all</button>`:''}</div><div class="ccs-featured">${top.map(tileHtml).join('')}</div></section>`;
    }).join('') : '<div class="ccs-empty">No charts match that search.</div>';
    panel.innerHTML = `<div class="ccs-head"><div class="ccs-head-main"><div class="ccs-title">Charts</div><div class="ccs-subtitle">Grouped chart types with quick picks</div></div><button class="ccs-close" data-chart-close aria-label="Close">×</button></div><div class="ccs-body"><label class="ccs-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg><input id="chart-search-input" placeholder="Search charts from Canva" value="${escHtml(chartPanelState.query)}"></label><button class="ccs-start" data-chart-start><svg viewBox="0 0 24 24"><path d="M4 12h16M12 4v16"></path></svg>Start with data</button>${body}<div class="ccs-foot"><div class="ccs-foot-badge">✱</div><div class="ccs-foot-copy"><strong>Chart library</strong><span>Choose a chart type, then edit its data in the Inspector.</span></div><button class="ccs-foot-btn" data-chart-start>Use now</button></div></div>`;
    bindChartPanel();
  }

  function renderGroup(group){
    const items = filteredItems(groupItems(group));
    panel.innerHTML = `<div class="ccs-head"><button class="ccs-back" data-chart-back aria-label="Back">‹</button><div class="ccs-head-main"><div class="ccs-title">${escHtml(group)}</div><div class="ccs-subtitle">All chart types in this group</div></div><button class="ccs-close" data-chart-close aria-label="Close">×</button></div><div class="ccs-body"><label class="ccs-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg><input id="chart-search-input" placeholder="Search this group" value="${escHtml(chartPanelState.query)}"></label><div class="ccs-group-page-head"><div class="ccs-group-title">${items.length} chart${items.length===1?'':'s'}</div><div class="ccs-chipline">${items.slice(0,3).map(item=>`<span class="ccs-chip">${escHtml(item.name)}</span>`).join('')}</div></div>${items.length?`<div class="ccs-all-grid">${items.map(tileHtml).join('')}</div>`:'<div class="ccs-empty">No charts match that search.</div>'}</div>`;
    bindChartPanel();
  }

  function bindChartPanel(){
    const input = panel.querySelector('#chart-search-input');
    if(input) input.oninput = () => { chartPanelState.query = input.value; renderChartPanel(); };
    panel.querySelectorAll('[data-chart-group]').forEach(btn=>btn.onclick=()=>{ chartPanelState.group = btn.dataset.chartGroup; renderChartPanel(); });
    panel.querySelector('[data-chart-back]')?.addEventListener('click', ()=>{ chartPanelState.group = null; renderChartPanel(); });
    panel.querySelectorAll('[data-chart-kind]').forEach(btn=>btn.onclick=()=>{
      const kind = btn.dataset.chartKind;
      const p = toWorld(innerWidth/2, innerHeight/2);
      const chart = addChart(p.x-210, p.y-140, kind);
      if(chart){ panel.classList.remove('show'); showInspector(true); }
    });
    panel.querySelectorAll('[data-chart-close]').forEach(btn=>btn.onclick=()=>panel.classList.remove('show'));
    panel.querySelectorAll('[data-chart-start]').forEach(btn=>btn.onclick=()=>{
      const p = toWorld(innerWidth/2, innerHeight/2);
      const chart = addChart(p.x-210, p.y-140, 'column');
      if(chart){ panel.classList.remove('show'); showInspector(true); focusInspectorData(); }
    });
  }

  function renderChartPanel(){ if(!panel) return; chartPanelState.group ? renderGroup(chartPanelState.group) : renderMain(); }
  function openChartPanel(force){
    if(!panel) return;
    const shouldShow = force===undefined ? !panel.classList.contains('show') : !!force;
    if(shouldShow){ oldShowInspector(false); renderChartPanel(); }
    panel.classList.toggle('show', shouldShow);
    document.getElementById('t-chart')?.classList.toggle('active', shouldShow);
  }
