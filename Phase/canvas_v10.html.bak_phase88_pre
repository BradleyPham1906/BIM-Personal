    requestAnimationFrame(function(){ railPending=false; addRailButtons(); syncRail(); });
  }).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});

  // ============ 2. AUTOCAD WINDOW / CROSSING SELECTION ============
  function wirePts(w){
    if(w.type==='rect'&&w.points&&w.points.length===2){
      var a=w.points[0],b=w.points[1];
      return [{x:a.x,y:a.y},{x:b.x,y:a.y},{x:b.x,y:b.y},{x:a.x,y:b.y}];
    }
    return w.points||[];
  }
  function ptIn(p,r){ return p.x>=r.x1&&p.x<=r.x2&&p.y>=r.y1&&p.y<=r.y2; }
