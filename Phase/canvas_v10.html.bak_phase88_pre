    board:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M12 17v4M8 21h8"/><path d="M7 7l4 6M17 6l-5 7"/></svg>',
