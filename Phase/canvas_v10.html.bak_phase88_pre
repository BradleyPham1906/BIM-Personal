  function canvasMenu(){return header('Canvas',null)+sec('Create',`<div class="figma-context-grid">${chip('card','Card')}${chip('text-box','Text')}${chip('table','Table')}${chip('chart','Chart')}${chip('whiteboard','Board')}${chip('group','Group')}${chip('image','Image')}${chip('upload','Upload')}</div>`)+sec('View',row('fitView','⌖','Zoom to fit')+row('resetView','100','Reset zoom'))+sec('Export',row('export','⧉','Copy canvas text'))}
  function edgeMenu(){return header('Connector',null)+sec('Line',`<div class="figma-context-grid three">${chip('edge-dash:solid','Solid')}${chip('edge-dash:dashed','Dash')}${chip('edge-dash:dotted','Dot')}</div><div class="figma-context-grid three" style="margin-top:5px">${chip('edge-dir:none','One')}${chip('edge-dir:both','Both')}${chip('edge-dir:back','Back')}</div>`)+sec('Actions',row('label','T','Edit label')+row('delete','⌫','Delete connector','',true))}
  function nodeMenu(n){let html=header(typeLabel(n),n); const common=sec('Actions',row('edit','✎',n?.type==='image'?'Edit image URL':n?.type==='whiteboard'?'Open draw tools':'Edit', n?.type==='text'?'Double click':'')+row('inspect','⌘','Open inspector')+row('dup','⧉','Duplicate','⌘D')+row('copy','□','Copy'));
