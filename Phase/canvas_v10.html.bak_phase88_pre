  function paint(){
    const body=$('#figma-layers-panel [data-fak-body]'); if(!body)return;
    if(stateUI.query){body.innerHTML=searchHtml(stateUI.query);return;}
    const f=ASSETS.find(x=>x.id===stateUI.folder)||ASSETS[0];
    body.innerHTML=palHtml(f);
  }
  // Drag-and-drop: pointer-based ghost drag from tile to canvas.
  let drag=null;
  function bindDrag(root){
    root.addEventListener('pointerdown',e=>{
      const tile=e.target.closest('[data-fak-item]'); if(!tile||e.button!==0)return;
