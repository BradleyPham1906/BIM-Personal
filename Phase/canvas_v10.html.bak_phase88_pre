  };

  // ============ SHARED COMMAND REGISTRY (palette == command line) ============
  var CADCMDS=[
    ['LINE',['L'],'line','Draw a line'],['PLINE',['PL','POLYLINE','POLY'],'poly','Draw a polyline'],
    ['RECTANG',['REC','RECT','RECTANGLE'],'rect','Draw a rectangle'],['CIRCLE',['C'],'circle','Draw a circle'],
    ['ARC',['A'],'arc','Draw a 3-point arc'],['ELLIPSE',['EL'],'ellipse','Draw an ellipse'],
    ['POLYGON',['POL'],'polygon','Draw a polygon'],['SKETCH',['DRAW'],'draw','Freehand sketch'],
    ['MTEXT',['T','MT'],'text','Text box'],['TEXT',['DT'],'text','Text box'],
    ['SPLINE',['SPL'],'spline','Spline through fit points'],['XLINE',['XL'],'xline','Construction line'],
    ['MLINE',['ML'],'mline','Multiline'],['DONUT',['DO'],'donut','Donut'],
    ['POINT',['PO'],'pointTool','Point'],['HATCH',['H','BH'],'hatch','Hatch closed region'],
    ['LEADER',['LE','QLEADER'],'leader','Leader balloon'],['TRIM',['TR'],'trim','Trim to intersection'],
    ['EXTEND',['EX'],'extend','Extend to boundary'],['FILLET',['F'],'fillet','Fillet two walls (radius 0)'],
    ['CHAMFER',['CHA'],'chamfer','Chamfer a corner between two walls'],['EXPLODE',['X'],'explode','Explode into segments'],
    ['MOVE',['M'],'moveTool','Move selection'],['COPY',['CO','CP'],'duplicate','Copy selection'],
    ['BREAK',['BR'],'break','Break a wall between two points'],
    ['BREAKATPOINT',['BRP','BREAKAT'],'breakat','Split a wall at one point'],
    ['LENGTHEN',['LEN'],'lengthen','Change a wall length at one end'],
    ['JOIN',['J'],'join','Join two colinear walls into one'],
    ['ALIGN',['AL'],'align','Align objects to the first selected'],
    ['ARRAYRECT',['AR','ARRAY','ARRAYCLASSIC'],'arrayRect','Rectangular array'],
    ['ARRAYPOLAR',['ARP'],'arrayPolar','Polar array'],
    ['ROTATE',['RO'],'rotate','Rotate about a base point'],['ROTATECCW',['RCC'],'rotCCW','Rotate 90 CCW'],
    ['ROTATE0',['RZ'],'rot0','Reset rotation'],['SCALE',['SC','SCU'],'scale','Scale about a base point'],
    ['SCALEDOWN',['SCD'],'scaleDown','Scale to 80%'],['MIRROR',['MI'],'mirror','Mirrored copy'],
    ['OFFSET',['O'],'offset','Parallel copy'],['ERASE',['E','DEL'],'del','Delete selection'],
    ['DIST',['DI','MEASURE'],'measure','Measure distance'],['DIMLINEAR',['DLI','DIM'],'bimDims','Linear dimension'],
    ['LAYER',['LA','LAYERS'],'layers','Layers panel'],['OSNAP',['OS'],'bimSnap','Toggle object snap'],
    ['ORTHO',[],'bimOrtho','Toggle ortho mode'],['GRID',[],'grid','Toggle grid'],
    ['ZOOM',['Z','ZE','FIT'],'zoomFit','Zoom to fit'],['ZOOMIN',['ZI'],'zoomIn','Zoom in'],
    ['ZOOMOUT',['ZO'],'zoomOut','Zoom out'],['ZOOM100',['Z1'],'view100','Zoom to 100%'],
    ['SELECTALL',['SA','ALL'],'selAll','Select every object'],['CLEAR',[],'selNone','Clear selection'],
    ['SHORTCUTS',['KEYS','HELP','?'],'shortcuts','Keyboard shortcuts']
  ];
  function runCadAct(act){
    /* __acad3dV86: in the BIM workspace these commands run against the BIM engine, and the
       fall-through below is NOT taken.

       That fall-through is why every palette command was dead: window.cadRun dispatches into
       WB[act], the retired Canvas whiteboard's table, which does not run in this workspace.
       Worse, this function returned true regardless of what cadRun did, so a command that did
       nothing still reported success and nothing ever surfaced the failure. */
    if(window.__a3dOn){
      try{ if(window.__a3dRunCmd)return !!window.__a3dRunCmd(act); }
      catch(e){ console.warn('[BIM] Palette command failed: '+act,e); }
      return false;
    }
    try{ if(typeof window.cadRun==='function'){ window.cadRun(act); return true; } }catch(e){}
    try{ if(window.RUN&&typeof RUN[act]==='function'){ RUN[act](); return true; } }catch(e){}
    return false;
  }
  var CANVASCMDS=[
    ['Select tool','V',function(){window.setTool&&setTool('select');}],
    ['Pan tool','H',function(){window.setTool&&setTool('pan');}],
    ['Add card','Ctrl N',function(){var p=toWorld(innerWidth/2,innerHeight/2);window.addCard&&addCard(p.x-165,p.y-95);}],
    ['Add table','',function(){var p=toWorld(innerWidth/2,innerHeight/2);window.addTable&&addTable(p.x-210,p.y-125);}],
    ['Add chart','',function(){var p=toWorld(innerWidth/2,innerHeight/2);window.addChart&&addChart(p.x-190,p.y-125);}],
    ['Duplicate selected','Ctrl D',function(){window.duplicateSelected&&duplicateSelected();}],
    ['Delete selected','Ctrl Del',function(){window.deleteSelected&&deleteSelected();}],
    ['Zoom to fit','',function(){window.zoomToFit&&zoomToFit();}],
    ['Toggle theme','',function(){var b=document.getElementById('t-theme');b&&b.click();}]
  ];
  var REGISTRY=[];
  CADCMDS.forEach(function(c){ REGISTRY.push({name:c[0],aliases:c[1],desc:c[3],cad:c[2]}); });
  CANVASCMDS.forEach(function(c){ REGISTRY.push({name:c[0],aliases:[],desc:c[1]?('Shortcut '+c[1]):'Canvas action',fn:c[2]}); });

  // Replace the old palette node (same id/classes so existing open/close/Ctrl+K keep working)
  function buildPalette(){
    var old=document.getElementById('uploaded-command-palette');
    var pal=document.createElement('div'); pal.id='uploaded-command-palette';
    pal.innerHTML='<div class="uc-input"><span>&gt;_</span><input placeholder="Type a command: LINE, PLINE, REC, CIRCLE\u2026" aria-label="Type a command"></div><div class="uc-results"></div>';
    if(old) old.replaceWith(pal); else document.body.appendChild(pal);
    var input=pal.querySelector('input'), results=pal.querySelector('.uc-results');
    var rows=[], active=0;
    function score(c,q){
      var Q=q.toUpperCase();
      if(c.name.toUpperCase()===Q) return 0;
      if(c.aliases.some(function(a){return a.toUpperCase()===Q;})) return 1;
      if(c.name.toUpperCase().indexOf(Q)===0) return 2;
      if(c.name.toUpperCase().indexOf(Q)>=0) return 3;
      if((c.desc||'').toUpperCase().indexOf(Q)>=0) return 4;
      return 99;
    }
    /* __acad3dV86: in the BIM workspace the palette offers only commands that RUN there.
       Everything it used to list dispatched into the retired Canvas whiteboard and did nothing;
       a shorter list of working commands beats a long list of dead ones. */
    function pool(){
      if(window.__a3dOn&&window.__a3dCmdSupported){
        return REGISTRY.filter(function(c){return c.cad&&window.__a3dCmdSupported(c.cad);});
      }
      return REGISTRY;
    }
    function draw(){
      var q=input.value.trim(),P=pool();
      rows=!q?P.slice(0,14):P.map(function(c){return {c:c,s:score(c,q)};}).filter(function(r){return r.s<99;}).sort(function(a,b){return a.s-b.s;}).slice(0,14).map(function(r){return r.c;});
      active=0;
      results.innerHTML=rows.map(function(c,i){
        var key=c.aliases&&c.aliases.length?c.aliases[0]:(c.desc&&c.desc.indexOf('Shortcut')===0?c.desc.replace('Shortcut ',''):'');
        return '<div class="uc-row'+(i===0?' active':'')+'" data-idx="'+i+'"><span>'+c.name+(c.cad?' <span style="opacity:.45;font-weight:500">\u2014 '+c.desc+'</span>':'')+'</span><span class="uc-key">'+key+'</span></div>';
      }).join('')||'<div class="uc-row">No matching command</div>';
    }
    function highlight(){
      Array.prototype.forEach.call(results.children,function(el,i){el.classList.toggle('active',i===active);});
    }
    /* __acad3dV86: hand the keyboard back to the drawing.

       The BIM key chain begins "if the event target is an INPUT, return", so leaving focus in
       the palette's hidden input meant every keystroke AFTER a command was swallowed: the tool
       started, and then typing a coordinate, pressing C to close or pressing Escape to cancel
       all did nothing at all. Measured: activeElement was INPUT and the typing buffer stayed
       empty. A command line that keeps the keyboard after it runs is not a command line. */
    function closePal(){
      pal.classList.remove('show');
      try{input.blur();}catch(eB){}
      try{if(document.activeElement===input)document.body.focus();}catch(eF){}
    }
    function runIdx(i){
      var c=rows[i]; if(!c) return;
      closePal();
      /* A command that cannot run says so, instead of closing the palette over nothing. */
      var ok=c.cad?runCadAct(c.cad):(c.fn?(c.fn(),true):false);
      if(!ok&&window.toast)try{window.toast(c.name+' is not available here');}catch(eT){}
    }
    input.addEventListener('input',draw);
    input.addEventListener('keydown',function(e){
      if(e.key==='ArrowDown'){active=Math.min(rows.length-1,active+1);highlight();e.preventDefault();}
      else if(e.key==='ArrowUp'){active=Math.max(0,active-1);highlight();e.preventDefault();}
      else if(e.key==='Enter'){runIdx(active);e.preventDefault();e.stopPropagation();}
      else if(e.key==='Escape'){closePal();}
    });
    results.addEventListener('pointerdown',function(e){
      var row=e.target.closest('.uc-row'); if(!row||row.dataset.idx===undefined) return;
      e.preventDefault(); e.stopPropagation();
      runIdx(+row.dataset.idx);
    });
    draw();
    window.__wsPaletteCount=REGISTRY.length;
  }
  buildPalette();

  // ============ MULTI-DRAWING DOC TABS + START SCREEN ============
  var DKEY='acadDrawingsV1';
  function loadDwg(){
    try{var d=JSON.parse(localStorage.getItem(DKEY)||'null'); if(d&&d.list&&d.list.length) return d;}catch(e){}
    return {active:'d1',list:[{id:'d1',name:'Drawing1'}],store:{}};
  }
  var DWG=loadDwg();
  function persistDwg(){ try{localStorage.setItem(DKEY,JSON.stringify(DWG));}catch(e){} }
  function deepWires(ws){ try{return JSON.parse(JSON.stringify(ws||[]));}catch(e){return [];} }
  function dwgCount(id){
    var d=DWG.list.find(function(x){return x.id===id;});
    if(id===DWG.active&&!(d&&d.closed)) return (state.wires||[]).length;
    return (DWG.store[id]||[]).length;
  }
  function switchDrawing(id){
    hideStart();
    var dd=DWG.list.find(function(x){return x.id===id;});
    if(dd&&dd.closed){ dd.closed=false; persistDwg(); }
    if(id===DWG.active){
      if(DWG.store[id]){
        state.wires=deepWires(DWG.store[id]);
        delete DWG.store[id];
        persistDwg();
        try{save();}catch(e){}
        try{renderAll();}catch(e){}
      }
      renderDocTabs(); return;
    }
    DWG.store[DWG.active]=deepWires(state.wires);
    state.wires=deepWires(DWG.store[id]||[]);
    delete DWG.store[id];
    DWG.active=id;
    persistDwg();
    try{save();}catch(e){}
    try{renderAll();}catch(e){}
    renderDocTabs();
    try{window.toast&&toast('Switched to '+((DWG.list.find(function(d){return d.id===id;})||{}).name||''));}catch(e){}
  }
  function newDrawing(){
    var n=DWG.list.length+1, id='d'+Date.now();
    while(DWG.list.some(function(d){return d.name==='Drawing'+n;})) n++;
    DWG.store[DWG.active]=deepWires(state.wires);
    DWG.list.push({id:id,name:'Drawing'+n});
    DWG.active=id;
    state.wires=[];
    persistDwg();
    try{save();}catch(e){}
    try{renderAll();}catch(e){}
    renderDocTabs(); hideStart();
    try{window.toast&&toast('Created Drawing'+n);}catch(e){}
  }
  function renameDrawing(id,btn){
    var d=DWG.list.find(function(x){return x.id===id;}); if(!d) return;
    var inp=document.createElement('input'); inp.className='dt-rename'; inp.value=d.name;
    btn.replaceWith(inp); inp.focus(); inp.select();
    function commit(){ d.name=inp.value.trim()||d.name; persistDwg(); renderDocTabs(); }
    inp.addEventListener('blur',commit);
    inp.addEventListener('keydown',function(e){ if(e.key==='Enter'){e.preventDefault();inp.blur();} if(e.key==='Escape'){inp.value=d.name;inp.blur();} });
  }
  function closeDrawing(id){
    var d=DWG.list.find(function(x){return x.id===id;}); if(!d||d.closed) return;
    if(id===DWG.active){ DWG.store[id]=deepWires(state.wires); }
    d.closed=true;
    if(id===DWG.active){
      var open=DWG.list.filter(function(x){return !x.closed;});
      if(open.length){
        var nx=open[open.length-1];
        state.wires=deepWires(DWG.store[nx.id]||[]);
        delete DWG.store[nx.id];
        DWG.active=nx.id;
        try{save();}catch(e){}
        try{renderAll();}catch(e){}
      }else{
        state.wires=[];
        try{save();}catch(e){}
        try{renderAll();}catch(e){}
        showStart();
      }
    }
    persistDwg();
    renderDocTabs();
    try{window.toast&&toast('Saved and closed '+d.name);}catch(e){}
  }
  window.__wsCloseDrawing=closeDrawing;
  function renderDocTabs(){
    var dt=document.getElementById('acad-doctabs'); if(!dt) return;
    var html='<button class="acad-doctab" data-dt="start">Start</button>';
    DWG.list.forEach(function(d){
      if(d.closed) return;
      html+='<button class="acad-doctab'+(d.id===DWG.active&&!startShown()?' active':'')+'" data-dt="'+d.id+'" title="Double-click to rename">'+d.name.replace(/[&<>]/g,'')+'<span class="dt-x" data-dtx="'+d.id+'" title="Save and close">\u00d7</span></button>';
    });
    html+='<button class="acad-doctab acad-plus" data-dt="plus" title="New drawing">+</button>';
    dt.innerHTML=html;
  }
  function startShown(){ var s=document.getElementById('acad-start'); return !!(s&&s.classList.contains('show')); }
  function buildStart(){
    var s=document.getElementById('acad-start');
    if(!s){ s=document.createElement('div'); s.id='acad-start'; document.body.appendChild(s); }
    var cards=DWG.list.map(function(d){
      return '<div class="st-card" data-open="'+d.id+'"><div class="st-name">'+d.name.replace(/[&<>]/g,'')+'</div><div class="st-meta">'+dwgCount(d.id)+' objects'+(d.id===DWG.active?' \u00b7 current':'')+'</div></div>';
    }).join('');
    s.innerHTML='<div class="st-wrap"><h1>Start</h1><div class="st-sub">Ultimate Canvas \u2014 drafting workspace</div><div class="st-cols"><div class="st-left"><button data-st="new">New Drawing</button><button class="st-sec" data-st="continue">Continue Drawing</button></div><div class="st-right"><div class="st-sect">Recent Drawings</div><div class="st-grid">'+cards+'</div></div></div></div>';
  }
  function showStart(){ buildStart(); document.getElementById('acad-start').classList.add('show'); renderDocTabs(); }
  function hideStart(){ var s=document.getElementById('acad-start'); if(s) s.classList.remove('show'); }
  document.addEventListener('click',function(e){
    var xx=e.target.closest&&e.target.closest('#acad-doctabs [data-dtx]');
    if(xx){ e.preventDefault(); e.stopPropagation(); closeDrawing(xx.getAttribute('data-dtx')); return; }
    var t=e.target.closest&&e.target.closest('#acad-doctabs [data-dt]');
    if(t){
      var v=t.getAttribute('data-dt');
      if(v==='start') showStart();
      else if(v==='plus') newDrawing();
      else switchDrawing(v);
      return;
    }
    var st=e.target.closest&&e.target.closest('#acad-start [data-st], #acad-start [data-open]');
    if(st){
      if(st.getAttribute('data-st')==='new') newDrawing();
      else if(st.getAttribute('data-st')==='continue'){ switchDrawing(DWG.active); }
      else switchDrawing(st.getAttribute('data-open'));
    }
  });
  document.addEventListener('dblclick',function(e){
    var t=e.target.closest&&e.target.closest('#acad-doctabs [data-dt]');
    if(t&&t.getAttribute('data-dt')!=='start'&&t.getAttribute('data-dt')!=='plus') renameDrawing(t.getAttribute('data-dt'),t);
  });
  var dtBoot=0;
  (function bootTabs(){ if(document.getElementById('acad-doctabs')){renderDocTabs();return;} if(++dtBoot<40) setTimeout(bootTabs,250); })();

  // Restore layers/activeLayer stripped by sanitizeState on reload (mutate in place so CAD.layers ref stays valid)
  (function restoreLayers(){
    try{
      var o=JSON.parse(localStorage.getItem('obsidian-canvas-enhanced-v6')||'null');
      var st=o&&(o.state||o);
      if(st&&Array.isArray(st.layers)&&st.layers.length){
        if(!state.layers) state.layers=[];
        state.layers.length=0;
        st.layers.forEach(function(l){ if(l&&l.id) state.layers.push(l); });
        if(st.activeLayer) state.activeLayer=st.activeLayer;
        if(st.activeLyr) state.activeLyr=st.activeLyr;
        if(window.CAD){ CAD.layers=state.layers; if(st.activeLyr) CAD.activeLyr=st.activeLyr; }
      }
    }catch(e){}
  })();

  // ============ CLICK-TO-SELECT + PROPERTIES DOCK ============
  function ensureLayers(){
    if(!state.layers||!state.layers.length){
      state.layers=[{id:'layer-0',name:'0',color:'#e2e8f0',visible:true}];
    }
    (state.wires||[]).forEach(function(w){
      if(w.layerId&&!state.layers.some(function(l){return l.id===w.layerId;}))
        state.layers.push({id:w.layerId,name:String(w.layerId).replace(/^layer-/,''),color:'#e2e8f0',visible:true});
    });
    if(state.activeLyr&&state.layers.some(function(l){return l.id===state.activeLyr;})) state.activeLayer=state.activeLyr;
    else if(!state.activeLayer||!state.layers.some(function(l){return l.id===state.activeLayer;})) state.activeLayer=state.layers[0].id;
  }
  function wirePts(w){
    if(w.type==='rect'&&w.points&&w.points.length===2){
      var a=w.points[0],b=w.points[1];
      return [{x:a.x,y:a.y},{x:b.x,y:a.y},{x:b.x,y:b.y},{x:a.x,y:b.y},{x:a.x,y:a.y}];
    }
    return w.points||[];
  }
  function hitTestWire(wp){
    var tol=10/((view&&view.z)||1), best=null, bd=Infinity;
    (state.wires||[]).forEach(function(w){
      var layer=state.layers&&state.layers.find&&state.layers.find(function(l){return l.id===w.layerId;});
      if(layer&&(!layer.visible||layer.locked)) return;
      if(w.type==='circle'&&w.cx!==undefined){
        var d=Math.abs(Math.hypot(wp.x-w.cx,wp.y-w.cy)-w.radius);
        if(d<tol&&d<bd){bd=d;best=w;}
        return;
      }
      var P=wirePts(w); if(P.length<2) return;
      var n=w.closed?P.length:P.length-1;
      for(var i=0;i<n;i++){
        var a=P[i],b=P[(i+1)%P.length];
        var dx=b.x-a.x,dy=b.y-a.y,l2=dx*dx+dy*dy;
        var t=l2<1e-9?0:Math.max(0,Math.min(1,((wp.x-a.x)*dx+(wp.y-a.y)*dy)/l2));
        var d2=Math.hypot(wp.x-(a.x+t*dx),wp.y-(a.y+t*dy));
        if(d2<tol&&d2<bd){bd=d2;best=w;}
      }
    });
    return best;
  }
  window.__wsHitTest=hitTestWire;
  var blockPlace=null; // pending block insertion
  document.addEventListener('pointerdown',function(e){
    window.__wsPick='enter';
    var vp=document.getElementById('viewport');
    if(!vp||!vp.contains(e.target)) { window.__wsPick='notvp'; return; }
    if(e.button!==0) { window.__wsPick='btn'; return; }
    var wp=toWorld(e.clientX,e.clientY);
    if(blockPlace){ placeBlockAt(wp); e.preventDefault(); e.stopImmediatePropagation(); return; }
    if(typeof tool!=='undefined'&&tool!=='select') { window.__wsPick='tool:'+tool; return; }
    if(typeof spaceDown!=='undefined'&&spaceDown) { window.__wsPick='space'; return; }
    if(window.__draftActiveTool&&window.__draftActiveTool()) { window.__wsPick='draft'; return; }
    if(vp.classList.contains('acadpro-pick')) { window.__wsPick='pick'; return; }
    if(e.target.classList&&(e.target.classList.contains('anchor')||e.target.classList.contains('rh'))) { window.__wsPick='anchor'; return; }
    var hit=hitTestWire(wp);
    window.__wsPick='hit:'+(hit?hit.id:'none');
    if(hit){
      if(e.shiftKey){ hit.selected=!hit.selected; }
      else if(!hit.selected){ (state.wires||[]).forEach(function(w){w.selected=false;}); hit.selected=true; }
      try{renderAll();}catch(err){}
      openDock('props');
      e.preventDefault(); e.stopImmediatePropagation();
    } else {
      var had=(state.wires||[]).some(function(w){return w.selected;});
      if(had){ (state.wires||[]).forEach(function(w){w.selected=false;}); try{renderAll();}catch(err){} scheduleDock(); }
    }
  },true);

  // ---- Dock UI ----
  var dockTab='props';
  function dockState(){ try{return JSON.parse(localStorage.getItem('acadDockV1')||'{}');}catch(e){return {};} }
  function saveDock(patch){ var s=dockState(); Object.assign(s,patch); try{localStorage.setItem('acadDockV1',JSON.stringify(s));}catch(e){} }
  function buildDock(){
    if(document.getElementById('acad-dock')) return;
    var rail=document.createElement('div'); rail.id='acad-dock';
    rail.innerHTML='<button data-dk="props" title="Object properties">'+SVGI.props+'<span>Prop.</span></button><button data-dk="layers" title="Layers">'+SVGI.layers+'<span>Layers</span></button><button data-dk="blocks" title="Blocks">'+SVGI.blocks+'<span>Blocks</span></button>';
    document.body.appendChild(rail);
    var panel=document.createElement('div'); panel.id='acad-dockpanel';
    panel.innerHTML='<div class="dk-head"><span id="dk-title">Properties</span><button id="dk-close" title="Close panel">\u00d7</button></div><div class="dk-body" id="dk-body"></div>';
    document.body.appendChild(panel);
    rail.addEventListener('click',function(e){
      var b=e.target.closest('button[data-dk]'); if(!b) return;
      var k=b.getAttribute('data-dk');
      if(panel.classList.contains('open')&&dockTab===k){ closeDock(); }
      else openDock(k,true);
    });
    panel.querySelector('#dk-close').addEventListener('click',function(){ closeDock(); });
    var st=dockState();
    if(st.open){ dockTab=st.tab||'props'; openDock(dockTab,true); }
  }
  function openDock(tab,force){
    dockTab=tab||'props';
    var panel=document.getElementById('acad-dockpanel'); if(!panel) return;
    panel.classList.add('open');
    Array.prototype.forEach.call(document.querySelectorAll('#acad-dock button'),function(b){ b.classList.toggle('on',b.getAttribute('data-dk')===dockTab); });
    saveDock({open:true,tab:dockTab});
    renderDock();
  }
  function closeDock(){
    var panel=document.getElementById('acad-dockpanel'); if(panel) panel.classList.remove('open');
    Array.prototype.forEach.call(document.querySelectorAll('#acad-dock button'),function(b){ b.classList.remove('on'); });
    saveDock({open:false});
  }
  function fmt(n){ return Math.round(n*100)/100; }
  function wireLen(w){
    if(w.type==='circle') return 2*Math.PI*w.radius;
    var P=wirePts(w), L=0, n=w.closed?P.length:P.length-1;
    for(var i=0;i<n;i++){var a=P[i],b=P[(i+1)%P.length];L+=Math.hypot(b.x-a.x,b.y-a.y);}
    return L;
  }
  function wireArea(w){
    if(w.type==='circle') return Math.PI*w.radius*w.radius;
    if(!w.closed&&w.type!=='rect') return 0;
    var P=wirePts(w), A=0;
    for(var i=0;i<P.length;i++){var a=P[i],b=P[(i+1)%P.length];A+=a.x*b.y-b.x*a.y;}
    return Math.abs(A/2);
  }
  function typeName(w){
    if(w.type==='circle') return 'Circle';
    if(w.type==='rect') return 'Rectangle';
    if(w.closed) return 'Polyline (closed)';
    return (w.points&&w.points.length===2)?'Line':'Polyline';
  }
  function layerOptions(cur){
    ensureLayers();
    return state.layers.map(function(l){return '<option value="'+l.id+'"'+(l.id===cur?' selected':'')+'>'+String(l.name).replace(/[&<>]/g,'')+'</option>';}).join('');
  }
  function renderDock(){
    var body=document.getElementById('dk-body'), title=document.getElementById('dk-title');
    if(!body) return;
    ensureLayers();
    if(dockTab==='props'){
      title.textContent='Properties';
      var sel=(state.wires||[]).filter(function(w){return w.selected;});
      if(sel.length===0){
        body.innerHTML='<div class="dk-sect">Drawing</div>'+
          '<div class="dk-row"><label>Name</label><span class="dk-ro">'+(((DWG.list.find(function(d){return d.id===DWG.active;})||{}).name)||'Drawing1')+'</span></div>'+
          '<div class="dk-row"><label>Objects</label><span class="dk-ro">'+(state.wires||[]).length+'</span></div>'+
          '<div class="dk-row"><label>Layers</label><span class="dk-ro">'+state.layers.length+'</span></div>'+
          '<div class="dk-empty">Click an object in the drawing to see and edit its properties. Shift-click adds to the selection.</div>';
        return;
      }
      var w=sel[0], multi=sel.length>1;
      var html='<div class="dk-sect">'+(multi?sel.length+' objects':typeName(w))+'</div>'+
        '<div class="dk-row"><label>Layer</label><span class="dk-val"><select id="dkp-layer">'+layerOptions(w.layerId)+'</select></span></div>'+
        '<div class="dk-row"><label>Color</label><span class="dk-val"><input type="color" id="dkp-color" value="'+(/^#[0-9a-fA-F]{6}$/.test(w.color||'')?w.color:'#e2e8f0')+'"></span></div>'+
        '<div class="dk-row"><label>Lineweight</label><span class="dk-val"><input type="number" id="dkp-lw" min="0.5" max="10" step="0.5" value="'+(w.lineWidth||1.5)+'"></span></div>'+
        '<div class="dk-row"><label>Linetype</label><span class="dk-val"><select id="dkp-ls">'+['solid','dashed','dotted'].map(function(s){return '<option'+(s===(w.lineStyle||'solid')?' selected':'')+'>'+s+'</option>';}).join('')+'</select></span></div>';
      if(!multi){
        html+='<div class="dk-sect">Geometry</div>';
        if(w.type==='circle'){
          html+='<div class="dk-row"><label>Radius</label><span class="dk-val"><input type="number" id="dkp-rad" min="1" step="1" value="'+fmt(w.radius)+'"></span></div>'+
            '<div class="dk-row"><label>Circumference</label><span class="dk-ro">'+fmt(wireLen(w))+'</span></div>'+
            '<div class="dk-row"><label>Area</label><span class="dk-ro">'+fmt(wireArea(w))+'</span></div>'+
            '<div class="dk-row"><label>Center</label><span class="dk-ro">'+fmt(w.cx)+', '+fmt(w.cy)+'</span></div>';
        } else {
          html+='<div class="dk-row"><label>Vertices</label><span class="dk-ro">'+(w.points||[]).length+'</span></div>'+
            '<div class="dk-row"><label>Length</label><span class="dk-ro">'+fmt(wireLen(w))+'</span></div>';
          if(w.closed||w.type==='rect') html+='<div class="dk-row"><label>Area</label><span class="dk-ro">'+fmt(wireArea(w))+'</span></div>';
        }
      }
      body.innerHTML=html;
      function applyAll(fn){ sel.forEach(fn); try{save();}catch(e){} try{renderAll();}catch(e){} }
      var el;
      if((el=body.querySelector('#dkp-layer'))) (function(inp){ inp.addEventListener('change',function(){ var v=inp.value; applyAll(function(w){w.layerId=v;}); }); })(el);
      if((el=body.querySelector('#dkp-color'))) (function(inp){ inp.addEventListener('input',function(){ applyAll(function(w){w.color=inp.value;w.colorOwn=true;}); }); })(el);
      if((el=body.querySelector('#dkp-lw'))) (function(inp){ inp.addEventListener('change',function(){ var v=parseFloat(inp.value)||1.5; applyAll(function(w){w.lineWidth=v;}); }); })(el);
      if((el=body.querySelector('#dkp-ls'))) (function(inp){ inp.addEventListener('change',function(){ applyAll(function(w){w.lineStyle=inp.value;}); }); })(el);
      if((el=body.querySelector('#dkp-rad'))) (function(inp){ inp.addEventListener('change',function(){ var v=Math.max(1,parseFloat(inp.value)||1); applyAll(function(w){ if(w.type==='circle') w.radius=v; }); }); })(el);
    }
    else if(dockTab==='layers'){
      title.textContent='Layers';
      var cnt={}; (state.wires||[]).forEach(function(w){ var k=w.layerId||'layer-0'; cnt[k]=(cnt[k]||0)+1; });
      var LK_ON='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
      var LK_OFF='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-2"/></svg>';
      var rows=state.layers.map(function(l){
        var used=cnt[l.id]||0;
        return '<div class="dk-ltr'+(l.id===state.activeLayer?' cur':'')+(l.locked?' lk':'')+'" data-lid="'+l.id+'">'+
          '<span class="dk-ltc st" title="Set current layer">'+(l.id===state.activeLayer?'<span class="dk-curdot"></span>':'')+'</span>'+
          '<span class="dk-ltc"><button class="dk-eye'+(l.visible===false?' off':'')+'" data-eye="'+l.id+'" title="Layer on/off">'+(l.visible===false?SVGI.eyeOff:SVGI.eyeOn)+'</button></span>'+
          '<span class="dk-ltc"><input type="color" data-lcolor="'+l.id+'" value="'+(/^#[0-9a-fA-F]{6}$/.test(l.color||'')?l.color:'#e2e8f0')+'" title="Layer color"></span>'+
          '<span class="dk-ltc nm"><input type="text" data-lname="'+l.id+'" value="'+String(l.name).replace(/[&<>"]/g,'')+'" title="Rename layer" spellcheck="false"></span>'+
          '<span class="dk-ltc"><button class="dk-lock'+(l.locked?' on':'')+'" data-lock="'+l.id+'" title="Lock/unlock layer">'+(l.locked?LK_ON:LK_OFF)+'</button></span>'+
          '<span class="dk-ltc ct" title="Objects on layer">'+used+'</span>'+
          '<span class="dk-ltc"><button class="dk-ldel" data-ldel="'+l.id+'" title="'+(used?'Layer in use':(state.layers.length<2?'Cannot delete last layer':'Delete layer'))+'"'+((used||state.layers.length<2)?' disabled':'')+'>\u00d7</button></span>'+
        '</div>';
      }).join('');
      body.innerHTML='<div class="dk-ltable"><div class="dk-ltr hd"><span class="dk-ltc st"></span><span class="dk-ltc">On</span><span class="dk-ltc">Color</span><span class="dk-ltc nm">Name</span><span class="dk-ltc">Lock</span><span class="dk-ltc ct">#</span><span class="dk-ltc"></span></div>'+rows+'</div>'+
        '<button class="dk-btn dk-sub" id="dk-addlayer">New Layer</button>'+
        '<div class="dk-empty">Click a row to set the current layer — new objects use its color. On/off hides a layer. Lock keeps it visible but unselectable. Layer color recolors its objects unless overridden in Properties.</div>';
      function rw(){ try{save();}catch(err){} try{renderAll();}catch(err){} try{window.__cadRenderWires&&window.__cadRenderWires();}catch(err){} }
      Array.prototype.forEach.call(body.querySelectorAll('.dk-ltr[data-lid]'),function(r){
        r.addEventListener('click',function(e){
          if(e.target.closest('button')||e.target.closest('input')) return;
          state.activeLayer=r.getAttribute('data-lid');
          state.activeLyr=state.activeLayer;
          if(window.CAD) CAD.activeLyr=state.activeLayer;
          try{save();}catch(err){} renderDock();
        });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-eye]'),function(b){
        b.addEventListener('click',function(){
          var l=state.layers.find(function(x){return x.id===b.getAttribute('data-eye');});
          if(l){ l.visible=(l.visible===false); rw(); renderDock(); }
        });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-lock]'),function(b){
        b.addEventListener('click',function(){
          var l=state.layers.find(function(x){return x.id===b.getAttribute('data-lock');});
          if(l){ l.locked=!l.locked; if(l.locked) (state.wires||[]).forEach(function(w){ if((w.layerId||'layer-0')===l.id) w.selected=false; }); rw(); renderDock(); }
        });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-lcolor]'),function(inp){
        inp.addEventListener('input',function(){
          var l=state.layers.find(function(x){return x.id===inp.getAttribute('data-lcolor');});
          if(l){ l.color=inp.value; (state.wires||[]).forEach(function(w){ if((w.layerId||'layer-0')===l.id&&!w.colorOwn) w.color=inp.value; }); rw(); }
        });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-lname]'),function(inp){
        inp.addEventListener('change',function(){
          var l=state.layers.find(function(x){return x.id===inp.getAttribute('data-lname');});
          var v=inp.value.replace(/[&<>"]/g,'').trim();
          if(l&&v){ l.name=v; try{save();}catch(err){} renderDock(); try{window.toast&&toast('Layer renamed to '+v);}catch(err){} }
          else renderDock();
        });
        inp.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); inp.blur(); } e.stopPropagation(); });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-ldel]'),function(b){
        b.addEventListener('click',function(){
          var id=b.getAttribute('data-ldel');
          var used=(state.wires||[]).some(function(w){return (w.layerId||'layer-0')===id;});
          if(used||state.layers.length<2) return;
          for(var li=state.layers.length-1;li>=0;li--){ if(state.layers[li].id===id) state.layers.splice(li,1); }
          if(state.activeLayer===id){ state.activeLayer=state.layers[0].id; state.activeLyr=state.activeLayer; if(window.CAD) CAD.activeLyr=state.activeLayer; }
          rw(); renderDock();
        });
      });
      body.querySelector('#dk-addlayer').addEventListener('click',function(){
        var n=state.layers.length;
        state.layers.push({id:'layer-'+Date.now(),name:'Layer '+n,color:'#e2e8f0',visible:true,locked:false});
        try{save();}catch(err){} renderDock();
      });
    }
    else if(dockTab==='blocks'){
      title.textContent='Blocks';
      var blocks=loadBlocks();
      var selCount=(state.wires||[]).filter(function(w){return w.selected;}).length;
      var list=blocks.map(function(b){
        return '<div class="dk-brow" data-bid="'+b.id+'"><span class="dk-bname">'+String(b.name).replace(/[&<>]/g,'')+'</span><span style="color:#7f858c;font-size:11px">'+b.wires.length+'</span><button data-ins="'+b.id+'">Insert</button><button data-delb="'+b.id+'" title="Delete block">\u00d7</button></div>';
      }).join('');
      body.innerHTML='<button class="dk-btn" id="dk-mkblock"'+(selCount?'':' disabled')+'>Create Block from Selection ('+selCount+')</button>'+
        '<div class="dk-sect">Block Library</div>'+(list||'<div class="dk-empty">No blocks yet. Select objects in the drawing, then create a block. Insert places a copy anywhere you click.</div>');
      body.querySelector('#dk-mkblock').addEventListener('click',function(){
        var sel=(state.wires||[]).filter(function(w){return w.selected;});
        if(!sel.length) return;
        var cx=0,cy=0,n=0;
        sel.forEach(function(w){ if(w.type==='circle'){cx+=w.cx;cy+=w.cy;n++;} else wirePts(w).forEach(function(p){cx+=p.x;cy+=p.y;n++;}); });
        cx/=n||1; cy/=n||1;
        var copy=deepWires(sel);
        copy.forEach(function(w){
          delete w.selected;
          if(w.type==='circle'){w.cx-=cx;w.cy-=cy;}
          else (w.points||[]).forEach(function(p){p.x-=cx;p.y-=cy;});
        });
        var blocks2=loadBlocks();
        blocks2.push({id:'b'+Date.now(),name:'Block '+(blocks2.length+1),wires:copy});
        saveBlocks(blocks2); renderDock();
        try{window.toast&&toast('Block created ('+copy.length+' objects)');}catch(e){}
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-ins]'),function(b){
        b.addEventListener('click',function(){
          var blk=loadBlocks().find(function(x){return x.id===b.getAttribute('data-ins');});
          if(!blk) return;
          blockPlace=blk;
          var h=document.getElementById('acadst-hint'); if(h) h.textContent='INSERT '+blk.name+': click a point in the drawing (Esc to cancel)';
          try{window.toast&&toast('Click in the drawing to place '+blk.name);}catch(e){}
        });
      });
      Array.prototype.forEach.call(body.querySelectorAll('[data-delb]'),function(b){
        b.addEventListener('click',function(){
          saveBlocks(loadBlocks().filter(function(x){return x.id!==b.getAttribute('data-delb');}));
          renderDock();
        });
      });
    }
  }
  function loadBlocks(){ try{return JSON.parse(localStorage.getItem('acadBlocksV1')||'[]');}catch(e){return [];} }
  function saveBlocks(b){ try{localStorage.setItem('acadBlocksV1',JSON.stringify(b));}catch(e){} }
  function placeBlockAt(wp){
    if(!blockPlace) return;
    var copies=deepWires(blockPlace.wires);
    copies.forEach(function(w){
      w.id='w'+Date.now()+Math.floor(Math.random()*99999);
      w.selected=false;
      if(w.type==='circle'){w.cx+=wp.x;w.cy+=wp.y;}
      else (w.points||[]).forEach(function(p){p.x+=wp.x;p.y+=wp.y;});
      state.wires.push(w);
    });
    blockPlace=null;
    var h=document.getElementById('acadst-hint'); if(h) h.textContent='';
    try{save();}catch(e){} try{renderAll();}catch(e){}
  }
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&blockPlace){ blockPlace=null; var h=document.getElementById('acadst-hint'); if(h) h.textContent=''; } },true);
  var dockScheduled=false;
  function scheduleDock(){
    if(dockScheduled) return; dockScheduled=true;
    requestAnimationFrame(function(){ dockScheduled=false;
      var p=document.getElementById('acad-dockpanel');
      if(p&&p.classList.contains('open')) renderDock();
    });
  }
  (function wrapRenderForDock(){
    var orig=window.renderAll;
    if(typeof orig==='function'&&!orig.__dockWrapped){
      var f=function(){ var r=orig.apply(this,arguments); scheduleDock(); return r; };
      f.__dockWrapped=true; window.renderAll=f;
    }
  })();
  buildDock();

  window.__wsState=function(){
    var panel=document.getElementById('acad-dockpanel');
    return {
      drawings:DWG.list.map(function(d){return d.name;}), active:DWG.active,
      startShown:startShown(), dockOpen:!!(panel&&panel.classList.contains('open')), dockTab:dockTab,
      paletteCount:window.__wsPaletteCount||0, blocks:loadBlocks().length, placing:!!blockPlace
    };
  };

  }catch(err){window.__wsErr=String(err&&err.stack||err);}
})();
</script>


<style id="acad-ws2-css">
