    for(i=0;i<bytes.length;i++)s+=String.fromCharCode(bytes[i]);
    return s;
  }

  // ---- DXF (AutoCAD ASCII exchange format) ----
  var DXF_ACI={1:'#ff5555',2:'#e8d24a',3:'#5ac25a',4:'#4ac6c6',5:'#5a7fe0',6:'#c85ac0',7:'#d8d8d8',8:'#8a8a8a',9:'#bcbcbc'};
