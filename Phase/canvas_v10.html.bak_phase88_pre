  /* ===== WHITEBOARD CARD + APPLE TOOLBAR ===== */

  /* --- Apple Dynamic Island toolbar --- */
  #wb-bar {
    position: fixed;
    left: 50%;
    top: 20px;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    background: rgba(18,18,20,.96);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 44px;
    padding: 6px 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.3);
    backdrop-filter: blur(28px) saturate(2);
    -webkit-backdrop-filter: blur(28px) saturate(2);
    z-index: 202;
    user-select: none;
    /* overflow hidden + max-width drive the island expand animation */
    max-width: 58px;
    overflow: hidden;
    transition:
      max-width .4s cubic-bezier(.34,1.42,.64,1),
      padding   .4s cubic-bezier(.34,1.42,.64,1),
      box-shadow .3s ease;
    white-space: nowrap;
    gap: 2px;
  }
  #wb-bar.show { display:flex; }
  #wb-bar.expanded {
    max-width: 960px;
    padding: 6px 12px;
    box-shadow: 0 12px 48px rgba(0,0,0,.65), 0 4px 12px rgba(0,0,0,.4);
  }
  /* expand button always visible */
  #wb-expand-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgba(255,255,255,.85);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background .13s;
    z-index: 1;
  }
  #wb-expand-btn:hover { background: rgba(255,255,255,.1); }
  #wb-expand-btn .wb-expand-icon { transition: transform .35s cubic-bezier(.34,1.3,.64,1); }
  #wb-bar.expanded #wb-expand-btn .wb-expand-icon { transform: rotate(180deg); }
  /* slide wrapper - only fades/slides in when expanded */
  #wb-slide {
    display: flex;
    align-items: center;
    gap: 3px;
    opacity: 0;
    transform: scaleX(.7);
    transform-origin: left center;
    transition:
      opacity .25s ease .1s,
      transform .35s cubic-bezier(.34,1.3,.64,1) .05s;
    pointer-events: none;
    flex-shrink: 0;
  }
  #wb-bar.expanded #wb-slide {
    opacity: 1;
    transform: scaleX(1);
    pointer-events: auto;
  }
  /* drag handle */
  #wb-handle {
    width: 14px;
    height: 30px;
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: .3;
    font-size: 13px;
    flex-shrink: 0;
  }
  #wb-handle:active { cursor: grabbing; }
  /* generic toolbar button */
  .wb-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgba(255,255,255,.82);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .13s;
    flex-shrink: 0;
    position: relative;
  }
  .wb-btn:hover { background: rgba(255,255,255,.1); }
  .wb-btn.active {
    background: rgba(143,122,255,.45);
    color: #c4b5fd;
    box-shadow: 0 0 0 1px rgba(143,122,255,.5);
  }
  .wb-btn svg { pointer-events: none; }
  /* pen tooltip */
  .wb-btn[data-pen]::after {
    content: attr(title);
    position: absolute;
    bottom: -26px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,.8);
    color: #fff;
    font-size: 10px;
    white-space: nowrap;
    padding: 2px 7px;
    border-radius: 5px;
    pointer-events: none;
    opacity: 0;
    transition: opacity .15s;
  }
  .wb-btn[data-pen]:hover::after { opacity: 1; }
  /* separator */
  .wb-sep {
    width: 1px;
    height: 22px;
    background: rgba(255,255,255,.1);
    margin: 0 3px;
    flex-shrink: 0;
  }
  /* color dot button */
