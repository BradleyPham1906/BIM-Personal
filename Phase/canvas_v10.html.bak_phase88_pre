  function bimBindDock(){
    if(A3D_DOCK_BOUND)return;
    var host=document.getElementById('a3d-dock');
    if(!host)return;
    A3D_DOCK_BOUND=true;
    host.addEventListener('click',function(ev){
      var car=ev.target&&ev.target.closest?ev.target.closest('[data-dockmore]'):null;
      if(car){
        ev.stopPropagation();
        var key=car.getAttribute('data-dockmore');
        var d=host.querySelector('[data-dockpop="'+key+'"]');
        var wasOpen=d&&d.classList.contains('open');
        bimCloseDockPops();
        if(d&&!wasOpen){
          d.classList.add('open');
          /* Opens UPWARD from the caret, because the dock sits at the bottom of the viewport;
             then clamped to the window so a group near either edge is still fully readable. */
          var cr=car.getBoundingClientRect(),dr=d.getBoundingClientRect();
          var top=cr.top-dr.height-6;
          if(top<8)top=Math.min(cr.bottom+6,window.innerHeight-dr.height-8);
          var left=cr.left+cr.width/2-dr.width/2;
          if(left<8)left=8;
          if(left+dr.width>window.innerWidth-8)left=Math.max(8,window.innerWidth-dr.width-8);
          d.style.top=Math.round(Math.max(8,top))+'px';
          d.style.left=Math.round(left)+'px';
        }
        return;
      }
      var sbtn=ev.target&&ev.target.closest?ev.target.closest('#a3d-dsearch'):null;
      if(sbtn){
        ev.stopPropagation();
        var sp=host.querySelector('[data-dockpop="__search"]');
        var sOpen=sp&&sp.classList.contains('open');
