  window.openChartLibraryFor = function(kind){
    chartPanelState.query = '';
    chartPanelState.group = chartGroup(kind||'bar');
    openChartPanel(true);
  };

  const tChart = document.getElementById('t-chart');
  if(tChart) tChart.onclick = (e) => { e.stopPropagation(); openChartPanel(); };
  document.addEventListener('click', e => { if(panel?.classList.contains('show') && !e.target.closest('#chart-panel') && !e.target.closest('#t-chart')) openChartPanel(false); }, true);
  document.addEventListener('keydown', e => { if(e.key==='Escape' && panel?.classList.contains('show')) openChartPanel(false); });
  renderChartPanel();
})();
</script>

