    {id:'text',name:'Typography',desc:'Ready-made text styles',icon:'textH',items:[
      {key:'textHeading',name:'Heading',sub:'48px bold',icon:'textH',w:420,h:90,make:(x,y)=>mkText(x,y,48,800,'Heading',420,90)},
      {key:'textSub',name:'Subheading',sub:'28px semibold',icon:'textS',w:360,h:70,make:(x,y)=>mkText(x,y,28,700,'Subheading',360,70)},
      {key:'textBody',name:'Body text',sub:'16px regular',icon:'textB',w:320,h:120,make:(x,y)=>mkText(x,y,16,400,'Body text',320,120)}
    ]},
    {id:'data',name:'Tables',desc:'Editable data grids',icon:'table',items:[
      {key:'table',name:'Table',sub:'Editable grid',icon:'table',w:420,h:250,make:(x,y)=>addTable(x,y)}
