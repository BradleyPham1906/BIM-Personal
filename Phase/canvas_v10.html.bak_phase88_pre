      {t:'Layers',small:[['layers','Layer Properties']]}
    ]},
    {id:'view',name:'View',panels:[
      {t:'Navigate',big:[['zoomFit','Fit'],['zoomIn','Zoom In'],['zoomOut','Zoom Out'],['view100','1:1']]},
      {t:'Interface',small:[['layers','Layers'],['inspector','Properties'],['cmd','Command Line'],['grid','Grid'],['theme','Theme']]}
    ]},
    {id:'output',name:'Output',panels:[
      {t:'Plot',big:[['print','Plot']]},
      {t:'Export',big:[['saveJson','Save'],['openJson','Open']]}
