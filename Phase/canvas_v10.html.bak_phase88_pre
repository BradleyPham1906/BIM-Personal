    if(act?.startsWith('chart:')&&n){n.chartKind=act.split(':')[1];save();renderAll();select(n.id);return}
    if(['add-row-after','add-col-after','delete-row','delete-col','size-cols-equal','size-cols-content'].includes(act)&&n){tableAction?.(n,act);return}
