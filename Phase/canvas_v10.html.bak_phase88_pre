    if(type==='edge'&&act==='label'){let ed=edgeById?.(id),v=prompt('Connector label',ed?.label||'');if(ed&&v!==null){ed.label=v;save();renderAll()}return}
    const x=Number(ctxmenu.dataset.x),y=Number(ctxmenu.dataset.y);
    if(act==='card')addCard(x,y); if(act==='text-box'){state.nodes.push({id:nid(),type:'text',x,y,w:280,h:100,title:'Text',text:'Text',plainText:true,textStyle:{font:'Inter',size:24,align:'left',valign:'top',color:'#fff'}});save();renderAll()} if(act==='table')addTable?.(x,y); if(act==='chart')addChart?.(x,y,'bar'); if(act==='whiteboard')addWhiteboard?.(x,y); if(act==='group')addGroup?.(x,y); if(act==='image')addImage?.(x,y); if(act==='upload'){uploadTarget={x,y};document.getElementById('image-upload')?.click()} if(act==='fitView')zoomToFit?.(); if(act==='resetView'){view.z=1;applyView();renderEdges()} if(act==='export')exportMarkdown?.();
  }
  ctxmenu.addEventListener('click',function(e){
    const color=e.target.closest('[data-fm-color]'); if(color){const n=byId(ctxmenu.dataset.id); if(n){n.color=color.dataset.fmColor||null;save();renderAll();select(n.id)} hideCtx(); e.preventDefault();e.stopPropagation();e.stopImmediatePropagation(); return}
    const btn=e.target.closest('[data-fm-act]'); if(!btn)return; e.preventDefault();e.stopPropagation();e.stopImmediatePropagation(); runAction(btn.dataset.fmAct,e); hideCtx();
  },true);
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&ctxmenu.classList.contains('figma-menu'))hideCtx()},true);
})();

if(!load())seed();initHistory();applyView();renderAll();setTimeout(zoomToFit,60);
</script>
<script>

// Uploaded React/Figma clone reference adaptation: layer list, command palette, local reactions/chat.
(function installUploadedCanvasCodeIntegration(){
  if(window.__uploadedCanvasCodeIntegration)return; window.__uploadedCanvasCodeIntegration=true;
  const $=(q,r=document)=>r.querySelector(q);
  const $$=(q,r=document)=>Array.from(r.querySelectorAll(q));
  function safeById(id){try{return typeof byId==='function'?byId(id):(window.state?.nodes||[]).find(n=>n.id===id)}catch(e){return null}}
  function nodes(){try{return (state&&Array.isArray(state.nodes))?state.nodes:[]}catch(e){return []}}
