  function drawDimPreview(p1s, p2s, pCur, offset) {
    dimSvg.innerHTML = '';
    if (!p1s) return;
    const col = '#DE9255';
    const font = 'Inter,"Segoe UI",Arial,sans-serif';
    const p2 = p2s || pCur;
    if (!p2) return;

    // ext lines + dim line at offset
    const off = offset || 28;
    const dx = p2.x - p1s.x, dy = p2.y - p1s.y;
    const len = Math.hypot(dx, dy);
    if (len < 2) return;
    const nx = -dy / len, ny = dx / len; // normal

    // Offset direction snaps to away from nearest edge — simple: use +offset
    const ep1 = { x: p1s.x + nx * off, y: p1s.y + ny * off };
    const ep2 = { x: p2.x + nx * off, y: p2.y + ny * off };

    // extension lines
    [p1s, p2].forEach((p, i) => {
      const ep = i === 0 ? ep1 : ep2;
      const l = document.createElementNS(svgNS, 'line');
      l.setAttribute('x1', p.x); l.setAttribute('y1', p.y);
      l.setAttribute('x2', ep.x); l.setAttribute('y2', ep.y);
      l.setAttribute('stroke', col); l.setAttribute('stroke-width', '1.5');
      l.setAttribute('stroke-dasharray', '4,3'); l.setAttribute('opacity', '0.75');
      dimSvg.appendChild(l);
    });

    // dimension line
    const dl = document.createElementNS(svgNS, 'line');
    dl.setAttribute('x1', ep1.x); dl.setAttribute('y1', ep1.y);
    dl.setAttribute('x2', ep2.x); dl.setAttribute('y2', ep2.y);
    dl.setAttribute('stroke', col); dl.setAttribute('stroke-width', '2');
    dimSvg.appendChild(dl);

    // arrows
    const arrowLen = 8;
    const ang = Math.atan2(ep2.y - ep1.y, ep2.x - ep1.x);
    [[ep1, ang],[ep2, ang + Math.PI]].forEach(([pt, a]) => {
      const p = document.createElementNS(svgNS, 'polygon');
      const ax = pt.x + Math.cos(a) * arrowLen;
      const ay = pt.y + Math.sin(a) * arrowLen;
      const bx = pt.x + Math.cos(a + 2.5) * 5;
      const by = pt.y + Math.sin(a + 2.5) * 5;
      const cx2 = pt.x + Math.cos(a - 2.5) * 5;
      const cy2 = pt.y + Math.sin(a - 2.5) * 5;
      p.setAttribute('points', `${ax},${ay} ${bx},${by} ${cx2},${cy2}`);
      p.setAttribute('fill', col);
      dimSvg.appendChild(p);
    });

    // measurement label
    // world distance
    const wz = window.view?.z || 1;
    const wp1 = tw(p1s.x, p1s.y), wp2 = tw(p2.x, p2.y);
    const wDist = Math.hypot(wp2.x - wp1.x, wp2.y - wp1.y);
    const label = wDist.toFixed(1) + ' px';
    const mx = (ep1.x + ep2.x) / 2, my = (ep1.y + ep2.y) / 2;
    const bg = document.createElementNS(svgNS, 'rect');
    const tw2 = label.length * 6.5 + 8;
    bg.setAttribute('x', mx - tw2/2); bg.setAttribute('y', my - 12);
    bg.setAttribute('width', tw2); bg.setAttribute('height', 16);
    bg.setAttribute('rx', '3'); bg.setAttribute('fill', 'rgba(28,28,34,0.9)');
    dimSvg.appendChild(bg);
    const lbl = document.createElementNS(svgNS, 'text');
    lbl.setAttribute('x', mx); lbl.setAttribute('y', my);
    lbl.setAttribute('text-anchor', 'middle'); lbl.setAttribute('dominant-baseline', 'middle');
    lbl.setAttribute('fill', col); lbl.setAttribute('font-size', '11');
    lbl.setAttribute('font-family', font); lbl.setAttribute('font-weight', '700');
    lbl.textContent = label;
    dimSvg.appendChild(lbl);

    // p1 dot
    const dot = document.createElementNS(svgNS, 'circle');
    dot.setAttribute('cx', p1s.x); dot.setAttribute('cy', p1s.y);
    dot.setAttribute('r', '4'); dot.setAttribute('fill', col);
    dimSvg.appendChild(dot);
  }

  function commitDimension(p1w, p2w, offset) {
    if (!window.state || !window.addCard) return;
    const s1 = fw(p1w.wx, p1w.wy);
    const s2 = fw(p2w.wx, p2w.wy);
    const mx = Math.min(s1.x, s2.x), my = Math.min(s1.y, s2.y);
    const w = Math.abs(s1.x - s2.x) + 80;
    const h = Math.abs(s1.y - s2.y) + 60;
    const dist = Math.hypot(p2w.wx - p1w.wx, p2w.wy - p1w.wy);
    const wp1 = tw(s1.x, s1.y), wp2 = tw(s2.x, s2.y);
    const wDist = Math.hypot(wp2.x - wp1.x, wp2.y - wp1.y);
    // Add as a card with dimension data
    const n = window.addCard ?.(wp1.x, wp1.y, 'dimension');
    if (n) {
      n.dimP1 = { x: wp1.x, y: wp1.y };
      n.dimP2 = { x: wp2.x, y: wp2.y };
      n.dimDist = wDist.toFixed(1);
      n.title = '↔ ' + wDist.toFixed(1) + ' px';
      n.text = `Distance: **${wDist.toFixed(1)} px**\nΔX: ${Math.abs(wp2.x-wp1.x).toFixed(1)}  ΔY: ${Math.abs(wp2.y-wp1.y).toFixed(1)}`;
      n.w = Math.max(180, Math.abs(wp2.x - wp1.x) + 60);
      n.layerId = CAD.activeLyr;
      window.save?.();
      window.renderAll?.();
      window.toast?.('Dimension: ' + wDist.toFixed(1) + ' px');
    }
  }

  // ── MOUSEMOVE INTERCEPTOR ────────────────────────────────
  // Attach to viewport for snap + ortho + HUD + dim preview
  const viewport = $('viewport');
  let dimPhase = 'idle'; // idle | first | second
  let dimP1Screen = null;

  function onPointerMove(e) {
    const snap = findSnap(e.clientX, e.clientY);
    const { wx, wy } = snap ? { wx: snap.wx, wy: snap.wy } : tw(e.clientX, e.clientY);
    CAD.activeSnap = snap;

    if (CAD.snapOn || CAD.orthoOn || CAD.dimMode) {
      showHUD(wx, wy, snap);
    }
    if (CAD.snapOn) drawSnapIndicator(snap);

    // Dimension preview
    if (CAD.dimMode && dimPhase === 'first' && dimP1Screen) {
      const cur = snap ? fw(snap.wx, snap.wy) : { x: e.clientX, y: e.clientY };
      drawDimPreview(dimP1Screen, null, cur, 32);
    }
  }

  function onPointerDown(e) {
    if (!CAD.dimMode) return;
    if (e.button !== 0) return;

    const snap = findSnap(e.clientX, e.clientY);
    const screenPt = snap ? fw(snap.wx, snap.wy) : { x: e.clientX, y: e.clientY };
    const worldPt = snap || tw(e.clientX, e.clientY);

    if (dimPhase === 'idle') {
      dimPhase = 'first';
      dimP1Screen = { x: screenPt.x, y: screenPt.y, wx: worldPt.wx ?? worldPt.x, wy: worldPt.wy ?? worldPt.y };
      window.toast?.('Dimension: pick second point  (Esc to cancel)');
      e.stopPropagation();
    } else if (dimPhase === 'first') {
      const p1w = { wx: dimP1Screen.wx, wy: dimP1Screen.wy };
      const p2w = { wx: worldPt.wx ?? worldPt.x, wy: worldPt.wy ?? worldPt.y };
      commitDimension(p1w, p2w, 32);
      dimSvg.innerHTML = '';
      dimPhase = 'idle';
      dimP1Screen = null;
      e.stopPropagation();
    }
  }

  if (viewport) {
    viewport.addEventListener('pointermove', onPointerMove, { passive: true });
    viewport.addEventListener('pointerdown', onPointerDown, true);
  }

  // Esc cancels dim mode
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && CAD.dimMode) {
      dimPhase = 'idle'; dimP1Screen = null;
      dimSvg.innerHTML = '';
      if (!e.target.tagName.match(/INPUT|TEXTAREA/) && !e.target.isContentEditable) {
        stopDimMode();
      }
    }
    // F8 = ortho toggle (AutoCAD shortcut)
    if (e.key === 'F8') { e.preventDefault(); toggleOrtho(); }
    // F3 = snap toggle
    if (e.key === 'F3') { e.preventDefault(); toggleSnap(); }
  });

  // ── TOGGLE FUNCTIONS ────────────────────────────────────
  function toggleSnap() {
    CAD.snapOn = !CAD.snapOn;
    snapBar.classList.toggle('show', CAD.snapOn);
    if (!CAD.snapOn) { snapOverlay.innerHTML = ''; hud.style.opacity = '0'; }
    window.toast?.('Object Snap: ' + (CAD.snapOn ? 'ON' : 'OFF'));
    updateRibbonBtns();
  }

  function toggleOrtho() {
    CAD.orthoOn = !CAD.orthoOn;
    orthoPill.classList.toggle('show', CAD.orthoOn);
    window.toast?.('Ortho: ' + (CAD.orthoOn ? 'ON  (F8 to toggle)' : 'OFF'));
    updateRibbonBtns();
  }

  function startDimMode() {
    CAD.dimMode = true;
    dimPhase = 'idle';
    if (viewport) viewport.style.cursor = 'crosshair';
    window.toast?.('Dimension tool: pick first point  (Esc to cancel)');
    updateRibbonBtns();
  }
  function stopDimMode() {
    CAD.dimMode = false;
    dimPhase = 'idle'; dimP1Screen = null;
    dimSvg.innerHTML = '';
    if (viewport) viewport.style.cursor = '';
    window.toast?.('Dimension tool off');
    updateRibbonBtns();
  }

  function toggleLayers() {
    initLayers();
    renderLayerPanel();
    layerPanel.classList.toggle('show');
  }

  function updateRibbonBtns() {
    // update ribbon button active states if they exist
    document.querySelectorAll('[data-cadr-act]').forEach(btn => {
      const a = btn.dataset.cadrAct;
      if (a === 'bimSnap')  btn.classList.toggle('cadr-active', CAD.snapOn);
      if (a === 'bimOrtho') btn.classList.toggle('cadr-active', CAD.orthoOn);
      if (a === 'bimDims')  btn.classList.toggle('cadr-active', CAD.dimMode);
      if (a === 'layers')   btn.classList.toggle('cadr-active', layerPanel.classList.contains('show'));
    });
  }

  // ── HOOK INTO RUN OBJECT ─────────────────────────────────
  // Replace the "coming soon" stubs in the CAD ribbon RUN object
  function patchRun() {
    if (!window.RUN) { window.RUN = {}; }
    window.RUN.bimSnap  = toggleSnap;
    window.RUN.bimOrtho = toggleOrtho;
    window.RUN.bimDims  = () => { CAD.dimMode ? stopDimMode() : startDimMode(); };
    window.RUN.layers   = toggleLayers;
    window.RUN.measure  = () => { CAD.dimMode ? stopDimMode() : startDimMode(); };
    // Also wire cadRun (used by command bar)
    const origCadRun = window.cadRun;
    window.cadRun = function(act) {
      if (window.RUN[act]) { window.RUN[act](); return; }
      if (origCadRun) origCadRun(act);
    };
  }

  // ── CADR-ACTIVE STYLE ───────────────────────────────────
  const activeStyle = document.createElement('style');
  activeStyle.textContent = `
  .cadr-btn.cadr-active, .cadr-srow.cadr-active {
    background: rgba(143,122,255,0.28) !important;
    color: #fff !important;
    outline: 1px solid rgba(143,122,255,0.6);
  }
  `;
  document.head.appendChild(activeStyle);

  // ── INIT ─────────────────────────────────────────────────
  function init() {
    initLayers();
    patchRun();

    // persist layers into state when save() is called
    const origSave = window.save;
    window.save = function() {
      if (window.state) {
        window.state.layers = CAD.layers;
        window.state.activeLyr = CAD.activeLyr;
      }
      if (origSave) origSave();
    };

    // Also add layer info to addCard so new cards get a layerId
    const origAddCard = window.addCard;
    if (origAddCard) {
      window.addCard = function(x, y, type) {
        const n = origAddCard(x, y, type);
        if (n) n.layerId = CAD.activeLyr;
        return n;
      };
    }

    // keyboard shortcut hint in hint bar
    const hint = $('hint');
    if (hint) hint.textContent += '  ·  F3 Snap  ·  F8 Ortho  ·  LAYERS / DIMS in CAD ribbon';

    console.log('[CAD Engine v1] Ready — Snap, Ortho, Layers, Dimensions loaded');
  }

  // wait for DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    // slight delay so the ribbon RUN object is fully initialized
    setTimeout(init, 200);
  }

})();

