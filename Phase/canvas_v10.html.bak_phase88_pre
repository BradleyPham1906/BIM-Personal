    }else{
      var f=H*1.2;
      a=(sx-W/2)/f*c.dist;b=(H/2-sy)/f*c.dist;
    }
    c.tx=P[0]-(V.r[0]*a+V.u[0]*b);
    c.ty=P[1]-(V.r[1]*a+V.u[1]*b);
