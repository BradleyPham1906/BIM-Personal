  // ============ 3. START SCREEN PREVIEWS ============
  function drawWiresToCanvas(cv,wires){
    var ctx=cv.getContext('2d');
    ctx.clearRect(0,0,cv.width,cv.height);
    if(!wires||!wires.length) return;
    var x1=1e12,y1=1e12,x2=-1e12,y2=-1e12;
    wires.forEach(function(w){
      if(w.type==='circle'){ x1=Math.min(x1,w.cx-w.radius);x2=Math.max(x2,w.cx+w.radius);y1=Math.min(y1,w.cy-w.radius);y2=Math.max(y2,w.cy+w.radius); }
