  const flyMenu=document.createElement('div');flyMenu.id='cadr-menu';document.body.appendChild(flyMenu);
  let flyOpen=null;
  function closeFly(){flyMenu.classList.remove('show');flyOpen=null}
  function openFly(car){const id=car.dataset.cadrFly;if(flyOpen===id){closeFly();return}const items=FLY[id]||[];const pr=(car.parentElement||car).getBoundingClientRect();flyMenu.innerHTML=items.map(it=>`<button class="cadr-menu-item" data-cadr-mi="${it.a}" data-cadr-owner="${id}">${it.c?dot(it.c):ic(it.k)}<span>${it.l}</span></button>`).join('');flyMenu.style.left=Math.min(Math.max(6,pr.left),innerWidth-190)+'px';flyMenu.style.top=(pr.bottom+4)+'px';flyMenu.classList.add('show');flyOpen=id}
  flyMenu.addEventListener('click',e=>{const mi=e.target.closest('[data-cadr-mi]');if(!mi)return;const owner=mi.dataset.cadrOwner,act=mi.dataset.cadrMi;const it=(FLY[owner]||[]).find(x=>x.a===act);if(it)flyCur[owner]=it;closeFly();paint();try{(window.RUN&&window.RUN[act])?window.RUN[act]():RUN[act]?.()}catch(err){}});
  document.addEventListener('pointerdown',e=>{if(flyOpen&&!e.target.closest('#cadr-menu')&&!e.target.closest('[data-cadr-fly]'))closeFly()},true);
  paint();
})();
