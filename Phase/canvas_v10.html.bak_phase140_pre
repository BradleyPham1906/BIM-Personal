      var ip=bimInteriorPoint(todo[i].pts.map(function(p){return [p[0]+q[0],p[1]+q[2]];}));
      if(!ip){console.warn('[BIM] No point inside '+todo[i].name+' to put its tag');continue;}
      var t=bimNewRoomTag(todo[i],ip);
