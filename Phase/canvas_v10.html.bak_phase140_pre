    h+=bimLyTgl('lyfrz',l.id,!!l.frozen,l.frozen?'Thaw '+nm:'Freeze '+nm,BIM_LY_IC.frozen,BIM_LY_IC.thawed);
    h+=bimLyTgl('lylock',l.id,!!l.locked,l.locked?'Unlock '+nm:'Lock '+nm,BIM_LY_IC.locked,BIM_LY_IC.unlocked);
