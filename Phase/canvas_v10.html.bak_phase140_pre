      reader.onload=function(ev){try{bimImportSTL(ev.target.result,name);}catch(eI){console.warn('[BIM] STL import crashed:',eI);a3dToast('STL import failed: '+(eI&&eI.message?eI.message:eI));}};
      reader.readAsArrayBuffer(file);
