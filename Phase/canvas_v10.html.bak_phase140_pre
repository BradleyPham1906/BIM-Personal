    if(arc.sweep>=0){while(rel<-1e-9)rel+=Math.PI*2;while(rel>=Math.PI*2)rel-=Math.PI*2;}
    else{while(rel>1e-9)rel-=Math.PI*2;while(rel<=-Math.PI*2)rel+=Math.PI*2;}
