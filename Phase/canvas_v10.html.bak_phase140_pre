  function bimSegIntersect(a1,a2,b1,b2){
    var r=[a2[0]-a1[0],a2[1]-a1[1]],q=[b2[0]-b1[0],b2[1]-b1[1]];
    var den=r[0]*q[1]-r[1]*q[0];
