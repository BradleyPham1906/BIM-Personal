      bimShiftObjectY(c,dY);
      if(c.bim&&c.bim.levelId!==undefined)c.bim.levelId=lvl.id;
      if(c.levelId!==undefined)c.levelId=lvl.id;
      if(!c.layer||!bimLayerById(c.layer))c.layer=A3D.activeLayer;
      made.push(c);
