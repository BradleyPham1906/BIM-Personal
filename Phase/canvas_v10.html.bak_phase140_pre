    h+='<button type="button" class="a3d-lystat'+(isCur?' on':'')+'" data-lycur="'+id+'" title="'+
      (isCur?nm+' is the current layer':'Make '+nm+' current')+'" aria-label="'+(isCur?nm+' is the current layer':'Make '+nm+' current')+
