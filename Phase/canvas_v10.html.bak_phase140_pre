      reader.readAsText(file);
    }else if(ext==='geojson'||ext==='kml'||ext==='kmz'){   /* __acad3dV132: site data */
      bimGeoImportFile(file);
    }else if(ext==='cityjson'||(ext==='json'&&/\.city\.json$/i.test(name))){   /* __acad3dV139 */
      bimCityJsonFile(file);
