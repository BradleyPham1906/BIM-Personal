      reader.onload=function(ev){try{bimImportDXF(ev.target.result,name);}catch(eI){console.warn('[BIM] DXF import crashed:',eI);a3dToast('DXF import failed: '+(eI&&eI.message?eI.message:eI));}};
      reader.readAsText(file);
