    var ty=(o.bim&&o.bim.type)||o.t,dot=(o.t==='sketch')?bimLayerLook(o).color:(o.col||(TYPES[o.t]||{}).c||'#7f9db8');
    return '<div class="a3d-lyobj'+(sel?' sel':'')+'" data-lyobj="'+bimEsc(o.id)+'" draggable="true" style="padding-left:'+(22+depth*14)+
