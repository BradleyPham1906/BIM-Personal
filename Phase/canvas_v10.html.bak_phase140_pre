  function bimPresPanelHtml(){
    var n=A3D.sheets.length,cur=bimSheetOnScreen()?A3D.activeSheetId:null,i,s,d,lab,h;
    h='<div class="a3d-prp"><div class="a3d-prphd"><span class="a3d-prpttl">Presentation</span>'+
