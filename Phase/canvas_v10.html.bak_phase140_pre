      }else if(tag==='g'||tag==='o'){
        var nm=parts.slice(1).join(' ')||('group'+(groups.length));
        if(cur.faces.length===0&&cur===groups[groups.length-1]&&groups.length===1&&cur.name==='default'){
          cur.name=nm;
        }else{
          cur={name:nm,faces:[]};
